<!-- snippets/filter.liquid -->

{%- doc -%}
  Renders the filter drawer UI.
  @param {string} [collection_url] - Active collection URL.
  @param {string} [custom_collection_list] - Navigation handle for browse links.
  @param {object[]} [filters] - Shopify filter data.
  @param {boolean} [show_collection_list] - Show collection section.
  @param {boolean} [show_refine_list] - Show facet section.
  @param {boolean} [show_search_link] - Show search shortcut.
  @param {boolean} [show_sort_list] - Show sort section.
  @param {string} [sort_by] - Active sort value.
  @param {object[]} [sort_options] - Available sort options.
  @param {string} [swatches] - Swatch shape token.
{%- enddoc -%}

{%- liquid
  assign apply_t = 'general.filter.apply' | t
  assign browse_t = 'collections.browse' | t

  assign no_filters_t = 'general.filter.no_filters' | t
  assign reset_t = 'general.filter.reset' | t
  assign search_text_t = 'general.filter.search_by_name' | t
  assign sort_by_t = 'general.filter.sort_by' | t

  assign collections_list = linklists[custom_collection_list].links
  if custom_collection_list == blank
    assign collections_list = collections
  endif
-%}

<div class="filter--root" data-drawer-scroll-container>
  <div class="filter--wrapper">
    {%- if show_collection_list or show_sort_list or show_refine_list -%}
      <form class="filter--form">
        {%- if show_collection_list -%}
          <div class="filter--category">
            <div
              class="filter--toggle"
              tabindex="0"
              data-item="nav-text"
              aria-expanded="false"
              aria-controls="browse_filter"
              role="button"
            >
              {{- browse_t }}
              {%- render 'icons', icon: 'chevron-down' -%}
            </div>

            <ul
              class="filter--menu"
              id="browse_filter"
              data-item="sub-nav-text"
              data-transition-item="viewport"
              data-transition-trigger="custom"
              data-transition-type="fade-in"
            >
              {%- for collection_item in collections_list -%}
                <li class="filter--link" data-type="browse">
                  <input
                    id="{{ collection_item.title | handle | downcase }}-filter_browse"
                    class="filter--input"
                    type="radio"
                    name="browse"
                    value="{{ collection_item.url }}"
                    tabindex="-1"
                    {% if collection_item.url == collection_url %}
                      checked
                    {% endif %}
                  >
                  <label
                    class="filter--label"
                    for="{{ collection_item.title | handle | downcase }}-filter_browse"
                    data-item="tag"
                    tabindex="0"
                  >
                    <span>{{- collection_item.title -}}</span>
                    {%- render 'icons', icon: 'cross' -%}
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if show_sort_list -%}
          <div class="filter--category">
            <div
              class="filter--toggle"
              tabindex="0"
              data-item="nav-text"
              aria-expanded="false"
              aria-controls="sort_filter"
              role="button"
            >
              {{- sort_by_t }}
              {%- render 'icons', icon: 'chevron-down' -%}
            </div>

            <ul
              class="filter--menu"
              id="sort_filter"
              role="radiogroup"
              data-transition-item="viewport"
              data-transition-trigger="custom"
              data-transition-type="fade-in"
            >
              {%- for option in sort_options -%}
                <li class="filter--link" data-type="sort">
                  <input
                    id="{{ option.name | handle | downcase }}-filter_sort"
                    class="filter--input"
                    type="radio"
                    name="sort_by"
                    value="{{ option.value }}"
                    data-label="{{ option.name }}"
                    tabindex="-1"
                    {% if option.value == sort_by %}
                      checked
                    {% endif %}
                  >
                  <label
                    class="filter--label"
                    for="{{ option.name | handle | downcase }}-filter_sort"
                    data-item="tag"
                    tabindex="0"
                  >
                    <span>{{- option.name -}}</span>
                    {%- render 'icons', icon: 'cross' -%}
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if show_refine_list -%}
          {%- if filters.size > 0 -%}
            {%- for filter in filters -%}
              <div class="filter--category">
                <div
                  class="filter--toggle"
                  tabindex="0"
                  data-item="nav-text"
                  aria-expanded="false"
                  aria-controls="{{ filter.label | handle | downcase }}-refine_filter"
                  role="button"
                >
                  {{- filter.label }}
                  {%- render 'icons', icon: 'chevron-down' -%}
                </div>

                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div
                      class="filter--menu"
                      data-item="sub-nav-text"
                      id="{{ filter.label | handle | downcase }}-refine_filter"
                      data-transition-item="viewport"
                      data-transition-trigger="custom"
                      data-transition-type="fade-in"
                    >
                      <div class="filter--price--container">
                        {%- render 'price-range', filter: filter -%}
                      </div>
                    </div>

                  {%- when 'boolean' or 'list' -%}
                    {%- liquid
                      assign is_swatches = false
                      if filter.presentation == 'swatch' and swatches != 'none'
                        assign is_swatches = true
                      endif
                    -%}

                    <ul
                      class="filter--menu"
                      id="{{ filter.label | handle | downcase }}-refine_filter"
                      data-transition-item="viewport"
                      data-transition-trigger="custom"
                      data-transition-type="fade-in"
                    >
                      {%- for filter_value in filter.values -%}
                        {%- liquid
                          assign swatch_value = nil
                          if filter_value.swatch.image
                            assign image_url = filter_value.swatch.image | image_url: width: 60
                            assign swatch_value = 'url(' | append: image_url | append: ')'
                          elsif filter_value.swatch.color
                            assign swatch_value = 'rgb(' | append: filter_value.swatch.color.rgb | append: ')'
                          endif
                        -%}

                        <li class="filter--link" data-type="refine">
                          <input
                            id="{{ filter.label | handle | downcase }}-{{ filter_value.label | handle | downcase }}-filter_refine"
                            class="filter--input"
                            type="checkbox"
                            name="{{ filter_value.param_name }}"
                            value="{{ filter_value.value }}"
                            data-label="{% if filter.type == 'boolean' %}{{ filter.label }}: {% endif %}{{ filter_value.label }}"
                            tabindex="-1"
                            {% if filter_value.active %}
                              checked
                            {% endif %}
                          >
                          <label
                            class="filter--label"
                            for="{{ filter.label | handle | downcase }}-{{ filter_value.label | handle | downcase }}-filter_refine"
                            tabindex="0"
                            {% if is_swatches %}
                              data-shape="{{ swatches }}"
                              data-item="swatch"
                              style="--swatch-background:{{ swatch_value }};"
                            {% else %}
                              data-item="tag"
                            {% endif %}
                          >
                            {%- liquid
                              assign filter_label = filter_value.label | capitalize
                              echo '<span data-item="sub-nav-text">'
                              echo filter_label | append: '</span>'

                              unless is_swatches
                                render 'icons', icon: 'cross'
                              endunless
                            -%}
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>

                {%- endcase -%}
              </div>
            {%- endfor -%}

          {%- else -%}
            <div class="filter--no-filters" data-item="caption">
              {{- no_filters_t -}}
            </div>

          {%- endif -%}
        {%- endif -%}

      </form>
    {%- endif -%}

    {%- if show_search_link -%}
      <div class="filter--search">
        <button
          class="filter--search-link"
          data-drawer-open="top"
          data-drawer-view="search"
          aria-label="{{ search_text_t }}"
          aria-haspopup="true"
        >
          <div class="filter--search-icon">
            {%- render 'icons', icon: 'search' -%}
          </div>

          <div class="filter--search-text" data-item="sub-nav-text">
            {{- search_text_t -}}
          </div>
        </button>
      </div>
    {%- endif -%}
  </div>

  <div class="filter--button-container">
    <button
      class="filter--button"
      type="button"
      data-type="apply"
      data-item="button-1"
      data-text="{{- apply_t -}}"
      data-drawer-close
      tabindex="0"
    >
      <span>{{ apply_t }}</span>
    </button>
    <button
      class="filter--button"
      data-type="reset"
      data-item="button-3"
      data-text="{{ reset_t }}"
      tabindex="0"
    >
      <span>{{ reset_t }}</span>
    </button>
  </div>
</div>

{% stylesheet %}
  .filter--root {
    position: relative;
    overflow: auto;
    height: 100vh;
    height: 100dvh;
    scrollbar-width: none; /* Firefox */

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .filter--wrapper {
    width: 100%;
    position: absolute;
    top: 0;
    /* offsets fixed apply/clear buttons at bottom */
    padding-bottom: calc(var(--spacing--item) * 3 + var(--button--height));
  }

  .filter--form {
    padding: var(--spacing--block) var(--spacing--item);
    position: relative;
  }

  .filter--category:not(:last-child) {
    padding-bottom: var(--spacing--item);
  }

  .filter--toggle {
    width: fit-content;
    padding: var(--spacing--1) var(--spacing--item);
    border-radius: 20px;
    user-select: none;
    transition: 0.25s background-color ease-in;

    .icon--chevron-down {
      transform: scaleY(1);
      transition: transform 0.2s var(--transition--standard);
    }

    &[aria-expanded='false'] + .filter--menu {
      display: none;
    }

    &[aria-expanded='true'] {
      .icon--chevron-down {
        transform: scaleY(-1);
      }
    }

    &:hover {
      cursor: pointer;
    }

    > * {
      pointer-events: none;
    }
  }

  .filter--menu {
    padding: var(--spacing--1) 0 0 var(--spacing--0);

    &:has([data-item='swatch']) {
      display: flex;
      flex-wrap: wrap;
      padding: var(--spacing--1) 0 0 var(--spacing--item);
    }
  }

  .filter--price--container {
    padding: var(--spacing--1) 0 0 var(--spacing--2);
  }

  .filter--link {
    display: flex;

    .filter--menu:not(&:has([data-item='swatch'])) &:not(:last-child) {
      margin-bottom: var(--spacing--1);
    }

    &:has([data-item='swatch']) {
      width: calc(50% - var(--spacing--1));
      margin-right: var(--spacing--1);

      &:nth-of-type(n + 3) {
        margin-top: var(--spacing--2);
      }

      &:not(:nth-last-child(-n + 2)) {
        margin-bottom: var(--spacing--2);
      }
    }
  }

  .filter--label {
    &[data-item='swatch'] > *:first-child {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      padding-left: var(--spacing--2);
      /* swatch width is 24px */
      left: 24px;

      @media (max-width: 767px) {
        /* swatch width is 40px */
        left: 40px;
      }
    }

    > * {
      pointer-events: none;
    }
  }

  .filter--input:is([type='radio'], [type='checkbox']) {
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }

  .filter--no-filters {
    padding: var(--spacing--1) 0 0 var(--spacing--block);
  }

  .filter--search {
    padding: var(--spacing--item);
    border-top: var(--border--dark);

    &:only-child {
      border: 0;
    }
  }

  .filter--search-link {
    display: flex;
    align-items: center;
    width: fit-content;
    gap: var(--spacing--item);
    padding: var(--spacing--item);
    border-radius: 28px;
    transition: 0.25s background-color ease-in;
    color: var(--color--body);

    &:hover {
      cursor: pointer;
    }
  }

  .filter--search-icon svg {
    width: 20px;
  }

  .filter--button-container {
    width: 100%;
    display: flex;
    gap: var(--spacing--1);
    justify-content: space-between;
    padding: var(--spacing--item) var(--spacing--item) var(--spacing--block);
    position: fixed;
    bottom: 0;
    right: 0;
    padding: var(--spacing--item);
    background-color: var(--bg-color--body-translucent);
    backdrop-filter: blur(3px);

    .layout--viewport[data-drop-shadows='true'] & {
      box-shadow: var(--box-shadow--top);
    }
    
    .layout--viewport[data-drop-shadows='false'] & {
      border-top: var(--border--dark);
    }
  }

  .filter--button {
    width: calc(50% - var(--spacing--1));
    text-align: center;

    & span {
      width: 100%;
    }
  }
{% endstylesheet %}