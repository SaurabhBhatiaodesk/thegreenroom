{%- doc -%}
  Adds a contextual alt attribute to an uploaded video's fallback image.
  Preserves existing non-empty alt text and prevents duplicate attributes.
  @param {string} video - HTML generated by video_tag.
  @param {string} [alt] - Thumbnail description or adjacent video heading.
{%- enddoc -%}

{%- capture alt_attribute %} alt="{{ alt | default: '' | strip_html | escape }}"{% endcapture -%}
{%- liquid
  assign video = video | replace: ' alt=""', alt_attribute
  assign video = video | replace: " alt=''", alt_attribute
  unless video contains ' alt='
    assign image_opening = '<img' | append: alt_attribute
    assign video = video | replace: '<img', image_opening
  endunless
  unless video contains ' loading='
    assign video = video | replace: '<img', '<img loading="lazy"'
  endunless
  echo video
-%}
