<!-- snippets/video-block.liquid -->

{%- doc -%}
  Renders a media-rich video block with optional overlay text and buttons.
  @param {string} [aspect_ratio] - Desktop aspect ratio.
  @param {boolean} [autoplay] - Autoplay video when visible.
  @param {string} [button_link_1] - Primary button URL.
  @param {string} [button_link_2] - Secondary button URL.
  @param {string} [button_style_1] - Primary button style.
  @param {string} [button_style_2] - Secondary button style.
  @param {string} [button_text_1] - Primary button text.
  @param {string} [button_text_2] - Secondary button text.
  @param {string} [description] - Description text.
  @param {string} [display_type] - Desktop media display type.
  @param {boolean} [full_width] - Enable full-width layout. Defaults to `false`.
  @param {string} [heading] - Heading text.
  @param {string} [heading_type] - Heading style token.
  @param {string} [highlight_color] - Highlight color token.
  @param {string} [highlight_text] - Highlight text color token.
  @param {string} [highlight_type] - Highlight style token.
  @param {string} [id] - Unique block identifier.
  @param {string} [mobile_aspect_ratio] - Mobile aspect ratio. Defaults to `aspect_ratio`.
  @param {string} [mobile_display_type] - Mobile media display type. Defaults to `display_type`.
  @param {boolean} [mobile_full_width] - Enable mobile full-width layout. Defaults to `false`.
  @param {boolean} [mobile_hide_description] - Hide description on mobile.
  @param {string} [mobile_text_x_alignment] - Mobile horizontal text alignment.
  @param {string} [mobile_text_y_alignment] - Mobile vertical text alignment.
  @param {image} [mobile_thumbnail] - Mobile cover image.
  @param {string} [overlay_style] - Overlay style token.
  @param {string} [overline] - Overline text.
  @param {string} [play_button_style] - Play button style token.
  @param {string} [text_bg_color] - Text background color.
  @param {string} [text_color] - Text color token.
  @param {string} [text_style] - Text style token.
  @param {number} [text_width] - Text width in px.
  @param {string} [text_x_alignment] - Desktop horizontal text alignment.
  @param {string} [text_y_alignment] - Desktop vertical text alignment.
  @param {image} [thumbnail] - Desktop cover image.
  @param {object} [video_url] - External video object with `type` and `id`.
  @param {media} [video_upload] - Uploaded video file.
{%- enddoc -%}

{%- liquid
  assign text_exists = true
  if overline == blank and heading == blank and description == blank and button_text_1 == blank and button_text_2 == blank
    assign text_exists = false
  endif

  assign video_id = '_9VUPq3SxOc'
  assign video_type = 'youtube'
  if video_upload != blank
    assign video_type = 'plyr'
    assign video_id = false
  elsif video_url
    assign video_type = video_url.type
    assign video_id = video_url.id
  endif

  assign natural_aspect_ratio = 'calc(16 / 9)'
  if video_upload
    assign natural_aspect_ratio = video_upload.aspect_ratio
  endif

  assign aspect_ratio = aspect_ratio | default: natural_aspect_ratio
  assign mobile_aspect_ratio = mobile_aspect_ratio | default: aspect_ratio
  assign mobile_display_type = mobile_display_type | default: display_type
  assign full_width = full_width | default: false
  assign mobile_full_width = mobile_full_width | default: false

  capture css_vars
    echo '--video-aspect-ratio:' | append: aspect_ratio | append: ';'
    echo '--video-mobile-aspect-ratio:' | append: mobile_aspect_ratio | append: ';'
    echo '--natural-aspect-ratio:' | append: natural_aspect_ratio | append: ';'
  endcapture
-%}

<video-component
  class="video--root"
  data-api="{{ video_type }}"
  data-autoplay="{{ autoplay }}"
  data-overlay-style="{{ overlay_style }}"
  data-display-type="{{ display_type }}"
  data-full-width="{{ full_width }}"
  data-id="{{ id }}"
  data-text-color="{{ text_color }}"
  data-mobile-display-type="{{ mobile_display_type }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-x-alignment="{{ mobile_text_x_alignment }}"
  data-mobile-y-alignment="{{ mobile_text_y_alignment }}"
  data-x-alignment="{{ text_x_alignment }}"
  data-y-alignment="{{ text_y_alignment }}"
  data-video-id="{{ video_id }}"
  style="{{ css_vars }}"
>
  <div class="video--container">
    {%- if text_exists or autoplay == false -%}
      <div class="video--overlay">
        {%- unless autoplay -%}
          <div class="video--thumbnail">
            {%- if thumbnail == blank and video_upload == blank and video_url == blank -%}
              {%-
                render 'placeholder',
                background: true,
                display_type: display_type,
                mobile_display_type: mobile_display_type,
                mobile_overlay_style: overlay_style,
                overlay_text_color: text_color,
                overlay_style: overlay_style,
                placeholder_index: 1,
                type: 'lifestyle'
              -%}

            {%- else -%}
              {%-
                render 'image',
                image: thumbnail,
                background: true,
                overlay_style: overlay_style,
                display_type: display_type,
                mobile_display_type: mobile_display_type,
                mobile_overlay_style: overlay_style,
                mobile_image: mobile_thumbnail,
                sizes: '100vw'
              -%}

            {%- endif -%}
          </div>
        {%- endunless -%}

        {%- if text_exists -%}
          <div
            class="video--header"
            {% unless settings.transitions--text %}
              data-transition-container="{{ id }}"
              data-transition-cascade="vertical"
              data-transition-cascade-interval="500"
            {% endunless %}
            data-container="block"
            data-text-style="{{ text_style }}"
            data-text-width
            {% unless text_bg_color == blank %}
              data-background-color="{{ text_bg_color }}"
              data-translucent="{{ settings.content--box-translucent }}"
            {% endunless %}
            style="--text-width:{{ text_width }}px;"
          >
            {%- unless overline == blank -%}
              <p class="video--overline" data-item="overline">
                {{- overline | escape -}}
              </p>
            {%- endunless -%}

            {%- unless heading == blank -%}
              <div
                class="video--heading"
                {% unless settings.transitions--text %}
                  data-transition-item="{{ id }}"
                  data-transition-type="slide-in"
                {% endunless %}
              >
                <h2 data-item="{{ heading_type }}">
                  {%-
                    render 'utils',
                    name: 'highlighted-text',
                    text: heading,
                    highlight_color: highlight_color,
                    highlight_text: highlight_text,
                    highlight_type: highlight_type
                  -%}
                </h2>
              </div>
            {%- endunless -%}

            {%- unless description == blank -%}
              <div
                class="video--description"
                data-item="featured-paragraph"
                {% if mobile_hide_description %}
                  data-mq="medium-large"
                {% endif %}
                {% unless settings.transitions--text %}
                  data-transition-item="{{ id }}"
                  data-transition-type="slide-in"
                {% endunless %}
              >
                {{- description -}}
              </div>
            {%- endunless -%}

            {%- unless autoplay -%}
              <div
                class="video--play-container"
                {% unless settings.transitions--text %}
                  data-transition-item="{{ id }}"
                  data-transition-type="fade-in"
                {% endunless %}
              >
                <button
                  class="video--play"
                  onclick="window.trigger('theme:{{ id }}:play')"
                >
                  {%- liquid
                    if play_button_style == 'solid'
                      render 'icons', icon: 'play-solid'
                    else
                      render 'icons', icon: 'play-outline'
                    endif
                  -%}
                </button>
              </div>
            {%- endunless -%}

            {%- unless button_text_1 == blank and button_text_2 == blank -%}
              <div
                class="video--button-container"
                {% unless settings.transitions--text %}
                  data-transition-item="{{ id }}"
                  data-transition-type="fade-in"
                {% endunless %}
              >
                {%- unless button_text_1 == blank -%}
                  {%- liquid
                    assign button_tag_1 = 'a'
                    if button_link_1 == blank
                      assign button_tag_1 = 'div'
                    endif
                  -%}

                  <{{ button_tag_1 }}
                    class="video--button"
                    data-item="{{ button_style_1 }}"
                    data-text="{{ button_text_1 }}"
                    href="{{ button_link_1 }}"
                  >
                    <span>{{ button_text_1 }}</span>
                  </{{ button_tag_1 }}>
                {%- endunless -%}

                {%- unless button_text_2 == blank -%}
                  {%- liquid
                    assign button_tag_2 = 'a'
                    if button_link_2 == blank
                      assign button_tag_2 = 'div'
                    endif
                  -%}

                  <{{ button_tag_2 }}
                    class="video--button"
                    data-item="{{ button_style_2 }}"
                    data-text="{{ button_text_2 }}"
                    href="{{ button_link_2 }}"
                  >
                    <span>{{ button_text_2 }}</span>
                  </{{ button_tag_2 }}>
                {%- endunless -%}
              </div>
            {%- endunless -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="video--wrapper"
      {% if autoplay %}
        tabindex="-1"
      {% else %}
        data-transition-item="viewport"
        data-transition-type="fade-in"
        data-transition-trigger="custom"
      {% endif %}
    >
      {%- if video_upload -%}
        {%- liquid
          assign video = video_upload | video_tag: autoplay: autoplay, muted: autoplay, loop: autoplay
          assign video = video | replace: '<img', '<img loading="lazy"'
          echo video
        -%}
      {%- else -%}
        <div id="{{ id }}-player"></div>
      {%- endif -%}
    </div>
  </div>
</video-component>
