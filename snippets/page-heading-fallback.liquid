{%- doc -%}
  Provides an accessible page heading when a template hides its primary title.
  @param {string} content - Rendered main template content.
{%- enddoc -%}

{%- liquid
  assign normalized_content = content | downcase
  assign primary_title = ''
  unless normalized_content contains '<h1'
    case request.page_type
      when 'index'
        assign primary_title = shop.name
      when 'page'
        assign primary_title = page.title
      when 'blog'
        assign primary_title = blog.title
      when 'article'
        assign primary_title = article.title
      when 'collection'
        assign primary_title = collection.title
      when 'product'
        assign primary_title = product.title
      when 'list-collections'
        assign primary_title = 'general.breadcrumbs.collections' | t
    endcase
  endunless
-%}

{%- if primary_title != blank -%}
  <h1 class="page-heading-fallback">{{ primary_title | escape }}</h1>
{%- endif -%}

{% stylesheet %}
  .page-heading-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}
