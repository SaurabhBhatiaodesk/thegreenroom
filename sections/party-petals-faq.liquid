{{ 'party-petals.css' | asset_url | stylesheet_tag }}

<section 
  class="pp-wrap"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="pp-container">
    <div class="pp-inner">
      <div 
        class="pp-faq-block" 
        id="pp-faq-{{ section.id }}" 
        style="
          --pp-accent: {{ section.settings.accent_color }};
          --pp-heading-color: {{ section.settings.heading_color }};
          --pp-subheading-color: {{ section.settings.subheading_color }};
          --pp-question-color: {{ section.settings.question_color }};
          --pp-answer-color: {{ section.settings.answer_color }};
          --pp-divider-color: {{ section.settings.divider_color }};
          --pp-question-font-size: {{ section.settings.question_font_size }}px;
          --pp-question-font-size-mobile: {{ section.settings.question_font_size_mobile }}px;
          --pp-answer-font-size: {{ section.settings.answer_font_size }}px;
          --pp-answer-font-size-mobile: {{ section.settings.answer_font_size_mobile }}px;
          --pp-padding-h: {{ section.settings.padding_horizontal }}px;
          --pp-padding-h-mobile: {{ section.settings.padding_horizontal_mobile }}px;
          --pp-padding-bottom: {{ section.settings.padding_bottom }}px;
          --pp-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
          --pp-answer-padding-right: {{ section.settings.answer_padding_right }}px;
          --pp-answer-padding-right-mobile: {{ section.settings.answer_padding_right_mobile }}px;
        "
      >

        <div class="pp-faq-head">
          <h2 class="pp-section-title">
            {{ section.settings.heading | default: 'FAQ' }}
          </h2>

          <p class="pp-faq-sub">
            {{ section.settings.subheading | default: 'The things brides ask us most' }}
          </p>
        </div>

        <div class="pp-faq-list">

          {% for block in section.blocks %}
            {% if block.type == 'faq' %}

              <div class="pp-faq-item" {{ block.shopify_attributes }}>

                <button 
                  type="button" 
                  class="pp-faq-question" 
                  data-pp-faq-toggle 
                  aria-expanded="false"
                >
                  <h3 class="pp-faq-q-text">
                    {{ block.settings.question }}
                  </h3>

                  <span class="pp-faq-sign" data-pp-faq-sign>
                    +
                  </span>
                </button>


                <div 
                  class="pp-faq-answer" 
                  data-pp-faq-answer 
                  hidden
                >
                  <p>
                    {{ block.settings.answer }}
                  </p>
                </div>

              </div>

            {% endif %}
          {% endfor %}

          <div class="pp-faq-end"></div>

        </div>

      </div>
    </div>
  </div>
</section>

<style>
    
/* =========================================================
   SECTION: party-petals-faq.liquid
   ========================================================= */
.pp-faq-block { padding: 0 var(--pp-padding-h, 110px) var(--pp-padding-bottom, 110px); }
.pp-faq-head { display: flex; flex-direction: column; gap: 20px; margin-bottom: 44px; }
.pp-faq-sub { margin: 0; font-size: 15px; font-style: italic; color: var(--pp-subheading-color, #264A3D); opacity: 0.75; }
.pp-faq-list { display: grid; grid-template-columns: 1fr; gap: 0; }
.pp-faq-item { border-top: 1px solid var(--pp-divider-color, rgba(38, 74, 61, 0.18)); }
.pp-faq-question {
  width: 100%;
  background: none;
  border: none;
  font: inherit;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  padding: 26px 0;
  cursor: pointer;
  text-align: left;
  transition: opacity 150ms ease;
}
.pp-faq-question:hover { opacity: 0.72; }
.pp-faq-q-text {
  margin: 0;
  font-family: Poppins, sans-serif;
  font-weight: 600;
  font-size: var(--pp-question-font-size, 16px);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--pp-question-color, #264A3D);
}
.pp-faq-sign {
  flex: 0 0 auto;
  font-family: Poppins, sans-serif;
  font-size: 20px;
  line-height: 1;
  color: var(--pp-accent, #D37F91);
}
.pp-faq-answer p {
  margin: 0;
  padding: 0 var(--pp-answer-padding-right, 90px) 30px 0;
  font-size: var(--pp-answer-font-size, 15px);
  line-height: 1.85;
  color: var(--pp-answer-color, #264A3D);
}
.pp-faq-end { border-top: 1px solid var(--pp-divider-color, rgba(38, 74, 61, 0.18)); }

.pp-section-title { color: var(--pp-heading-color, #264A3D); }

@media (max-width: 749px) {
    .pp-faq-q-text {
        font-size: var(--pp-question-font-size-mobile, 14px);
    }
    .pp-faq-answer p {
        font-size: var(--pp-answer-font-size-mobile, 14px);
        padding-right: var(--pp-answer-padding-right-mobile, 20px);
    }
    .pp-faq-block{
        padding-left: var(--pp-padding-h-mobile, 20px);
        padding-right: var(--pp-padding-h-mobile, 20px);
        padding-bottom: var(--pp-padding-bottom-mobile, 70px);
    }
}
</style>

<script>
(function () {

  var root = document.getElementById('pp-faq-{{ section.id }}');

  if (!root) return;


  var singleOpen = {{ section.settings.single_open_faq | default: true }};

  var faqItems = Array.prototype.slice.call(
    root.querySelectorAll('.pp-faq-item')
  );


  faqItems.forEach(function (item) {

    var btn = item.querySelector('[data-pp-faq-toggle]');
    var answer = item.querySelector('[data-pp-faq-answer]');
    var sign = item.querySelector('[data-pp-faq-sign]');


    btn.addEventListener('click', function () {

      var isOpen = btn.getAttribute('aria-expanded') === 'true';


      if (singleOpen) {

        faqItems.forEach(function (other) {

          if (other === item) return;


          other
            .querySelector('[data-pp-faq-toggle]')
            .setAttribute('aria-expanded', 'false');


          other
            .querySelector('[data-pp-faq-answer]')
            .hidden = true;


          other
            .querySelector('[data-pp-faq-sign]')
            .textContent = '+';

        });

      }


      btn.setAttribute(
        'aria-expanded',
        String(!isOpen)
      );


      answer.hidden = isOpen;

      sign.textContent = isOpen ? '+' : '−';

    });

  });


})();
</script>


{% schema %}
{
  "name": "Party Petals — FAQ",

  "settings": [

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
