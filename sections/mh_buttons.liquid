      },
      {
        "type": "text",
        "id": "button_text_1",
        "label": "Button Text"
      },
      {
        "type": "url",
        "id": "button_url_1",
        "label": "Button Link"
      },
      {
        "type": "header",
        "content": "__ Button 02 __"
      },
      {
        "type": "image_picker",
        "id": "button_image_2",
        "label": "Button Image"
      },
      {
        "type": "color",
        "id": "button_text_color_2",
        "label": "Button Text Color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "button_text_2",
        "label": "Button Text"
      },
      {
        "type": "url",
        "id": "button_url_2",
