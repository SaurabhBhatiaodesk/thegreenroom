<style>
  #shopify-section-{{ section.id }} .tic-hero-banner-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner {
    position: relative;
    overflow: visible;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner.tic-hero-top {
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner.no-logo {
    align-items: center !important;
    justify-content: center !important;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__content {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__logo {
    display: block;
    width: 100%;
    max-width: 140px;
    height: auto;
    margin: 0 auto 18px;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__text {
    margin: 0 auto 32px;
    color: {{ section.settings.text_color }};
    text-align: center;
    font-family: inherit;
    font-size: 38px;
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__text * {
    color: {{ section.settings.text_color }} !important;
    text-align: center;
    font-family: inherit !important;
    font-size: 38px !important;
    line-height: 1.8 !important;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 240px;
    min-height: 78px;
    padding: 18px 30px;
    color: {{ section.settings.button_text_color }};
    background-image: url('{{ section.settings.button_image | image_url: width: 800 }}');
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    margin: 0 auto;
    text-align: center;
    font-family: inherit;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__button:hover {
    transform: translateY(-4px) scale(1.04);
    filter: brightness(1.05);
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__button h4 {
    margin: 0;
    color: inherit;
    font-family: inherit;
    text-align: center;
    font-size: 24px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__signup {
    width: 100%;
    margin-top: 24px;
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__bottom-image-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__bottom-image {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .tic-hero-banner__bottom-image--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .tic-hero-banner {
    min-height: 100svh;
    background-attachment: fixed;
  }

    #shopify-section-{{ section.id }} .tic-hero-banner__logo {
      max-width: 100px;
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .tic-hero-banner__text {
      font-size: 28px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .tic-hero-banner__text * {
      font-size: 28px !important;
      line-height: 1.7 !important;
    }

    #shopify-section-{{ section.id }} .tic-hero-banner__button {
      width: 220px;
      min-height: 70px;
      padding: 16px 24px;
    }

    #shopify-section-{{ section.id }} .tic-hero-banner__button h4 {
      font-size: 21px;
    }

    #shopify-section-{{ section.id }} .tic-hero-banner__bottom-image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .tic-hero-banner__bottom-image--mobile {
      display: block;
    }
  }
</style>

<div class="tic-hero-banner-wrap">
  <section class="tic-hero-banner {% if section.settings.content_position == 'top' and section.settings.logo != blank %}tic-hero-top{% endif %} {% if section.settings.logo == blank %}no-logo{% endif %}">
    <div class="tic-hero-banner__overlay"></div>

    <div class="page-width tic-hero-banner__inner">
      <div class="tic-hero-banner__content">
        {% if section.settings.logo != blank %}
          <img
            class="tic-hero-banner__logo"
            src="{{ section.settings.logo | image_url: width: 800 }}"
            alt="{{ section.settings.logo.alt | escape }}"
            loading="eager"
          >
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="tic-hero-banner__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            class="tic-hero-banner__button"
            href="{{ section.settings.button_url }}"
          >
            <h4>{{ section.settings.button_text }}</h4>
          </a>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="tic-hero-banner__signup">
            {% for block in section.blocks %}
              {% render 'Sign_Up', block: block %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="tic-hero-banner__bottom-image-wrap">
      {% if section.settings.desktop_image != blank %}
        <img
          class="tic-hero-banner__bottom-image tic-hero-banner__bottom-image--desktop"
          src="{{ section.settings.desktop_image | image_url: width: 2400 }}"
          alt="{{ section.settings.desktop_image.alt | escape }}"
          loading="lazy"
        >
      {% endif %}

      {% if section.settings.mobile_image != blank %}
        <img
          class="tic-hero-banner__bottom-image tic-hero-banner__bottom-image--mobile"
          src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
          alt="{{ section.settings.mobile_image.alt | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TIC Parallax Banner",
  "presets": [
    {
      "name": "TIC Parallax Banner"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "__ Button __"
    },
    {
      "type": "image_picker",
      "id": "button_image",
      "label": "Button Image"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "__ Bottom Image __"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile"
    }
  ],
  "blocks": [
    {
      "type": "SignUp",
      "name": "SignUp",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "background",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#e27396"
        },
        {
          "type": "richtext",
          "id": "top_text",
          "label": "Top Text"
        },
        {
          "type": "richtext",
          "id": "bottom_text",
          "label": "Bottom Text"
        },
        {
          "type": "image_picker",
          "id": "button_background",
          "label": "Button Background"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        }
      ]
    }
  ]
}
{% endschema %}