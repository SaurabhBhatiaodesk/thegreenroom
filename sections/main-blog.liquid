{%- liquid
  assign all_t = 'blog.all' | t
  assign no_articles_t = 'blog.no_articles' | t
  assign filter_t = 'blog.filter' | t
  assign rss_t = 'blog.rss' | t
  assign written_by_t = 'blog.article.written_by' | t

  assign columns = section.settings.columns
  assign column_spacing = section.settings.column-spacing
  assign container_width = section.settings.container-width
  assign layout_style = section.settings.layout-style
  assign wedding_background_color = section.settings.wedding-background-color | default: '#264A3D'
  assign wedding_font_color = section.settings.wedding-font-color | default: '#FFFDF0'
  assign wedding_cta_color = section.settings.wedding-cta-color | default: '#FFFDF0'
  assign heading_type = section.settings.heading-type
  assign article_heading_type = section.settings.article-heading-type
  assign mobile_columns = section.settings.mobile-columns
  assign enable_tag_filter = section.settings.show-tag-filter
  assign hidden_tags = settings.hide-tags | split: ','
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign show_author = section.settings.show-author
  assign show_cta = section.settings.show-cta
  assign show_date = section.settings.show-date
  assign show_excerpt = section.settings.show-excerpt
  assign show_rss = section.settings.show-rss
  assign show_title = section.settings.show-title
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  capture available_tags
    echo all_t | append: ','

    for tag in blog.all_tags
      assign temp_tag = tag | downcase | escape
      assign skip = false

      for hidden_tag in hidden_tags
        assign formatted_hidden_tag = hidden_tag | downcase | escape | strip
        if temp_tag == formatted_hidden_tag
          assign skip = true
          break
        endif
      endfor

      if skip
        continue
      endif

      echo tag | append: ','
    endfor
  endcapture

  assign available_tags = available_tags | split: ","

  capture available_tag_values
    echo blog.url | append: ","

    for tag in blog.all_tags
      assign temp_tag = tag | downcase | escape
      assign skip = false

      for hidden_tag in hidden_tags
        assign formatted_hidden_tag = hidden_tag | downcase | escape | strip
        if temp_tag == formatted_hidden_tag
          assign skip = true
          break
        endif
      endfor

      if skip
        continue
      endif

      capture tag_url
        assign handleized_tag = tag | handleize
        echo blog.url | append: '/tagged/' | append: handleized_tag
      endcapture

      if current_tags == blank
        assign current_tag_value = blog.url
      elsif current_tags contains tag
        assign current_tag_value = tag_url
      endif

      echo tag_url | append: ","
    endfor
  endcapture

  assign available_tag_values = available_tag_values | split: ","

  assign show_tag_filter = false
  if enable_tag_filter and available_tags.size > 1
    assign show_tag_filter = true
  endif

  capture sizes
    render 'sizes-grid', container_width: container_width, columns: columns, mobile_columns: mobile_columns
  endcapture
-%}

<div
  class="blog--root blog--root--{{ layout_style }}"
  data-section-id="{{ section.id }}"
  data-background-color="none"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-show-tag-filter="{{ show_tag_filter }}"
  data-show-title="{{ show_title }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  style="--wedding-blog-background: {{ wedding_background_color }}; --wedding-blog-font: {{ wedding_font_color }}; --wedding-blog-cta: {{ wedding_cta_color }};"
>
  <div class="blog--wrapper" data-container="section">
    {%- paginate blog.articles by 36 -%}
      {%- if show_title or show_tag_filter -%}
        <div class="blog--header" data-container="block">
          {%- if show_title -%}
            <div
              class="blog--title-container"
              data-x-alignment="center"
              {% unless settings.transitions--text %}
                data-transition-item="viewport"
                data-transition-type="slide-in"
              {% endunless %}
            >
              <h1 class="blog--title" data-item="{{ heading_type }}">
                <a href="{{ blog.url }}">
                  {{- blog.title -}}
                </a>
              </h1>
            </div>
          {%- endif -%}

          {%- if show_tag_filter -%}
            <div class="blog--filter">
              <nav class="blog--filter--body" id="blog_filters">
                <ul
                  class="blog--filter--menu"
                  data-item="nav-text"
                  data-mq="medium-large"
                >
                  <li class="blog--filter--menu-item">
                    <a
                      href="{{ blog.url }}#blog_filters"
                      {% if current_tags == blank %}
                        data-item="block-link"
                      {% endif %}
                    >
                      <span>{{- all_t -}}</span>
                    </a>
                  </li>

                  {%- for tag in blog.all_tags -%}
                    {%- liquid
                      assign temp_tag = tag | downcase | escape
                      assign skip = false

                      for hidden_tag in hidden_tags
                        assign formatted_hidden_tag = hidden_tag | downcase | escape | strip
                        if temp_tag == formatted_hidden_tag
                          assign skip = true
                          break
                        endif
                      endfor

                      if skip
                        continue
                      endif
                    -%}

                    <li class="blog--filter--menu-item">
                      <a
                        href="{{ blog.url }}/tagged/{{ tag | handleize }}#blog_filters"
                        {% if current_tags contains tag %}
                          data-item="block-link"
                        {% endif %}
                      >
                        <span>{{ tag }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>

                <div class="blog--filter--disclosure" data-mq="small">
                  {%-
                    render 'disclosure',
                    label_name: filter_t,
                    option_names: available_tags,
                    option_values: available_tag_values,
                    current_value: current_tag_value,
                    id: 'blog-disclosure',
                    type: 'url-redirect'
                  -%}
                </div>
              </nav>
            </div>
          {% endif %}
        </div>
      {%- endif -%}

      {%- if blog.articles.size > 0 -%}
        {%- liquid
          capture blog_articles
            for article in blog.articles
              render 'article-card', featured_article: article, heading_type: article_heading_type, show_author: show_author, show_cta: show_cta, show_date: show_date, show_excerpt: show_excerpt, transition_id: section.id, sizes: sizes
            endfor
          endcapture

          assign remainder = blog.articles.size | modulo: columns
          assign blank_count = 0
          if remainder > 0
            assign blank_count = columns | minus: remainder
          endif
        -%}

        {% if column_spacing == 'evenly' %}
          <div
            class="blog--article-list"
            data-aspect-ratio="{{ settings.image--article-size }}"
            data-container="panel"
            data-columns="{{ columns }}"
            data-mobile-columns="{{ mobile_columns }}"            {% unless settings.transitions--other %}
              data-transition-container="{{ section.id }}"
              data-transition-type="fade-in"
            {% endunless %}
          >
            {{- blog_articles -}}

            {%- if blank_count > 0 -%}
              {%- for i in (1..blank_count) -%}
                {%- if settings.transitions--other == false -%}
                  <div
                    data-item="blank"
                    data-transition-item="{{ section.id }}"
                    aria-hidden="true"
                  ></div>
                {%- else -%}
                  <div data-item="blank" aria-hidden="true"></div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {% else %}
          <div
            class="blog--article-list"
            data-aspect-ratio="{{ settings.image--article-size }}"
            data-container="staggered-grid"
            data-columns="{{ columns }}"
            data-mobile-columns="{{ mobile_columns }}"
            {% unless settings.transitions--other %}
              data-transition-container="{{ section.id }}"
              data-transition-type="fade-in"
            {% endunless %}
            style="--columns: {{ columns }}; --mobile-columns: {{ mobile_columns }};"
          >
            {{- blog_articles -}}
          </div>
        {% endif %}

        {%- if paginate.pages > 1 or show_rss -%}
          <div
            class="blog--footer"
            data-container="block"
            data-x-alignment="center"
          >
            {%- if paginate.pages > 1 -%}
              <div class="blog--footer-pagination">
                {%- render 'pagination', paginate: paginate -%}
              </div>
            {%- endif -%}

            {%- if show_rss -%}
              <a
                class="blog--footer-rss"
                href="{{ shop.url }}{{ blog.url }}.atom"
                target="_blank"
                data-item="block-link"
              >
                <span>{{- rss_t -}}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- else -%}
        <div
          class="blog--no-articles"
          data-container="block"
          data-x-alignment="center"
        >
          <p data-item="paragraph">
            {{- no_articles_t -}}
          </p>
        </div>

      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<style>
  .blog--header {
    width: 100%;
  }

  .blog--filter {
    width: 100%;
  }

  .blog--filter--body {
    display: flex;
    justify-content: center;
  }

  .blog--filter--disclosure {
    width: 100%;
    max-width: calc(100% - var(--spacing--block));
  }

  .blog--filter--menu {
    display: flex;
    gap: var(--spacing--item);
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  .blog--article-list {
    width: 100%;
  }

  .blog--article-list .article-card--root {
    height: 100%;
    justify-content: start;
  }

  .blog--article-list[data-container='staggered-grid'] {
    align-items: start;
    column-gap: var(--spacing--block);
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    row-gap: var(--spacing--block);
  }

  .blog--article-list[data-container='staggered-grid'] .article-card--root {
    height: auto;
    min-width: 0;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  @media (max-width: 767px) {
    .blog--header {
      padding-bottom: var(--spacing--item);
    }

    .blog--article-list[data-container='staggered-grid'] {
      column-gap: var(--spacing--item);
      grid-template-columns: repeat(var(--mobile-columns), minmax(0, 1fr));
      row-gap: var(--spacing--block);
    }
  }

  .blog--no-articles {
    padding: var(--spacing--section);
  }

  .blog--footer {
    clear: both;
    position: relative;
    width: 100%;
  }

  .blog--root--wedding {
    background: {{ wedding_background_color }} !important;
    background-color: {{ wedding_background_color }} !important;
    color: {{ wedding_font_color }} !important;
  }

  .blog--root--wedding,
  .blog--root--wedding [data-container],
  .blog--root--wedding [data-item],
  .blog--root--wedding p,
  .blog--root--wedding h1,
  .blog--root--wedding h2,
  .blog--root--wedding h3,
  .blog--root--wedding a,
  .blog--root--wedding span {
    color: {{ wedding_font_color }} !important;
    -webkit-text-fill-color: {{ wedding_font_color }} !important;
  }

  .blog--root--wedding .blog--wrapper {
    padding-left: clamp(20px, 4vw, 64px);
    padding-right: clamp(20px, 4vw, 64px);
  }

  .blog--root--wedding .blog--header {
    padding-bottom: clamp(42px, 6vw, 82px);
  }

  .blog--root--wedding .blog--title,
  .blog--root--wedding .blog--title a {
    color: {{ wedding_font_color }} !important;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
    font-size: clamp(40px, 5vw, 68px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.09em !important;
    line-height: 1.12 !important;
    text-transform: uppercase !important;
  }

  .blog--root--wedding .blog--filter {
    margin-top: 28px;
  }

  .blog--root--wedding .blog--filter--menu {
    column-gap: 30px;
    row-gap: 14px;
  }

  .blog--root--wedding .blog--filter--menu a,
  .blog--root--wedding .blog--filter--menu span,
  .blog--root--wedding .blog--filter--disclosure,
  .blog--root--wedding .blog--filter--disclosure * {
    color: {{ wedding_font_color }} !important;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
    font-size: 15px !important;
    font-weight: 400 !important;
    letter-spacing: 0.08em !important;
    line-height: 1.4 !important;
    text-transform: uppercase !important;
  }

  .blog--root--wedding .blog--article-list {
    column-gap: clamp(28px, 4vw, 64px) !important;
    row-gap: clamp(52px, 7vw, 92px) !important;
  }

  .blog--root--wedding .article-card--root {
    background: {{ wedding_background_color }} !important;
    background-color: {{ wedding_background_color }} !important;
    color: {{ wedding_font_color }} !important;
  }

  .blog--root--wedding .article-card--root[data-background-color='none'],
  .blog--root--wedding .article-card--root [data-background-color='none'] {
    background: {{ wedding_background_color }} !important;
    background-color: {{ wedding_background_color }} !important;
  }

  .blog--root--wedding .article-card--image {
    border-radius: 0 !important;
    margin-bottom: 24px !important;
    overflow: hidden;
  }

  .blog--root--wedding .article-card--heading,
  .blog--root--wedding .article-card--heading-link {
    color: {{ wedding_font_color }} !important;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
    font-size: clamp(24px, 2.2vw, 34px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.07em !important;
    line-height: 1.18 !important;
    text-decoration: none !important;
    text-transform: uppercase !important;
  }

  .blog--root--wedding .article-card--info,
  .blog--root--wedding .article-card--date,
  .blog--root--wedding .article-card--author,
  .blog--root--wedding .article-card--excerpt {
    color: {{ wedding_font_color }} !important;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
    font-size: 18px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.5 !important;
  }

  .blog--root--wedding .article-card--info {
    margin-top: 12px !important;
  }

  .blog--root--wedding .article-card--excerpt {
    margin-top: 22px !important;
  }

  .blog--root--wedding .article-card--read-more {
    align-items: center;
    border: 1px solid {{ wedding_cta_color }} !important;
    color: {{ wedding_cta_color }} !important;
    display: inline-flex;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
    font-size: 16px !important;
    font-weight: 400 !important;
    justify-content: center;
    letter-spacing: 0.08em !important;
    line-height: 1.3 !important;
    margin-top: 28px !important;
    min-height: 54px;
    padding: 14px 28px !important;
    text-decoration: none !important;
    text-transform: uppercase !important;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .blog--root--wedding .article-card--read-more,
  .blog--root--wedding .article-card--read-more span {
    color: {{ wedding_cta_color }} !important;
    -webkit-text-fill-color: {{ wedding_cta_color }} !important;
  }

  .blog--root--wedding .article-card--read-more:hover,
  .blog--root--wedding .article-card--read-more:focus-visible {
    background: {{ wedding_cta_color }} !important;
    color: {{ wedding_background_color }} !important;
  }

  .blog--root--wedding .article-card--read-more:hover span,
  .blog--root--wedding .article-card--read-more:focus-visible span {
    color: {{ wedding_background_color }} !important;
    -webkit-text-fill-color: {{ wedding_background_color }} !important;
  }

  .blog--root--wedding .blog--footer,
  .blog--root--wedding .blog--footer a,
  .blog--root--wedding .blog--footer span {
    color: {{ wedding_font_color }} !important;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
  }

  @media (max-width: 767px) {
    .blog--root--wedding .blog--filter--disclosure .disclosure--option,
    .blog--root--wedding .blog--filter--disclosure .disclosure--option a,
    .blog--root--wedding .blog--filter--disclosure .disclosure--option span,
    .blog--root--wedding .blog--filter--disclosure .disclosure--option-link,
    .blog--root--wedding .blog--filter--disclosure .disclosure--menu a,
    .blog--root--wedding .blog--filter--disclosure .disclosure--menu span,
    .blog--root--wedding .blog--filter--disclosure .disclosure--list a,
    .blog--root--wedding .blog--filter--disclosure .disclosure--list span,
    .blog--root--wedding .blog--filter--disclosure [role='option'],
    .blog--root--wedding .blog--filter--disclosure [role='option'] * {
      color: #fffff3 !important;
      -webkit-text-fill-color: #fffff3 !important;
    }

    .blog--root--wedding .blog--wrapper {
      padding-left: 16px;
      padding-right: 16px;
    }

    .blog--root--wedding .blog--header {
      padding-bottom: 40px;
    }

    .blog--root--wedding .blog--title,
    .blog--root--wedding .blog--title a {
      font-size: clamp(30px, 9vw, 40px) !important;
      line-height: 1.16 !important;
    }

    .blog--root--wedding .article-card--image {
      margin-bottom: 18px !important;
    }

    .blog--root--wedding .article-card--heading,
    .blog--root--wedding .article-card--heading-link {
      font-size: 22px !important;
      line-height: 1.22 !important;
    }

    .blog--root--wedding .article-card--info,
    .blog--root--wedding .article-card--date,
    .blog--root--wedding .article-card--author,
    .blog--root--wedding .article-card--excerpt {
      font-size: 17px !important;
      line-height: 1.5 !important;
    }

    .blog--root--wedding .article-card--read-more {
      font-size: 15px !important;
      margin-top: 24px !important;
      min-height: 50px;
      padding: 13px 24px !important;
    }
  }
</style>

{% schema %}
  {
    "name": "Blog",
    "class": "section--blog",
    "settings": [
      {
        "type": "header",
        "content": "General layout"
      },
      {
        "id": "layout-style",
        "label": "Layout style",
        "type": "select",
        "options": [
          { "label": "General", "value": "general" },
          { "label": "Wedding", "value": "wedding" }
        ],
        "default": "general"
      },
      {
        "id": "wedding-background-color",
        "label": "Wedding background color",
        "type": "color",
        "default": "#264A3D",
        "visible_if": "{{ section.settings.layout-style == 'wedding' }}"
      },
      {
        "id": "wedding-font-color",
        "label": "Wedding font color",
        "type": "color",
        "default": "#FFFDF0",
        "visible_if": "{{ section.settings.layout-style == 'wedding' }}"
      },
      {
        "id": "wedding-cta-color",
        "label": "Wedding CTA color",
        "type": "color",
        "default": "#FFFDF0",
        "visible_if": "{{ section.settings.layout-style == 'wedding' }}"
      },
      {
        "id": "spacing-above",
        "label": "Spacing above",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          }
        ],
        "default": "large"
      },
      {
        "id": "spacing-below",
        "label": "Spacing below",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          }
        ],
        "default": "large"
      },
      {
        "id": "container-width",
        "label": "Maximum container width",
        "type": "select",
        "options": [
          { "label": "Extra small", "value": "1" },
          { "label": "Small", "value": "2" },
