          { "label": "Small", "value": "paragraph" }
        ],
        "default": "block-heading"
      },
      {
        "id": "show-date",
        "label": "Show blog date",
        "type": "checkbox",
        "default": true
      },
      {
        "id": "show-author",
        "label": "Show author",
        "type": "checkbox",
        "default": true
      },
      {
        "id": "show-excerpt",
        "label": "Show excerpt",
        "type": "checkbox",
        "default": true
      },
      {
        "id": "show-cta",
        "label": "Show button",
        "type": "checkbox",
        "default": true
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "id": "mobile-spacing-above",
        "label": "Spacing above",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
