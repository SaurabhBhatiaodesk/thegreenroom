<!-- sections/footer.liquid -->

{%- liquid
  assign navigation_t = 'layout.footer.navigation' | t

  assign bg_color = section.settings.background-color
  assign block_count = section.blocks.size
  assign border = section.settings.border
  assign heading_type = section.settings.heading-type
  assign nav_font_size = section.settings.nav-font-size
  assign logo = section.settings.logo
  assign logo_enabled = section.settings.logo-enabled
  assign logo_width = section.settings.logo-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign other_blocks = section.blocks | reject: 'type', 'subscribe'
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign subscribe_block = section.blocks | find: 'type', 'subscribe'
  assign text_color = section.settings.text-color

  assign aspect_ratio = 2.0
  if logo
    assign aspect_ratio = logo.aspect_ratio
  endif

  assign logo_height = logo_width | divided_by: aspect_ratio
-%}

<div
  class="footer--root"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="5"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-x-alignment="{{ mobile_text_alignment }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
  style="--block-count:{{ block_count }};--font--nav--size:{{ nav_font_size }}px;--logo-height:{{ logo_height }}px;--logo-width:{{ logo_width }}px;"
>
  <div class="footer--wrapper">
    <div class="footer--container">
      {%- if logo_enabled -%}
        <div class="footer--logo">
          {%- liquid
            if logo
              assign rendered_width = logo.width | times: 2
              assign sizes = logo_width | append: 'px'
              echo logo | image_url: width: rendered_width | image_tag: loading: 'lazy', sizes: sizes
            else
              render 'placeholder', type: 'logo', display_type: 'aspect-ratio', aspect_ratio: aspect_ratio
            endif
          -%}
        </div>
      {%- endif -%}

      <div class="footer--blocks">
        {%- for block in other_blocks -%}
          <div
            class="footer--block"
            data-block-type="{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <div class="footer--block--container" data-container="block">
              {%- case block.type -%}
                {%- when 'about' -%}
                  {%- unless block.settings.about-title == blank -%}
                    <div class="footer--block--heading" data-item="{{ heading_type }}">
                      {{- block.settings.about-title | escape -}}
                    </div>
                  {%- endunless -%}

                  {%- unless block.settings.text == blank -%}
                    <div class="footer--about-text" data-item="rte-content">
                      {%- assign current_year = 'now' | date: '%Y' -%}
                      {{- block.settings.text | replace: '[current_year]', current_year -}}
                    </div>
                  {%- endunless -%}

                  {%- liquid
                    if section.settings.enable-follow-on-shop
                      echo shop | login_button: action: 'follow'
                    endif
                  -%}

                {%- when 'menu' -%}
                  {%- liquid
                    assign collapsible_row_enabled = block.settings.collapsible-row-enabled
                    assign linklist = linklists[block.settings.menu]
                    assign show_policy_links = block.settings.show-policy-links
                  -%}

                  {%- unless block.settings.menu-title == blank -%}
                    <div
                      class="footer--block--heading"
                      data-item="{{ heading_type }}"
                      {% if collapsible_row_enabled %}
                        data-mq="medium-large"
                      {% endif %}
                    >
                      {{- block.settings.menu-title | escape -}}
                    </div>
                  {%- endunless -%}

                  {%- capture block_list -%}
                    {%- if linklist.links.size > 0 or show_policy_links -%}
                      <ul class="footer--menu" aria-label="{{ navigation_t }}">
                        {%- for link in linklist.links -%}
                          <li>
                            {%- if link.url == routes.search_url -%}
                              <div
                                data-drawer-open="top"
                                data-drawer-view="search"
                                tabindex="0"
                                data-item="sub-nav-text"
                              >
                                {{- link.title -}}
                              </div>
                            {%- else -%}
                              <a
                                href="{{ link.url }}"
                                title="{{ link.title }}"
                                data-item="sub-nav-text"
                              >
                                {{- link.title -}}
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}

                        {%- if show_policy_links -%}
                          {%- for policy in shop.policies -%}
                            {%- if policy != blank -%}
                              <li>
                                <a
                                  href="{{ policy.url }}"
                                  title="{{ policy.title }}"
                                  data-item="sub-nav-text"
                                >
                                  {{- policy.title -}}
                                </a>
                              </li>
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                      </ul>
                    {%- endif -%}
                  {%- endcapture -%}

                  <div
                    class="footer--menu-container"
                    {% if collapsible_row_enabled %}
                      data-mq="medium-large"
                    {% endif %}
                  >
                    {{- block_list -}}
                  </div>

                  {%- if collapsible_row_enabled -%}
                    <div class="footer--menu-container" data-mq="small">
                      {%- assign heading = block.settings.menu-title | default: linklist.title -%}
                      {%-
                        render 'collapsible-row',
                        description: block_list,
                        description_type: 'sub-nav-text',
                        heading: heading,
                        id: block.id,
                        text_color: text_color
                      -%}
                    </div>
                  {%- endif -%}

                {%- when 'liquid' -%}
                  {{- block.settings.custom-liquid -}}

              {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if section.blocks.size == 0 -%}
          <div class="footer--noblocks">
            {{- 'sections.onboarding.no_content' | t -}}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if subscribe_block -%}
      {%- liquid
        assign newsletter_enabled = subscribe_block.settings.newsletter-enabled
        assign newsletter_image = subscribe_block.settings.image
        assign newsletter_image_enabled = subscribe_block.settings.image-enabled
        assign newsletter_image_height = subscribe_block.settings.image-height
        assign newsletter_bg_color = subscribe_block.settings.background-color
        assign newsletter_heading = subscribe_block.settings.heading
        assign newsletter_info = subscribe_block.settings.description
        assign newsletter_text_color = subscribe_block.settings.text-color
        assign show_social = subscribe_block.settings.show-social-icons
      -%}

      <div
        class="footer--block"
        {% if newsletter_bg_color != bg_color %}
          data-background-color="{{ newsletter_bg_color }}"
          data-text-color="{{ newsletter_text_color }}"
        {% endif %}
        data-block-type="subscribe"
        {{ subscribe_block.shopify_attributes }}
      >
        {%- if newsletter_image_enabled -%}
          <div
            class="footer--subscribe-image"
            style="--image-height:{{ newsletter_image_height }}px;"
          >
            {%- liquid
              if newsletter_image
                assign image_width = 100 | divided_by: block_count
                assign sizes = '(max-width: 768px) 100vw, ' | append: image_width | append: 'vw'
                render 'image', image: newsletter_image, loading: 'lazy', sizes: sizes
              else
                render 'placeholder', type: 'lifestyle', placeholder_index: 1
              endif
            -%}
          </div>
        {%- endif -%}

        <div class="footer--block--container" data-container="block">
          {%- unless newsletter_heading == blank -%}
            <div class="footer--subscribe-heading" data-item="{{ heading_type }}">
              {{- newsletter_heading -}}
            </div>
          {%- endunless -%}

          {%- unless newsletter_info == blank -%}
            <div class="footer--subscribe-info" data-item="rte-content">
              {{- newsletter_info -}}
            </div>
          {%- endunless -%}

          {%- liquid
            if newsletter_enabled
              render 'subscribe-form', id: 'footer_form', alignment: 'left', mobile_alignment: 'center'
            endif

            if show_social
              render 'social-media', type: 'follow', alignment: 'left', mobile_alignment: mobile_text_alignment
            endif
          -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .footer--root {
    .placeholder-noblocks {
      width: 100%;
      padding: var(--spacing--item);

      @media (max-width: 767px) {
        text-align: center;
      }
    }
  }

  .footer--wrapper {
    display: flex;
    gap: var(--spacing--block);

    @media (max-width: 767px) {
      flex-direction: column;
    }

    @media (min-width: 768px) {
      justify-content: space-between;
    }
  }

  .footer--container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--block);

    @media (min-width: 768px) {
      flex-basis: 100%;

      .footer--wrapper:has(.footer--block[data-block-type='subscribe']) & {
        flex-basis: calc((var(--block-count) - 1) / var(--block-count) * 100%);
      }
    }
  }

  .footer--logo {
    --image--radius: 0;
    width: var(--logo-width);

    @media (max-width: 767px) {
      align-self: var(--x-alignment);
    }
  }

  .footer--blocks {
    display: flex;
    gap: var(--spacing--block);
    justify-content: space-between;

    @media (max-width: 767px) {
      flex-wrap: wrap;
    }
  }

  .footer--block {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;

    @media (max-width: 767px) {
      flex-basis: 100%;
      text-align: var(--text-alignment);
      align-items: var(--x-alignment);

      &[data-block-type='menu']:has(.collapsible-row--root)
        + &[data-block-type='menu']:has(.collapsible-row--root) {
        margin-top: var(--spacing--neg-block);
      }
    }

    @media (min-width: 768px) {
      flex-basis: calc(100% / var(--block-count));

      .footer--container:not(:has(+ &[data-block-type='subscribe'])) &:last-child:not(:first-child) {
        align-items: flex-end;
      }
    }

    &[data-block-type='subscribe'] {
      gap: var(--spacing--block);

      @media (min-width: 768px) {
        align-items: flex-end;
        max-width: 360px;

        &[data-background-color] {
          margin: calc(var(--section--padding-top) * -1) var(--spacing--neg-5)
            calc(var(--section--padding-bottom) * -1) 0;
          padding: var(--section--padding-top) var(--spacing--5) var(--section--padding-bottom);

          .footer--subscribe-image {
            width: calc(100% + 2 * var(--spacing--5));
          }
        }

        .footer--root:has(.footer--logo)
          &:not(:has(.footer--subscribe-image))[data-background-color] {
          padding-top: calc(var(--logo-height) + var(--section--padding-top) + var(--spacing--block));
        }

        .footer--root:has(.footer--logo)
          &:not(:has(.footer--subscribe-image)):not([data-background-color]) {
          margin-top: calc(var(--logo-height) + var(--spacing--block));
        }

        .subscribe-form--input {
          --font--size: var(--font--nav--size);
        }

        .footer--subscribe-image {
          --image--radius: 0;
          margin-top: calc(var(--section--padding-top) * -1);
          margin-right: var(--spacing--neg-5);
          width: calc(100% + var(--spacing--5));
        }
      }

      @media (max-width: 767px) {
        &[data-background-color] {
          margin: 0 var(--spacing--neg-item) calc(var(--section--padding-bottom) * -1);
          padding: var(--section--padding-top) var(--spacing--item) var(--section--padding-bottom);

          .footer--subscribe-image {
            margin: var(--spacing--neg-block) var(--spacing--neg-item) 0;
          }
        }
      }

      .footer--subscribe-image {
        & > * {
          max-height: var(--image-height);
        }

        .placeholder--container {
          @media (min-width: 768px) {
            padding-top: min(var(--image-height), calc(100% / var(--aspect-ratio)));
          }

          @media (max-width: 767px) {
            padding-top: min(var(--image-height), calc(100% / var(--mobile-aspect-ratio)));
          }
        }

        @media (max-width: 767px) {
          --image--radius: 0;
          width: calc(100% + 2 * var(--spacing--item));
          margin: 0 var(--spacing--neg-item);
        }
      }
    }
  }

  .footer--block--container {
    .social-media--root {
      padding-top: var(--spacing--1);
    }

    @media (min-width: 768px) {
      .footer--block:not(:first-child):not(:last-child) &,
      .footer--wrapper:has(.footer--block[data-block-type='subscribe'])
        .footer--block:not(:first-child):last-child
        & {
        margin: 0 auto;
      }
    }

    @media (max-width: 767px) {
      .footer--block[data-block-type='menu'] & {
        width: 100%;
      }
    }
  }

  .footer--menu {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--1);
  }

  .footer--about-text {
    max-width: 400px;
  }

  .footer--block--heading[data-item='nav-text'] {
    --font--size: var(--font--button--size);
  }

  .footer--block--heading,
  .footer--subscribe-heading,
  .footer--subscribe-info {
    width: 100%;
  }

  [data-item='sub-nav-text'],
  [data-item='rte-content'] {
    --font--size: var(--font--nav--size);
  }
{% endstylesheet %}

