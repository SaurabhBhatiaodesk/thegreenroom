{%- liquid
  assign section_id = 'wedding-video-text-' | append: section.id
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign should_autoplay = section.settings.autoplay
  if section.settings.show_play_button
    assign should_autoplay = false
  endif
-%}

<style>
  #{{ section_id }} {
    --wedding-video-bg: {{ bg_color }};
    --wedding-video-text: {{ text_color }};
    --wedding-video-accent: {{ accent_color }};
    --wedding-video-max-width: {{ section.settings.max_width }}px;
    --wedding-video-gap: {{ section.settings.desktop_gap }}px;
    background: var(--wedding-video-bg);
    color: var(--wedding-video-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .wedding-video-text__inner {
    width: min(100% - 40px, var(--wedding-video-max-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: calc(var(--wedding-video-gap) * 0.5);
    align-items: start;
  }

  #{{ section_id }} .wedding-video-text__content {
    width: 100%;
    max-width: 560px;
    min-width: 0;
  }

  #{{ section_id }} .wedding-video-text__eyebrow {
    font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif;
    font-weight: 400;
    margin: 0 0 14px;
    color: var(--wedding-video-accent);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #{{ section_id }} .wedding-video-text__heading {
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0;
    color: var(--wedding-video-text);
    font-size: clamp(40px, 3.4vw, 52px);
    line-height: 1.16;
    letter-spacing: 0.09em;
  }

  #{{ section_id }} .wedding-video-text__body {
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    margin-top: 88px;
    color: var(--wedding-video-text);
    font-size: 22px;
    line-height: 1.48;
    text-align: justify;
    text-align-last: left;
  }

  #{{ section_id }} .wedding-video-text__body > *:first-child {
    margin-top: 0;
  }

  #{{ section_id }} .wedding-video-text__body * {
    font-family: inherit;
  }

  #{{ section_id }} .wedding-video-text__body p {
    margin: 0 0 22px;
  }

  #{{ section_id }} .wedding-video-text__body > *:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .wedding-video-text__button {
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 60px;
    min-height: 72px;
    padding: 22px 50px;
    border: 1px solid var(--wedding-video-accent);
    color: var(--wedding-video-accent);
    background: transparent;
    text-decoration: none;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  #{{ section_id }} .wedding-video-text__button:hover,
  #{{ section_id }} .wedding-video-text__button:focus-visible {
    background: var(--wedding-video-accent);
    color: var(--wedding-video-bg);
  }

  #{{ section_id }} .wedding-video-text__media {
    width: 100%;
    max-width: 500px;
    justify-self: end;
  }

  #{{ section_id }} .wedding-video-text__video-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: {{ section.settings.video_aspect_ratio }};
    max-height: 680px;
    background: rgba(0, 0, 0, 0.04);
  }

  #{{ section_id }} .wedding-video-text__video-frame video,
  #{{ section_id }} .wedding-video-text__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #{{ section_id }} .wedding-video-text__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: rgba(34, 39, 36, 0.82);
    color: #fff;
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  #{{ section_id }} .wedding-video-text__play-button:hover,
  #{{ section_id }} .wedding-video-text__play-button:focus-visible {
    background: rgba(34, 39, 36, 1);
    transform: translate(-50%, -50%) scale(1.06);
  }

  #{{ section_id }} .wedding-video-text__play-button svg {
    width: 20px;
    height: 22px;
    margin-left: 4px;
  }

  #{{ section_id }} .wedding-video-text__play-button[hidden] {
    display: none;
  }

  #{{ section_id }} .wedding-video-text__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    color: var(--wedding-video-accent);
    text-align: center;
    font-size: 14px;
    font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif;
    font-weight: 400;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .wedding-video-text__eyebrow {
      font-size: 10px;
    }
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .wedding-video-text__inner {
      width: min(100% - 32px, var(--wedding-video-max-width));
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #{{ section_id }} .wedding-video-text__media {
      order: 1;
      max-width: 100%;
      justify-self: center;
    }

    #{{ section_id }} .wedding-video-text__video-frame {
      max-height: none;
    }

    #{{ section_id }} .wedding-video-text__content {
      order: 2;
      max-width: 100%;
      text-align: {{ section.settings.mobile_text_alignment }};
    }

    #{{ section_id }} .wedding-video-text__heading {
      font-size: clamp(30px, 7.2vw, 38px);
    }

    #{{ section_id }} .wedding-video-text__body {
      margin-top: 64px;
      font-size: 18px;
      line-height: 1.5;
      text-align: {{ section.settings.mobile_text_alignment }};
      text-align-last: auto;
    }

    #{{ section_id }} .wedding-video-text__button {
      margin-top: 48px;
      font-size: 17px;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .wedding-video-text__button,
    #{{ section_id }} .wedding-video-text__play-button {
      transition: none;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="wedding-video-text"
  data-section-id="{{ section.id }}"
  data-section-type="wedding-video-text"
>
  <div class="wedding-video-text__inner">
    <div class="wedding-video-text__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wedding-video-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="wedding-video-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="wedding-video-text__body">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="wedding-video-text__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="wedding-video-text__media">
      <div class="wedding-video-text__video-frame">
        {%- if section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1200x',
              autoplay: should_autoplay,
              loop: section.settings.loop_video,
              muted: true,
              controls: section.settings.show_controls
          }}
          {%- if section.settings.show_play_button -%}
            <button
              class="wedding-video-text__play-button"
              type="button"
              aria-label="Play wedding video"
              onclick="var video = this.parentElement.querySelector('video'); if (video) { video.controls = true; video.play(); this.hidden = true; }"
            >
              <svg aria-hidden="true" focusable="false" viewBox="0 0 20 22" fill="none">
                <path d="M2 1.5L19 11L2 20.5V1.5Z" fill="currentColor"/>
              </svg>
            </button>
          {%- endif -%}
        {%- else -%}
          <div class="wedding-video-text__placeholder">
            Add the wedding video in this section's Theme Editor settings.
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wedding video with text",
  "class": "section--wedding-video-text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Wedding flowers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Considered florals for wildly romantic celebrations"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>From intimate gatherings to full-scale wedding installations, our work is designed with softness, seasonality, and the feeling of the day in mind.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enquire now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "select",
      "id": "video_aspect_ratio",
      "label": "Video shape",
      "options": [
        {
          "value": "2 / 3",
          "label": "Mockup portrait (2:3)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait (3:4)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "16 / 9",
          "label": "Landscape"
        }
      ],
      "default": "2 / 3"
    },
    {
      "type": "checkbox",
      "id": "show_play_button",
      "label": "Show play button like mockup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video when play button is off",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show video controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf5ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3d332f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c98695"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Space between text and video",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 176,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 176,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Space between video and text",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Wedding video with text"
    }
  ]
}
{% endschema %}
