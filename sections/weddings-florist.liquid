{%- liquid
  assign section_id = 'wedding-florist-' | append: section.id
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign primary_image_top = section.settings.text_offset_top
  if section.settings.eyebrow != blank
    assign primary_image_top = primary_image_top | plus: 29
  endif
-%}

<style>
  #{{ section_id }} {
    --wedding-florist-bg: {{ bg_color }};
    --wedding-florist-text: {{ text_color }};
    --wedding-florist-accent: {{ accent_color }};
    --wedding-florist-max-width: {{ section.settings.max_width }}px;
    --wedding-florist-gap: {{ section.settings.desktop_gap }}px;
    --wedding-florist-padding-top: {{ section.settings.padding_top }}px;
    --wedding-florist-padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--wedding-florist-bg);
    color: var(--wedding-florist-text);
    padding-top: var(--wedding-florist-padding-top);
    padding-bottom: var(--wedding-florist-padding-bottom);
  }

  #{{ section_id }} .wedding-florist__inner {
    width: min(100% - 40px, var(--wedding-florist-max-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, calc({{ section.settings.text_width }}px + 32px)) minmax(360px, 1fr);
    gap: calc(var(--wedding-florist-gap) * 0.75);
    align-items: start;
  }

  #{{ section_id }} .wedding-florist__content {
    max-width: {{ section.settings.text_width }}px;
    padding-top: {{ section.settings.text_offset_top }}px;
    text-align: left;
  }

  #{{ section_id }} .wedding-florist__eyebrow {
    margin: 0 0 14px;
    color: var(--wedding-florist-text);
    font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif;
    font-weight: 400;
    font-size: 11px;
    font-style: normal;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #{{ section_id }} .wedding-florist__heading {
    margin: 0;
    color: var(--wedding-florist-text);
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-size: clamp(40px, 3.4vw, 52px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  #{{ section_id }} .wedding-florist__body {
    margin-top: 88px;
    color: var(--wedding-florist-text);
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-size: 22px;
    font-style: normal;
    line-height: 1.48;
    text-align: left;
    text-align-last: left;
  }

  #{{ section_id }} .wedding-florist__body > * {
    margin-top: 0;
    margin-bottom: 22px;
    font-family: inherit;
  }

  #{{ section_id }} .wedding-florist__body > *:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .wedding-florist__body ul,
  #{{ section_id }} .wedding-florist__body ol {
    margin: 28px 0 0;
    padding-left: 1.25em;
    list-style-position: outside;
  }

  #{{ section_id }} .wedding-florist__body ul {
    list-style-type: disc;
  }

  #{{ section_id }} .wedding-florist__body ol {
    list-style-type: decimal;
  }

  #{{ section_id }} .wedding-florist__body li {
    display: list-item;
    margin-bottom: 18px;
    padding-left: 0.15em;
    list-style: inherit;
  }

  #{{ section_id }} .wedding-florist__body li::marker {
    color: var(--wedding-florist-accent);
  }

  #{{ section_id }} .wedding-florist__body li:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .wedding-florist__body strong {
    font-weight: 700;
  }

  #{{ section_id }} .wedding-florist__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 60px;
    min-height: 72px;
    padding: 22px 50px;
    border: 1px solid var(--wedding-florist-accent);
    color: var(--wedding-florist-accent);
    background: transparent;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  #{{ section_id }} .wedding-florist__button:hover {
    background: var(--wedding-florist-accent);
    color: var(--wedding-florist-bg);
  }

  #{{ section_id }} .wedding-florist__media {
    position: relative;
    width: 100%;
    min-height: 620px;
  }

  #{{ section_id }} .wedding-florist__image-frame {
    width: 82%;
    margin: {{ primary_image_top }}px 0 0;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background: rgba(0, 0, 0, 0.04);
  }

  #{{ section_id }} .wedding-florist__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    image-rendering: auto;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  #{{ section_id }} .wedding-florist__image-frame--secondary {
    position: absolute;
    z-index: 2;
    top: -190px;
    right: 0;
    width: 55%;
    margin: 0;
    aspect-ratio: {{ section.settings.second_image_aspect_ratio }};
  }

  #{{ section_id }} .wedding-florist__placeholder {
    width: 100%;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    color: var(--wedding-florist-accent);
    font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif;
    font-weight: 400;
    text-align: center;
    font-size: 0.9rem;
    background: rgba(0, 0, 0, 0.04);
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .wedding-florist__eyebrow {
      font-size: 10px;
    }
    #{{ section_id }} {
      --wedding-florist-padding-top: {{ section.settings.mobile_padding_top }}px;
      --wedding-florist-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .wedding-florist__inner {
      width: min(100% - 32px, var(--wedding-florist-max-width));
      grid-template-columns: 1fr;
      gap: calc({{ section.settings.mobile_gap }}px * 0.9);
    }

    #{{ section_id }} .wedding-florist__media {
      order: 1;
    }

    #{{ section_id }} .wedding-florist__content {
      order: 2;
      max-width: none;
      padding-top: 0;
      text-align: {{ section.settings.mobile_text_alignment }};
    }

    #{{ section_id }} .wedding-florist__heading {
      margin-bottom: 0;
      font-size: clamp(30px, 7.2vw, 38px);
    }

    #{{ section_id }} .wedding-florist__body {
      margin-top: 64px;
      font-size: 18px;
      line-height: 1.5;
      text-align: {{ section.settings.mobile_text_alignment }};
      text-align-last: auto;
    }

    #{{ section_id }} .wedding-florist__button {
      display: flex;
      width: fit-content;
      margin-top: 48px;
      margin-left: auto;
      margin-right: auto;
      font-size: 17px;
      text-align: center;
    }

    #{{ section_id }} .wedding-florist__media {
      min-height: 460px;
    }

    #{{ section_id }} .wedding-florist__image-frame {
      width: 86%;
      margin-top: 105px;
    }

    #{{ section_id }} .wedding-florist__image-frame--secondary {
      top: {{ section.settings.mobile_second_image_top }}px;
      right: 0;
      width: 53%;
      margin: 0;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="wedding-florist"
  data-section-id="{{ section.id }}"
  data-section-type="wedding-florist"
>
  <div class="wedding-florist__inner">
    <div class="wedding-florist__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wedding-florist__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="wedding-florist__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="wedding-florist__body">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="wedding-florist__button" href="{{ section.settings.link_url }}">
          {{ section.settings.link_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="wedding-florist__media">
      {%- if section.settings.image != blank -%}
        <div class="wedding-florist__image-frame wedding-florist__image-frame--primary">
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'wedding-florist__image',
              loading: 'lazy',
              sizes: '(min-width: 750px) 42vw, 86vw',
              widths: '480, 720, 960, 1200, 1600, 2000, 2400'
          }}
        </div>
      {%- else -%}
        <div class="wedding-florist__placeholder">
          Add a florist image in this section's Theme Editor settings.
        </div>
      {%- endif -%}

      {%- if section.settings.second_image != blank -%}
        <div class="wedding-florist__image-frame wedding-florist__image-frame--secondary">
          {{
            section.settings.second_image
            | image_url: width: 2000
            | image_tag:
              class: 'wedding-florist__image',
              loading: 'lazy',
              sizes: '(min-width: 750px) 30vw, 53vw',
              widths: '400, 600, 800, 1000, 1200, 1600, 2000'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wedding florist",
  "class": "section--wedding-florist",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Meet Your Dream Team Florists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose The Green Room?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>With more than 800 weddings created over the last decade our talented florists have designed and curated countless arrangements for the most wonderful clients, safe to say you are in good hands.</p><p>Our team thrives on creating floral arrangements that go beyond beautiful—they’re breathtaking, unforgettable, and uniquely yours!</p><ul><li><strong>Quality Blooms:</strong> Locally sourced and carefully selected for each event.</li><li><strong>Creativity &amp; Craftsmanship:</strong> Bold designs that reflect your vision and personality.</li><li><strong>Systems &amp; processes for a stress-free experience:</strong> We’re committed to clarity so you know where you're at throughout the journey.</li></ul>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Meet Our Team"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "second_image",
      "label": "Overlay image"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "6 / 4",
          "label": "Wide rectangle"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "second_image_aspect_ratio",
      "label": "Overlay image shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "6 / 4",
          "label": "Wide rectangle"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf5ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b87961"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 340,
      "max": 560,
      "step": 20,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Space between text and image",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "text_offset_top",
      "label": "Text top offset",
      "min": 0,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 176,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 176,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Space between image and text",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_second_image_top",
      "label": "Overlay image vertical position",
      "min": -120,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": -40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Wedding florist"
    }
  ]
}
{% endschema %}
