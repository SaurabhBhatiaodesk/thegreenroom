<!-- sections/text-menu.liquid -->

{%- liquid
  assign bg_color = section.settings.background-color
  assign block_spacing = section.settings.block-spacing
  assign block_borders_enabled = section.settings.block-borders-enabled
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color
  assign text_horizontal_alignment = section.settings.text-horizontal-alignment
  assign mobile_text_horizontal_alignment = section.settings.mobile-text-horizontal-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below

  assign block_border = 'none'
  if block_borders_enabled
    assign block_border = 'bottom'
  endif
-%}

<div
  class="text-menu--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-full-width="{{ block_borders_enabled }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  style="--block-spacing:var(--spacing--{{ block_spacing }});"
>
  <div class="text-menu--wrapper">
    {%- for block in section.blocks -%}
      {%- liquid
        assign button_text = block.settings.button-text
        assign button_style = block.settings.button-style
        assign description = block.settings.description
        assign heading_type = block.settings.heading-type
        assign highlight_type = block.settings.highlight-type
        assign highlight_color = block.settings.highlight-color
        assign highlight_text = block.settings.highlight-text
        assign link = block.settings.link
        assign overline = block.settings.overline
        assign title = block.settings.title

        if forloop.last and block_borders_enabled
          assign block_border = 'none'
        endif
      -%}

      <a
        class="text-menu--block"
        href="{{ link }}"
        data-border="{{ block_border }}"
        {{ block.shopify_attributes }}
      >
        {%-
          render 'stacked-text',
          id: block.id,
          button_style_1: button_style,
          button_text_1: button_text,
          color: text_color,
          cover_link: true,
          description: description,
          heading_type: heading_type,
          highlight_color: highlight_color,
          highlight_text: highlight_text,
          highlight_type: highlight_type,
          mobile_x_alignment: mobile_text_horizontal_alignment,
          overline: overline,
          title: title,
          x_alignment: text_horizontal_alignment,
          y_alignment: 'none'
        -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .text-menu--block {
    display: block;

    &:has([data-text-color='white']) {
      &:before,
      &:after {
        background-color: var(--border--color-light);
      }
    }

    .stacked-text--wrapper {
      --text-padding: var(--block-spacing) 0;
    }

    &:first-child .stacked-text--wrapper {
      --text-padding: 0 0 var(--block-spacing);
    }

    &:last-child .stacked-text--wrapper {
      --text-padding: var(--block-spacing) 0 0;
    }

    @media (min-width: 768px) {
      .text-menu--root[data-container-width='6'] & {
        padding-left: var(--spacing--section--x);
        padding-right: var(--spacing--section--x);
      }
    }

    @media (hover: hover) {
      .stacked-text--title {
        transform: translate3d(0, 0, 0);
        transition: transform 0.2s var(--transition--standard);
        will-change: transform;
      }

      &:hover .stacked-text--title {
        transform: translate3d(var(--spacing--item), 0, 0);
      }
    }

    .stacked-text--root {
      width: 100%;
    }
  }
{% endstylesheet %}

