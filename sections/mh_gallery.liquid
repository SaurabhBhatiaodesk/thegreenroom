<div id="shopify-section-{{ section.id }}">
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .buttons_wrapper_d4 {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 36px;
      margin-top: 40px;
    }

    #shopify-section-{{ section.id }} .button_d4 {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 220px;
      min-height: 80px;
      padding: 16px 24px;
      text-align: center;
      text-decoration: none;
      background-repeat: no-repeat;
      background-position: center;
      background-size: 100% 100%;
      border: 0;

      opacity: 0;
      transform: translateY(40px) scale(0.95);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    #shopify-section-{{ section.id }} .button_d4.show {
      opacity: 1;
      transform: translateY(0) scale(1);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    #shopify-section-{{ section.id }} .button_d4:hover {
      transform: translateY(-6px) scale(1.05);
    }

    #shopify-section-{{ section.id }} .button_d4 .button-label {
    display: block;
    font-weight: bold;
      margin: 0;
      position: relative;
      z-index: 2;
      width: 100%;
      font-size: 16px;
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .buttons_wrapper_d4 {
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: center;
        gap: 18px;
      }

      #shopify-section-{{ section.id }} .button_d4 {
        width: 200px;
        min-height: 70px;
        padding: 14px 20px;
      }

      #shopify-section-{{ section.id }} .button_d4 .button-label {
        font-size: 15px;
      }
    }
  </style>

  <div class="buttons_wrapper_d4">
    {% for d in (1..4) %}
      {% capture button_image %}button_image_{{ d }}{% endcapture %}
      {% capture button_text_color %}button_text_color_{{ d }}{% endcapture %}
      {% capture button_text %}button_text_{{ d }}{% endcapture %}
      {% capture button_url %}button_url_{{ d }}{% endcapture %}

      {% if section.settings[button_text] != blank %}
        <a
          class="button_d4"
          data-index="{{ forloop.index }}"
          href="{{ section.settings[button_url] }}"
          style="color: {{ section.settings[button_text_color] }}; background-image: url('{{ section.settings[button_image] | image_url: width: 800 }}');"
        >
          <span class="button-label">{{ section.settings[button_text] }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const section = document.querySelector("#shopify-section-{{ section.id }}");
      const buttons = section.querySelectorAll(".button_d4");

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            buttons.forEach((btn, i) => {
              setTimeout(() => {
                btn.classList.add("show");
              }, i * 150);
            });
            observer.disconnect();
          }
        });
      }, { threshold: 0.2 });

      observer.observe(section);
    });
  </script>
</div>

