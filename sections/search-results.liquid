<!-- sections/search-results.liquid -->

{%- liquid
  assign filter_feedback_t = 'general.search.filter_feedback' | t
  assign results_for_t = 'sections.navigation.results_for' | t
  assign search_again_t = 'general.search.search_again' | t
  assign skip_link_t = 'general.a11y.skip_pagination' | t

  assign border = section.settings.border
  assign columns = section.settings.columns
  assign mobile_columns = section.settings.mobile-columns
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign rows = section.settings.rows
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign products_per_page = rows | times: columns

  assign result_type = 'other'
  for item in search.results limit: 1
    if item.object_type == 'product'
      assign result_type = 'product'
    endif
  endfor

  capture sizes
    render 'sizes-grid', columns: columns, mobile_columns: mobile_columns
  endcapture
-%}

{%- capture search_again_link -%}
  <a
    class="search-results--button"
    data-drawer-open="top"
    data-drawer-view="search"
    data-item="block-link"
    tabindex="0"
  >
    <span>{{- search_again_t -}}</span>
  </a>
{%- endcapture -%}

<div
  class="search-results--root"
  id="search-results-root"
  data-section-id="{{ section.id }}"
  data-background-color="none"
  data-border="{{ border }}"
  data-view="{{ result_type }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-container-width="5"
>
  <div
    class="search-results--wrapper"
    data-container="section"
    data-body-wrapper
    {% if result_type == 'product' %}
      data-aspect-ratio="{{ settings.image--product-size }}"
      data-max-columns="{{ columns }}"
    {% else %}
      data-aspect-ratio="{{ settings.image--article-size }}"
    {% endif %}
  >
    {%- if result_type == 'product' or search.results.size == 0 -%}
      <div
        class="search-results--spinner"
        aria-hidden="true"
        data-container="block"
        data-body-spinner
      >
        <div class="search-results--spinner-wrapper" data-item="spinner">
          {%- render 'icons', icon: 'spinner' -%}
        </div>
      </div>

      {%- paginate search.results by products_per_page -%}
        {%- if paginate.pages > 1 -%}
          <a data-item="a11y-button" href='#search_results_footer' data-body-pagination-link>
            {{- skip_link_t }}
          </a>
        {%- endif -%}

        <div
          class="search-results--products"
          data-body-grid
          data-container="panel"
          data-columns="{{ columns }}"
          data-mobile-columns="{{ mobile_columns }}"        >
          {%- if search.results.size > 0 -%}
            {%-
              render 'product-card' for search.results as product_item,
              transition_id: section.id,
              sizes: sizes
            -%}

            {%- liquid
              assign remainder = search.results.size | modulo: columns
              assign blank_count = 0
              if remainder > 0
                assign blank_count = columns | minus: remainder
              endif
            -%}

            {%- if blank_count > 0 -%}
              {%- for i in (1..blank_count) -%}
                <div
                  data-item="blank"
                  aria-hidden="true"
                  {% unless settings.transitions--other %}
                    data-transition-item="{{ section.id }}"
                  {% endunless %}
                ></div>
              {%- endfor -%}
            {%- endif -%}

          {%- else -%}
            <div class="search-results--filter-feedback" data-container="block">
              <p data-item="paragraph">
                {{- filter_feedback_t -}}
              </p>
            </div>

          {%- endif -%}
        </div>

        <div class="search-results--footer" id="search_results_footer" data-container="block">
          <div class="search-results--pagination" data-body-pagination>
            {%- liquid
              if paginate.pages > 1
                render 'pagination', paginate: paginate, hash: 'search_root'
              endif
            -%}
          </div>

          {{- search_again_link -}}
        </div>
      {%- endpaginate -%}

    {%- else -%}
      {%- paginate search.results by 20 -%}
        <div class="search-results--heading" data-container="block">
          <p data-item="caption">
            {{ search.results_count }} {{ results_for_t }} "{{ search.terms | replace: '*', '' }}"
          </p>
        </div>

        <div
          class="search-results--other"
          data-container="panel"
          data-columns="3"
          data-mobile-columns="1"        >
          {%-
            render 'article-card' for search.results as featured_article,
            show_cta: true,
            show_date: true,
            show_excerpt: true,
            sizes: sizes
          -%}
        </div>

        <div class="search-results--footer" id="search_results_footer" data-container="block">
          {%- liquid
            if paginate.pages > 1
              echo '<div class="search-results--pagination">'
                render 'pagination', paginate: paginate, hash: 'search_root'
              echo '</div>'
            endif
          -%}

          {{- search_again_link -}}
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .search-results--products {
    width: 100%;
  }

  .search-results--spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--spacing--8) 0;

    &[aria-hidden='true'] {
      display: none;
    }
  }

  .search-results--spinner-wrapper > * {
    margin: 0 auto;
  }

  .search-results--heading {
    text-align: center;
  }

  .search-results--filter-feedback {
    text-align: center;
    padding: var(--spacing--section--y) 0;
    background-color: var(--bg-color);

    @media (min-width: 768px) {
      [data-columns='2'] & {
        grid-column: 1 / span 2;
      }

      [data-columns='3'] & {
        grid-column: 1 / span 3;
      }

      [data-columns='4'] & {
        grid-column: 1 / span 4;
      }
    }

    @media (max-width: 767px) {
      [data-mobile-columns='1'] & {
        grid-column: 1 / span 1;
      }

      [data-mobile-columns='2'] & {
        grid-column: 1 / span 2;
      }
    }
  }

  .search-results--button {
    text-align: center;

    & a {
      padding: var(--spacing--item);
    }
  }

  .search-results--pagination {
    width: 100%;

    &:empty {
      display: none;
    }
  }
{% endstylesheet %}

