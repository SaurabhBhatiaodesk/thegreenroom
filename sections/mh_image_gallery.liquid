<style>
  #shopify-section-{{ section.id }} .mh_image_gallery_h5 {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .section_wrapper_h5 {
    width: 100%;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .block_h5 {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .block_image_h5 {
    display: block;
    flex: 0 0 auto;
    height: auto;
    max-width: none;
    transform: scale(0.88);
    opacity: 0;
    transition: transform 0.9s ease, opacity 0.9s ease;
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .block_image_h5.is-visible {
    transform: scale(1);
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .bottom_image_d9 {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: auto;
    z-index: 3;
    pointer-events: none;
    display: block;
  }

  #shopify-section-{{ section.id }} .mobile_dd {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .desktop_dd {
      display: none;
    }

    #shopify-section-{{ section.id }} .mobile_dd {
      display: block;
    }
  }
</style>

<section class="mh_image_gallery_h5"
  style="padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <div class="section_wrapper_h5">
    {% for block in section.blocks %}
      <div class="block_h5">
        {% if block.settings.image_1 != blank %}
          <img
            class="image_dd block_image_h5 mh-scroll-zoom-{{ section.id }}"
            src="{{ block.settings.image_1 | image_url }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            width="100%"
            height="100%"
            loading="lazy"
            style="width: {{ block.settings.image_width_1 }}%;"
          >
        {% endif %}

        {% if block.settings.image_2 != blank %}
          <img
            class="image_dd block_image_h5 mh-scroll-zoom-{{ section.id }}"
            src="{{ block.settings.image_2 | image_url }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            width="100%"
            height="100%"
            loading="lazy"
            style="width: {{ block.settings.image_width_2 }}%;"
          >
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if section.settings.desktop_image != blank %}
    <img
      class="image_dd desktop_dd bottom_image_d9"
      src="{{ section.settings.desktop_image | image_url }}"
      alt="{{ section.settings.desktop_image.alt | escape }}"
      width="100%"
      height="100%"
      loading="eager"
    >
  {% endif %}

  {% if section.settings.mobile_image != blank %}
    <img
      class="image_dd mobile_dd bottom_image_d9"
      src="{{ section.settings.mobile_image | image_url }}"
      alt="{{ section.settings.mobile_image.alt | escape }}"
      width="100%"
      height="100%"
      loading="eager"
    >
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var items = document.querySelectorAll('#shopify-section-{{ section.id }} .mh-scroll-zoom-{{ section.id }}');

    if (!items.length) return;

    var observer = new IntersectionObserver(function(entries, obs) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.2,
      rootMargin: '0px 0px -8% 0px'
    });

    items.forEach(function(item) {
      observer.observe(item);
    });
  });
</script>

{% schema %}
{
  "name": "TIC Image Gallery",
  "presets": [
    {
      "name": "TIC Image Gallery"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "__ Bottom Image __"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 01"
        },
        {
          "type": "range",
          "id": "image_width_1",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Image Width 01",
          "default": 50
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 02"
        },
        {
          "type": "range",
          "id": "image_width_2",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Image Width 02",
          "default": 50
        }
      ]
    }
  ]
}
{% endschema %}