{%- liquid
  assign account_t = 'layout.header.account_view_link' | t
  assign toggle_drawer_t = 'layout.header.toggle_drawer' | t
  assign cart_title_t = 'cart.title' | t
  assign menu_t = 'layout.header.menu' | t
  assign search_t = 'general.search.search' | t

  assign bg_color = section.settings.background-color
  assign border = section.settings.bottom-border
  assign cart_type = settings.cart--type
  assign highlight_color = section.settings.highlight-color
  assign highlight_item = section.settings.highlight-item | handleize
  assign hover_disabled = section.settings.hover-disabled
  assign layout = section.settings.layout
  assign logo = section.settings.logo
  assign logo_height = section.settings.logo-height
  assign menu = section.settings.menu
  assign mobile_logo_height = section.settings.mobile-logo-height
  assign modal_bg = section.settings.modal-background-color
  assign modal_item = section.settings.modal-item | handleize
  assign modal_text_color = section.settings.modal-text-color | default: 'body'
  assign overlap_behavior = section.settings.overlap-behavior
  assign reduce_height = section.settings.reduce-height
  assign scroll_hide = section.settings.hide-on-scroll
  assign show_icons = section.settings.icons-enabled
  assign show_search = section.settings.search-enabled
  assign sticky_enabled = section.settings.sticky-enabled
  assign text_color = section.settings.text-color
  assign transparent_enabled = section.settings.transparent-enabled
  assign transparent_text_color = section.settings.transparent-text-color | default: 'body'
  assign transparent_logo = section.settings.transparent-logo
  assign white_menu_background = section.settings.white-menu-background

  assign alternate_header_enabled = section.settings.alternate-header-enabled
  assign alternate_header_pages = section.settings.alternate-header-pages
  assign alternate_header_blogs = section.settings.alternate-header-blogs
  assign alternate_transparent_header_pages = section.settings.alternate-transparent-header-pages
  assign alternate_transparent_header_blogs = section.settings.alternate-transparent-header-blogs
  assign alternate_header_transparent = false
  assign alternate_logo_link = section.settings.alternate-logo-link | default: routes.root_url
  assign use_alternate_header = false

  if page != blank
    if alternate_header_pages != blank
      assign alternate_header_page_handles = alternate_header_pages | remove: ' ' | split: ','
      if alternate_header_page_handles contains page.handle
        assign use_alternate_header = true
      endif
    endif

    if alternate_transparent_header_pages != blank
      assign alternate_transparent_header_page_handles = alternate_transparent_header_pages | remove: ' ' | split: ','
      if alternate_transparent_header_page_handles contains page.handle
        assign use_alternate_header = true
        assign alternate_header_transparent = true
      endif
    endif
  elsif request.page_type == 'blog' and blog != blank
    if alternate_header_blogs != blank
      assign alternate_header_blog_handles = alternate_header_blogs | remove: ' ' | split: ','
      if alternate_header_blog_handles contains blog.handle
        assign use_alternate_header = true
      endif
    endif

    if alternate_transparent_header_blogs != blank
      assign alternate_transparent_header_blog_handles = alternate_transparent_header_blogs | remove: ' ' | split: ','
      if alternate_transparent_header_blog_handles contains blog.handle
        assign use_alternate_header = true
        assign alternate_header_transparent = true
      endif
    endif
  endif

  unless alternate_header_enabled
    assign use_alternate_header = false
    assign alternate_header_transparent = false
  endunless

  if use_alternate_header
    assign layout = 'alternate'
    assign logo = section.settings.alternate-logo | default: logo
    assign logo_height = section.settings.logo-height
    assign mobile_logo_height = section.settings.mobile-logo-height
    if alternate_header_transparent
      assign text_color = 'white'
      assign transparent_enabled = true
      assign transparent_text_color = 'white'
    else
      assign text_color = 'body'
      assign transparent_enabled = false
      assign transparent_text_color = 'body'
    endif
    assign transparent_logo = section.settings.alternate-logo | default: logo
    assign border = false
    assign show_icons = true
  endif

  assign menu_bg_color = bg_color
  assign menu_text_color = text_color
  if white_menu_background
    assign menu_text_color = 'body'
    assign menu_bg_color = 'none'
  endif

  assign region_enabled = false
  if section.settings.show-region-selector and localization.available_countries.size > 1
    assign region_enabled = true
  endif

  assign locale_enabled = false
  if section.settings.show-locale-selector and localization.available_languages.size > 1
    assign locale_enabled = true
  endif

  assign toolbar_block = section.blocks | find: 'type', 'toolbar'
-%}

{%- capture logo_html -%}
  <div class="header--primary-logo">
    {%-
      render 'small-logo',
      logo: logo,
      height: logo_height,
      mobile_height: mobile_logo_height
    -%}
  </div>

  {%- if transparent_logo and transparent_enabled -%}
    <div class="header--secondary-logo">
      {%-
        render 'small-logo',
        logo: transparent_logo,
        height: logo_height,
        mobile_height: mobile_logo_height
      -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture search_html -%}
  {%- if show_search -%}
    <button
      class="header--search"
      data-drawer-open="top"
      data-drawer-view="search"
      data-item="nav-text"
      aria-label="{{ search_t }}"
      tabindex="0"
    >
      {%- liquid
        if show_icons
          render 'icons', icon: 'search'
        else
          echo search_t
        endif
      -%}
    </button>
  {%- endif -%}
{%- endcapture -%}

{%- if use_alternate_header -%}
  <div
    class="ccg-alt-header-shell{% if alternate_header_transparent %} ccg-alt-header-shell--transparent{% else %} ccg-alt-header-shell--solid{% endif %}"
    data-alternate-header="true"
    data-transparent="{{ alternate_header_transparent }}"
  >
    <div class="ccg-alt-header">
      <div class="ccg-alt-header__left">
        <button
          class="ccg-alt-header__menu-button"
          type="button"
          data-drawer-open="left"
          data-drawer-view="y-menu"
          aria-label="{{ toggle_drawer_t }}"
          aria-haspopup="menu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <div class="ccg-alt-header__logo">
        <a href="{{ alternate_logo_link }}" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.alternate-logo != blank -%}
            {%- assign alt_logo_width = section.settings.logo-height | times: section.settings.alternate-logo.aspect_ratio | round -%}
            {{
              section.settings.alternate-logo
              | image_url: width: 800
              | image_tag:
                widths: '120, 180, 240, 320, 480, 640, 800',
                width: alt_logo_width,
                class: 'ccg-alt-header__logo-image',
                loading: 'eager',
                alt: shop.name
            }}
          {%- elsif logo != blank -%}
            {%- assign fallback_logo_width = logo_height | times: logo.aspect_ratio | round -%}
            {{
              logo
              | image_url: width: 800
              | image_tag:
                widths: '120, 180, 240, 320, 480, 640, 800',
                width: fallback_logo_width,
                class: 'ccg-alt-header__logo-image',
                loading: 'eager',
                alt: shop.name
            }}
          {%- else -%}
            <span class="ccg-alt-header__shop-name">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <nav class="ccg-alt-header__nav" aria-label="{{ menu_t }}">
        {%- assign alternate_menu = section.settings.alternate-menu -%}
        {%- if alternate_menu != blank -%}
          {%- for link in alternate_menu.links -%}
            <a
              href="{{ link.url }}"
              class="ccg-alt-header__link"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{- link.title -}}
            </a>
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.alternate-cta-text != blank and section.settings.alternate-cta-link != blank -%}
          <a
            href="{{ section.settings.alternate-cta-link }}"
            class="ccg-alt-header__link ccg-alt-header__cta"
          >
            {{- section.settings.alternate-cta-text -}}
          </a>
        {%- endif -%}
      </nav>

      <div class="ccg-alt-header__mobile-spacer" aria-hidden="true"></div>
    </div>
  </div>
{%- endif -%}

<header-element
  class="header--root{% if use_alternate_header %} header--root-hidden-alternate{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="header"
  data-background-color="{{ bg_color }}"
  {% if border %}
    data-border="bottom"
  {% endif %}
  data-container-width="6"
  data-hover-disabled="{{ hover_disabled }}"
  data-icons="{{ show_icons }}"
  data-layout="{{ layout }}"
  data-alternate-header="{{ use_alternate_header }}"
  data-mobile-spacing-above="none"
  data-mobile-spacing-below="none"
  data-overlap-behavior="{{ overlap_behavior }}"
  data-reduce-height="{{ reduce_height }}"
  data-scroll-hide="{{ scroll_hide }}"
  data-spacing-above="none"
  data-spacing-below="none"
  data-sticky="false"
  data-sticky-enabled="{{ sticky_enabled }}"
  data-text-color="{{ text_color }}"
  data-transparent-enabled="{{ transparent_enabled }}"
  data-transparent-text-color="{{ transparent_text_color }}"
  aria-expanded="false"
  aria-hidden="false"
>
  {%- unless toolbar_block == blank -%}
    {%- liquid
      assign toolbar_border = toolbar_block.settings.bottom-border
      assign text = toolbar_block.settings.text
      assign toolbar_text_alignment = toolbar_block.settings.text-alignment

      assign toolbar_region_enabled = false
      if toolbar_block.settings.show-region-selector and localization.available_countries.size > 1
        assign toolbar_region_enabled = true
      endif

      assign toolbar_locale_enabled = false
      if toolbar_block.settings.show-locale-selector and localization.available_languages.size > 1
        assign toolbar_locale_enabled = true
      endif
    -%}

    <div
      class="header--toolbar"
      data-text-alignment="{{ toolbar_text_alignment }}"
      data-bottom-border="{{ toolbar_border }}"
    >
      <div class="header--toolbar-wrapper">
        {%- unless text == blank -%}
          <div class="header--toolbar-text" data-item="nav-text">
            {{- text -}}
          </div>

          {%- for i in (0..4) -%}
            <div
              class="header--toolbar-text"
              aria-hidden="true"
              data-mq="small"
              data-item="nav-text"
            >
              {{- text -}}
            </div>
          {%- endfor -%}
        {%- endunless -%}
      </div>

      {%- if toolbar_locale_enabled or toolbar_region_enabled -%}
        <div class="header--toolbar-localization" data-mq="large">
          {%-
            render 'localization',
            locale_enabled: toolbar_locale_enabled,
            region_enabled: toolbar_region_enabled,
            id: 'toolbar'
          -%}
        </div>
      {%- endif -%}
    </div>
  {%- endunless -%}

  {%- unless use_alternate_header -%}
  <div class="header--wrapper">
    <div class="header--logo">
      {{- logo_html -}}
    </div>

    {%- if layout == 'center-below' or overlap_behavior == 'center-below' -%}
      <div class="header--search-container">
        {{- search_html -}}
      </div>
    {%-  endif -%}

    <nav
      class="header--primary-nav"
      {% unless layout == 'drawer' %}
        aria-hidden="true"
      {% endunless %}
    >
      <button
        class="header--drawer-toggle"
        data-drawer-open="left"
        data-drawer-view="y-menu"
        {% unless show_icons %}
          data-item="nav-text"
        {% else %}
          aria-label="{{ toggle_drawer_t }}"
        {% endunless %}
        aria-haspopup="menu"
      >
        {%- liquid
          if show_icons
            echo '<span></span><span></span><span></span>'
          else
            echo menu_t
          endif
        -%}
      </button>

      {{- search_html -}}

      {%- unless layout == 'drawer' -%}
        {%-
          render 'x-menu',
          handle: menu,
          bg_color: menu_bg_color,
          blocks: section.blocks,
          highlight_color: highlight_color,
          highlight_item: highlight_item,
          modal_item: modal_item,
          text_color: menu_text_color
        -%}
      {%- endunless -%}
    </nav>

    <nav class="header--secondary-nav" data-item="nav-text">
      {%- if locale_enabled or region_enabled -%}
        <div class="header--localization" data-mq="large">
          {%-
            render 'localization',
            locale_enabled: locale_enabled,
            region_enabled: region_enabled,
            id: 'header'
          -%}
        </div>
      {%- endif -%}

      {{- search_html -}}

      {%- if shop.customer_accounts_enabled -%}
        <a
          class="header--account"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          {% unless show_icons %}
            data-item="nav-text"
          {% endunless %}
          aria-label="{{ account_t }}"
        >
          {%- liquid
            if show_icons
              render 'icons', icon: 'account'
            else
              echo account_t
            endif
          -%}
        </a>
      {%- endif -%}

      <a
        class="header--cart"
        aria-label="{{ cart_title_t }}"
        {% if cart_type == 'drawer' %}
          data-drawer-open="right"
          data-drawer-view="cart-drawer"
          aria-haspopup="menu"
          href="#"
        {% else %}
          href="{{ routes.cart_url }}"
        {% endif %}
        data-cart-count="{{ cart.item_count }}"
      >
        <span class="header--cart-wrapper">
          {%- liquid
            if show_icons
              render 'icons', icon: 'bag'
            else
              echo cart_title_t
            endif
          -%}
        </span>
      </a>
    </nav>
  </div>
  {%- endunless -%}
</header-element>

<style>
  :root {
    --header--sticky: {% if sticky_enabled %}1{% else %}0{% endif %};
  }

  .section--announcement ~ #shopify-section-{{ section.id }} {
    top: calc(var(--announcement--sticky, 0) * var(--announcement--height, 0px));
    z-index: 4;
  }


  .header--root-hidden-alternate {
    display: none !important;
  }

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 30;
  }

  .ccg-alt-header-shell {
    position: relative !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 999 !important;
    display: block !important;
    background: {{ section.settings.alternate-header-background-color }} !important;
    color: #264A3D !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .ccg-alt-header-shell .ccg-alt-header {
    box-sizing: border-box !important;
    display: grid !important;
    grid-template-columns: minmax(70px, 1fr) auto minmax(0, 1fr) !important;
    align-items: center !important;
    width: 100% !important;
    min-height: 108px !important;
    padding: 18px 44px !important;
    margin: 0 !important;
    background: transparent !important;
    color: #264A3D !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .ccg-alt-header__left {
    grid-column: 1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
  }

  .ccg-alt-header__menu-button {
    appearance: none !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    width: 38px !important;
    height: 28px !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    color: #264A3D !important;
    cursor: pointer !important;
  }

  .ccg-alt-header__menu-button span {
    display: block !important;
    flex: 0 0 2px !important;
    width: 38px !important;
    height: 2px !important;
    min-height: 2px !important;
    max-height: 2px !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #264A3D !important;
    border: 0 !important;
    border-radius: 0 !important;
    opacity: 1 !important;
    transform: none !important;
  }

  .ccg-alt-header__logo {
    grid-column: 2 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 24px !important;
  }

  .ccg-alt-header__logo a {
    display: block !important;
    line-height: 0 !important;
  }

  .ccg-alt-header__logo-image {
    display: block !important;
    width: auto !important;
    height: {{ section.settings.logo-height }}px !important;
    max-width: min(320px, 26vw) !important;
    object-fit: contain !important;
    transform: scale({{ section.settings.alternate-logo-scale | divided_by: 100.0 }}) !important;
    transform-origin: center center !important;
    visibility: visible !important;
    opacity: 1 !important;
    filter: brightness(0) saturate(100%) invert(24%) sepia(20%) saturate(1043%) hue-rotate(109deg) brightness(92%) contrast(88%) !important;
  }

  .ccg-alt-header__shop-name {
    display: block !important;
    color: #264A3D !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
  }

  .ccg-alt-header__nav {
    grid-column: 3 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 34px !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    white-space: nowrap !important;
  }

  .ccg-alt-header__link {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #264A3D !important;
    background: transparent !important;
    text-decoration: none !important;
    font-size: 16px !important;
    line-height: 1.3 !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  .ccg-alt-header__link:hover,
  .ccg-alt-header__link:focus {
    color: #264A3D !important;
    opacity: 0.8 !important;
  }

  .ccg-alt-header__cta {
    min-height: 42px !important;
    padding: 9px 16px !important;
    border: 1px solid #264A3D !important;
    color: #264A3D !important;
    background: transparent !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease !important;
  }

  .ccg-alt-header__cta:hover,
  .ccg-alt-header__cta:focus-visible {
    color: {{ section.settings.alternate-header-background-color }} !important;
    background: #264A3D !important;
    border-color: #264A3D !important;
    opacity: 1 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14) !important;
  }

  .ccg-alt-header__cta:active {
    transform: translateY(0) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12) !important;
  }

  .ccg-alt-header-shell--transparent {
    position: absolute !important;
    background: transparent !important;
    color: #ffffff !important;
  }

  .ccg-alt-header-shell--transparent .ccg-alt-header {
    color: #ffffff !important;
  }

  .ccg-alt-header-shell--transparent .ccg-alt-header__menu-button,
  .ccg-alt-header-shell--transparent .ccg-alt-header__shop-name,
  .ccg-alt-header-shell--transparent .ccg-alt-header__link,
  .ccg-alt-header-shell--transparent .ccg-alt-header__link:hover,
  .ccg-alt-header-shell--transparent .ccg-alt-header__link:focus {
    color: #ffffff !important;
  }

  .ccg-alt-header-shell--transparent .ccg-alt-header__menu-button span {
    background: #ffffff !important;
  }

  .ccg-alt-header-shell--transparent .ccg-alt-header__logo-image {
    filter: none !important;
  }

  .ccg-alt-header-shell--transparent .ccg-alt-header__cta {
    color: {{ section.settings.alternate-cta-color }} !important;
    border-color: {{ section.settings.alternate-cta-color }} !important;
  }

  .ccg-alt-header-shell--transparent .ccg-alt-header__cta:hover,
  .ccg-alt-header-shell--transparent .ccg-alt-header__cta:focus-visible {
    color: #1a1a1a !important;
    background: {{ section.settings.alternate-cta-color }} !important;
    border-color: {{ section.settings.alternate-cta-color }} !important;
  }

  .ccg-alt-header__mobile-spacer {
    display: none !important;
  }

  @media only screen and (max-width: 989px) {
    .ccg-alt-header-shell .ccg-alt-header {
      grid-template-columns: 1fr auto 1fr !important;
      min-height: 82px !important;
      padding: 14px 20px !important;
    }

    .ccg-alt-header__menu-button {
      width: 30px !important;
      height: 23px !important;
    }

    .ccg-alt-header__menu-button span {
      width: 30px !important;
    }

    .ccg-alt-header__logo {
      padding: 0 12px !important;
    }

    .ccg-alt-header__logo-image {
      height: {{ section.settings.mobile-logo-height }}px !important;
      max-width: 55vw !important;
    }

    .ccg-alt-header__nav {
      display: none !important;
    }

    .ccg-alt-header__mobile-spacer {
      grid-column: 3 !important;
      display: block !important;
    }
  }

  @media only screen and (max-width: 749px) {
    .ccg-alt-header-shell .ccg-alt-header {
      grid-template-rows: auto auto !important;
      min-height: 0 !important;
      padding: 14px 16px 16px !important;
      row-gap: 12px !important;
    }

    .ccg-alt-header__nav {
      grid-column: 1 / -1 !important;
      grid-row: 2 !important;
      display: flex !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 10px 22px !important;
      padding: 0 !important;
      white-space: normal !important;
    }

    .ccg-alt-header__link {
      font-size: 13px !important;
    }

    .ccg-alt-header__cta {
      min-height: 34px !important;
      padding: 6px 10px !important;
    }
  }
</style>

{% comment %} Measure header ASAP to prevent CLS {% endcomment %}
<script>
  const header_root = document.querySelector('.header--root');
  header_root && document.documentElement.style.setProperty(
    '--header--height', `${header_root.offsetHeight.toFixed(2)}px`
  );
</script>

{%- if show_search and show_icons == false -%}
  <element-relocator data-move-into=".mobile-nav--search" data-mq="none">
    {{- search_html -}}
  </element-relocator>
{%- endif -%}

{%- if shop.customer_accounts_enabled and show_icons == false -%}
  <element-relocator data-move-into=".mobile-nav--account" data-mq="none">
    {{- account_html -}}
  </element-relocator>
{%- endif -%}

<element-relocator data-move-into=".mobile-nav--menu" data-mq="none">
  {%-
    render 'y-menu',
    menu: menu,
    blocks: section.blocks,
    highlight_color: highlight_color,
    highlight_item: highlight_item,
    modal_item: modal_item
  -%}
</element-relocator>

{%- if locale_enabled or region_enabled -%}
  <element-relocator data-move-into=".mobile-nav--localization" data-mq="none">
    {%-
      render 'localization',
      locale_enabled: locale_enabled,
      region_enabled: region_enabled,
      id: 'mobile-nav'
    -%}
  </element-relocator>
{%- endif -%}

{%- unless modal_item == blank -%}
  {%- liquid
    assign modal_content = 'sections.header.empty_page_content' | t
    unless section.settings.modal-content == blank
      assign modal_content = pages[section.settings.modal-content].content
    endunless
  -%}

  <modal-element
    class="modal--root"
    data-id="header-modal"
    data-background-color="dark"
    data-translucent="true"
    data-transition-item="viewport"
    data-transition-type="fade-in"
    data-transition-trigger="custom"
    aria-hidden="true"
  >
    <div class="modal--view">
      <div
        class="header--modal"
        data-background-color="{{ modal_bg }}"
        data-text-color="{{ modal_text_color }}"
      >
        {{- modal_content -}}
      </div>
    </div>
  </modal-element>
{%- endunless -%}

