{%- liquid
  assign section_id = 'wedding-three-image-gallery-' | append: section.id
  assign bg_color = section.settings.background_color
  assign accent_color = section.settings.accent_color
  assign current_page_url = shop.url | append: request.path
  assign image_three_vertical_offset = section.settings.image_three_vertical_offset
  assign mobile_image_three_vertical_offset = section.settings.mobile_image_three_vertical_offset
-%}

<style>
  #shopify-section-{{ section.id }} {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    overflow-x: clip !important;
    overflow-y: visible !important;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} > * {
    max-width: none !important;
  }

  #{{ section_id }} {
    --gallery-bg: {{ bg_color }};
    --gallery-accent: {{ accent_color }};
    --gallery-padding-top: {{ section.settings.padding_top }}px;
    --gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    width: 100%;
    max-width: none;
    margin: 0;
    background: var(--gallery-bg);
    padding-top: var(--gallery-padding-top);
    padding-bottom: var(--gallery-padding-bottom);
    overflow-x: clip;
    overflow-y: visible;
    box-sizing: border-box;
  }

  #{{ section_id }} .wedding-three-image-gallery__inner {
    position: relative;
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
  }

  #{{ section_id }} .wedding-three-image-gallery__layout {
    position: relative;
    width: 100%;
    max-width: none;
    min-height: calc({{ section.settings.desktop_height }}px + {{ image_three_vertical_offset }}px);
    margin: 0;
    box-sizing: border-box;
  }

  #{{ section_id }} .wedding-three-image-gallery__item {
    position: absolute;
    opacity: 0;
    transform: translateY(24px);
    animation: wedding-three-image-gallery-fade-up-{{ section.id }} 700ms ease forwards;
  }

  #{{ section_id }} .wedding-three-image-gallery__item--one {
    top: 0;
    left: 50%;
    right: auto;
    width: 100vw;
    max-width: 100vw;
    margin-left: -50vw;
    animation-delay: 100ms;
  }

  #{{ section_id }} .wedding-three-image-gallery__item--two {
    top: {{ section.settings.image_two_top }}%;
    left: {{ section.settings.image_two_left }}%;
    width: {{ section.settings.image_two_width }}%;
    z-index: 1;
    animation-delay: 220ms;
  }

  #{{ section_id }} .wedding-three-image-gallery__item--three {
    top: calc({{ section.settings.image_three_top }}% + {{ image_three_vertical_offset }}px);
    left: {{ section.settings.image_three_left }}%;
    width: {{ section.settings.image_three_width }}%;
    z-index: 2;
    animation-delay: 340ms;
  }

  #{{ section_id }} .wedding-three-image-gallery__image-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }

  #{{ section_id }} .wedding-three-image-gallery__item--one .wedding-three-image-gallery__image-frame {
    aspect-ratio: 16 / 9;
  }

  #{{ section_id }} .wedding-three-image-gallery__item--two .wedding-three-image-gallery__image-frame {
    aspect-ratio: {{ section.settings.image_two_aspect_ratio }};
  }

  #{{ section_id }} .wedding-three-image-gallery__item--three .wedding-three-image-gallery__image-frame {
    aspect-ratio: {{ section.settings.image_three_aspect_ratio }};
  }

  #{{ section_id }} .wedding-three-image-gallery__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1);
    transition: transform 700ms ease, filter 700ms ease;
  }

  #{{ section_id }} .wedding-three-image-gallery__image-frame:hover .wedding-three-image-gallery__image {
    transform: scale({{ section.settings.hover_zoom | divided_by: 100.0 | plus: 1 }});
    filter: saturate(1.04);
  }

  #{{ section_id }} .wedding-three-image-gallery__placeholder {
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: var(--gallery-accent);
    text-align: center;
    font-size: 0.9rem;
  }

  #{{ section_id }} .wedding-three-image-gallery__pin {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--gallery-accent);
    border-radius: 50%;
    color: var(--gallery-accent);
    background: var(--gallery-bg);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  #{{ section_id }} .wedding-three-image-gallery__image-frame:hover .wedding-three-image-gallery__pin,
  #{{ section_id }} .wedding-three-image-gallery__pin:focus-visible {
    opacity: {{ section.settings.pin_icon_opacity | divided_by: 100.0 }};
    pointer-events: auto;
  }

  #{{ section_id }} .wedding-three-image-gallery__pin:hover,
  #{{ section_id }} .wedding-three-image-gallery__pin:focus-visible {
    opacity: 1;
    background: var(--gallery-accent);
    color: var(--gallery-bg);
  }

  #{{ section_id }} .wedding-three-image-gallery__pin svg {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
  }

  #{{ section_id }} .wedding-three-image-gallery__pin-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes wedding-three-image-gallery-fade-up-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #{{ section_id }} {
      --gallery-padding-bottom: calc({{ section.settings.padding_bottom }}px + 80px);
    }

    #{{ section_id }} .wedding-three-image-gallery__layout {
      min-height: calc({{ section.settings.desktop_height }}px + {{ image_three_vertical_offset }}px + 100px);
    }

    #{{ section_id }} .wedding-three-image-gallery__item--two {
      top: 48%;
      left: 5%;
      width: 40%;
    }

    #{{ section_id }} .wedding-three-image-gallery__item--three {
      top: calc(52% + {{ image_three_vertical_offset }}px);
      left: 55%;
      width: 40%;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      --gallery-padding-top: {{ section.settings.mobile_padding_top }}px;
      --gallery-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .wedding-three-image-gallery__inner {
      width: 100%;
      max-width: none;
      margin: 0;
    }

    #{{ section_id }} .wedding-three-image-gallery__layout {
      width: 100%;
      max-width: none;
      min-height: calc({{ section.settings.mobile_height }}px + {{ mobile_image_three_vertical_offset }}px);
    }

    #{{ section_id }} .wedding-three-image-gallery__item--one {
      left: 50%;
      right: auto;
      width: 100vw;
      max-width: 100vw;
      margin-left: -50vw;
    }

    #{{ section_id }} .wedding-three-image-gallery__item--two {
      top: {{ section.settings.mobile_image_two_top }}%;
      left: {{ section.settings.mobile_image_two_left }}%;
      width: {{ section.settings.mobile_image_two_width }}%;
    }

    #{{ section_id }} .wedding-three-image-gallery__item--three {
      top: calc({{ section.settings.mobile_image_three_top }}% + {{ mobile_image_three_vertical_offset }}px);
      left: {{ section.settings.mobile_image_three_left }}%;
      width: {{ section.settings.mobile_image_three_width }}%;
    }

    #{{ section_id }} .wedding-three-image-gallery__pin {
      top: 10px;
      right: 10px;
      width: 36px;
      height: 36px;
      opacity: {{ section.settings.pin_icon_opacity | divided_by: 100.0 }};
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .wedding-three-image-gallery__item {
      opacity: 1;
      transform: none;
      animation: none;
    }

    #{{ section_id }} .wedding-three-image-gallery__image {
      transition: none;
    }

    #{{ section_id }} .wedding-three-image-gallery__image-frame:hover .wedding-three-image-gallery__image {
      transform: none;
      filter: none;
    }
  }
</style>

{%- capture pinterest_icon -%}
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12.1 2C6.6 2 3 5.8 3 10.1c0 2.7 1.5 4.2 2.4 4.2.4 0 .6-1.1.6-1.4 0-.4-.9-1.1-.9-2.6 0-3.2 2.5-5.5 6.6-5.5 3.2 0 5.6 1.8 5.6 5.2 0 2.5-1 7.2-4.3 7.2-1.2 0-2.2-.9-1.9-2.1.4-1.4 1.1-2.9 1.1-4 0-.9-.5-1.7-1.5-1.7-1.2 0-2.1 1.2-2.1 2.8 0 1 .3 1.7.3 1.7s-1.2 5-1.4 5.9c-.4 1.7-.1 3.8 0 4 .1.1.2.1.3 0 .1-.2 1.8-2.2 2.4-3.8.2-.5.9-3.4.9-3.4.5.9 1.8 1.6 3.2 1.6 4.2 0 7-3.8 7-8.9C21.3 5.4 18 2 12.1 2Z"/>
  </svg>
{%- endcapture -%}

<section
  id="{{ section_id }}"
  class="wedding-three-image-gallery"
  data-section-id="{{ section.id }}"
  data-section-type="wedding-three-image-gallery"
>
  <div class="wedding-three-image-gallery__inner">
    <div class="wedding-three-image-gallery__layout">
      {%- for image_index in (1..3) -%}
        {%- liquid
          assign image_setting = 'image_' | append: image_index
          assign pin_description_setting = 'image_' | append: image_index | append: '_pin_description'
          assign image = section.settings[image_setting]
          assign pin_description = section.settings[pin_description_setting] | default: section.settings.pin_description
          assign item_class = 'wedding-three-image-gallery__item--one'

          if image_index == 2
            assign item_class = 'wedding-three-image-gallery__item--two'
          elsif image_index == 3
            assign item_class = 'wedding-three-image-gallery__item--three'
          endif
        -%}

        <div class="wedding-three-image-gallery__item {{ item_class }}">
          <div class="wedding-three-image-gallery__image-frame">
            {%- if image != blank -%}
              {%- liquid
                assign pin_media = image | image_url: width: 1400 | prepend: 'https:'
                assign page_url = current_page_url | url_encode
                assign media_url = pin_media | url_encode
                assign description_url = pin_description | url_encode
                assign pin_url = 'https://www.pinterest.com/pin/create/button/?url=' | append: page_url | append: '&media=' | append: media_url | append: '&description=' | append: description_url
                assign image_sizes = '(min-width: 750px) 34vw, 80vw'

                if image_index == 1
                  assign image_sizes = '100vw'
                endif
              -%}

              {{
                image
                | image_url: width: 1400
                | image_tag:
                  class: 'wedding-three-image-gallery__image',
                  loading: 'lazy',
                  sizes: image_sizes,
                  widths: '375, 550, 750, 950, 1100, 1400'
              }}

              {%- if section.settings.enable_pinterest -%}
                <a class="wedding-three-image-gallery__pin" href="{{ pin_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.pin_label | escape }}">
                  {{ pinterest_icon }}
                  <span class="wedding-three-image-gallery__pin-text">{{ section.settings.pin_label | escape }}</span>
                </a>
              {%- endif -%}
            {%- else -%}
              <div class="wedding-three-image-gallery__placeholder">
                Add image {{ image_index }} in the Theme Editor.
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
