<!-- sections/brand-statement.liquid -->

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign frame_enabled = section.settings.frame-enabled
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign text_alignment = section.settings.text-alignment
  assign text_color = section.settings.text-color
  assign text_width = section.settings.text-width
-%}

<div
  class="brand-statement--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-frame-enabled="{{ frame_enabled }}"
  data-text-color="{{ text_color }}"
>
  <div class="brand-statement--wrapper">
    {%- if frame_enabled -%}
      <div class="brand-statement--border" data-mq="medium-large">
        {%- render 'icons', icon: 'text-border' -%}
      </div>
    {%- endif -%}

    {%-
      render 'section-blocks',
      section_id: section.id,
      blocks: section.blocks,
      mobile_x_alignment: mobile_text_alignment,
      text_color: text_color,
      text_width: text_width,
      x_alignment: text_alignment
    -%}
  </div>
</div>

{% stylesheet %}
  .brand-statement--root {
    @media (min-width: 768px) {
      --frame-aspect-ratio: calc(1236 / 735);
      padding: 120px;

      &:before {
        content: '';
        display: block;
        width: 0;
        height: 0;
        padding-top: calc(100% / var(--frame-aspect-ratio));
      }

      .section-blocks--wrapper {
        --text-padding: var(--spacing--section--x);
      }
    }

    @media (max-width: 767px) {
      padding: var(--spacing--8) var(--spacing--item);
    }
  }

  .brand-statement--wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-statement--border {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}

