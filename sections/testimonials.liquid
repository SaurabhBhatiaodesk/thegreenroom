{%- liquid
  assign aspect_ratio = section.settings.image-shape
  assign bg_color = section.settings.background-color
  assign custom_colors_enabled = section.settings.enable-custom-colors
  assign custom_background_color = section.settings.custom-background-color
  assign default_icon_color = section.settings.default-icon-color
  assign font_color = section.settings.font-color
  assign border = section.settings.border
  assign button_link = section.settings.button-link
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign container_width = section.settings.container-width
  assign columns = section.settings.width
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign show_quote_icon = section.settings.show-quote-icon
  assign author_position = section.settings.author-position
  assign mobile_columns = section.settings.mobile-width
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_media_layout = section.settings.mobile-media-layout
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign outer_background = section.settings.outer-background
  assign overline = section.settings.overline
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_alignment = section.settings.text-alignment
  assign text_bg_color = section.settings.text-background-color
  assign text_color = section.settings.text-color

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif
-%}

{%- for block in section.blocks -%}
  {%- capture block_html -%}
    {%- liquid
      echo block_html

      assign author_name = block.settings.author-name
      assign author_role = block.settings.author-role
      assign description = block.settings.description
      assign icon = block.settings.icon
      assign image = block.settings.image
      assign link = block.settings.link

      assign tag = 'div'
      unless link == blank
        assign tag = 'a'
      endunless
    -%}

    <div
      class="testimonials--block"
      data-container="block"
      data-x-alignment="{{ text_alignment }}"
      data-mobile-x-alignment="{{ mobile_text_alignment }}"
      {% unless settings.transitions--other %}
        data-transition-item="{{ section.id }}"
      {% endunless %}
      {{ block.shopify_attributes }}
    >
      {%- if image -%}
        <{{ tag }}
          {% unless link == blank %}
            href="{{ link }}"
          {% endunless %}
          class="testimonials--image"
        >

        {{-
          image |
          image_url: width: image.width |
          image_tag:
            widths: '200, 300, 400, 500, 600, 700, 800, 900, 1000, 1200',
            sizes: '160px',
            loading: loading
        -}}

        </{{ tag }}>
      {%- endif -%}

      {%- if icon != 'none' and icon != 'quote' or icon == 'quote' and show_quote_icon -%}
        <div
          class="testimonials--icon"
          {% if custom_colors_enabled %}
            style="color: {{ default_icon_color }};"
          {% endif %}
        >
          {%- liquid
            if icon == 'quote'
              render 'icons', icon: 'quote'

            elsif icon != 'none'
              assign rating = icon | divided_by: 2 | floor
              assign rating_modulo = icon | modulo: 2

              for i in (1..rating)
                render 'icons', icon: 'star-fill'
              endfor

              if rating_modulo == 1
                render 'icons', icon: 'star-half-fill'
              endif
            endif
          -%}
        </div>
      {%- endif -%}

      {%- unless author_role == blank and author_name == blank and description == blank -%}
        <div
          class="testimonials--info"
          data-container="block"
          {% if custom_colors_enabled %}
            style="color: {{ font_color }};"
          {% endif %}
          {% unless text_bg_color == bg_color or text_bg_color == 'transparent' %}
            data-background-color="{{ text_bg_color }}"
          {% endunless %}
        >
          {%- capture testimonial_author -%}
            {%- unless author_role == blank -%}
              <p
                class="testimonials--role"
                data-item="overline"
                {% if custom_colors_enabled %}
                  style="color: {{ font_color }};"
                {% endif %}
              >
                {{- author_role | escape -}}
              </p>
            {%- endunless -%}

            {%- unless author_name == blank -%}
              <p
                class="testimonials--name"
                data-item="block-heading"
                {% if custom_colors_enabled %}
                  style="color: {{ font_color }};"
                {% endif %}
              >
                {{- author_name | escape -}}
              </p>
            {%- endunless -%}
          {%- endcapture -%}

          {%- if author_position == 'top' -%}
            {{- testimonial_author -}}
          {%- endif -%}

          {%- unless description == blank -%}
            <div
              class="testimonials--description"
              data-item="paragraph"
              {% if custom_colors_enabled %}
                style="color: {{ font_color }};"
              {% endif %}
            >
              {{- description -}}
            </div>
          {%- endunless -%}

          {%- if author_position == 'bottom' -%}
            {{- testimonial_author -}}
          {%- endif -%}
        </div>
      {%- endunless -%}
    </div>{%- unless forloop.last -%}<span class="divider"></span>{%- endunless -%}
  {%- endcapture -%}
{%- endfor -%}

{%- liquid
  assign block_html_arr = block_html | split: '<span class="divider"></span>'
  assign total_slides = block_html_arr.size | divided_by: mobile_columns
-%}

{%- if custom_colors_enabled -%}
  <style>
    #testimonials-{{ section.id }} {
      background-color: {{ custom_background_color }} !important;
      color: {{ font_color }} !important;
    }

    #testimonials-{{ section.id }},
    #testimonials-{{ section.id }} [data-container],
    #testimonials-{{ section.id }} .testimonials--wrapper {
      --color--body: {{ font_color }};
      --color--body--rgb: {{ font_color.red }}, {{ font_color.green }}, {{ font_color.blue }};
      --color--bg: {{ custom_background_color }};
      --color--bg--rgb: {{ custom_background_color.red }}, {{ custom_background_color.green }}, {{ custom_background_color.blue }};
      background-color: {{ custom_background_color }} !important;
    }

    #testimonials-{{ section.id }} .testimonials--wrapper,
    #testimonials-{{ section.id }} .testimonials--header-nav,
    #testimonials-{{ section.id }} .testimonials--body,
    #testimonials-{{ section.id }} .testimonials--block,
    #testimonials-{{ section.id }} .testimonials--info {
      color: {{ font_color }} !important;
    }

    #testimonials-{{ section.id }} .testimonials--overline,
    #testimonials-{{ section.id }} .testimonials--heading,
    #testimonials-{{ section.id }} .testimonials--overline *,
    #testimonials-{{ section.id }} .testimonials--heading *,
    #testimonials-{{ section.id }} .testimonials--role,
    #testimonials-{{ section.id }} .testimonials--name,
    #testimonials-{{ section.id }} .testimonials--description,
    #testimonials-{{ section.id }} .testimonials--description *,
    #testimonials-{{ section.id }} .testimonials--info,
    #testimonials-{{ section.id }} .testimonials--info [data-item],
    #testimonials-{{ section.id }} [data-item],
    #testimonials-{{ section.id }} p,
    #testimonials-{{ section.id }} h1,
    #testimonials-{{ section.id }} h2,
    #testimonials-{{ section.id }} h3,
    #testimonials-{{ section.id }} h4,
    #testimonials-{{ section.id }} h5,
    #testimonials-{{ section.id }} h6,
    #testimonials-{{ section.id }} a,
    #testimonials-{{ section.id }} .testimonials--footer,
    #testimonials-{{ section.id }} .testimonials--footer a {
      color: {{ font_color }} !important;
    }

    #testimonials-{{ section.id }} .testimonials--icon,
    #testimonials-{{ section.id }} .testimonials--icon svg,
    #testimonials-{{ section.id }} .testimonials--icon svg * {
      color: {{ default_icon_color }} !important;
      fill: currentColor !important;
      stroke: currentColor !important;
    }

    #testimonials-{{ section.id }} .testimonials--icon path,
    #testimonials-{{ section.id }} .testimonials--icon polygon,
    #testimonials-{{ section.id }} .testimonials--icon circle,
    #testimonials-{{ section.id }} .testimonials--icon rect {
      fill: {{ default_icon_color }} !important;
      stroke: {{ default_icon_color }} !important;
    }
  </style>
{%- endif -%}

<style>
  #testimonials-{{ section.id }},
  #testimonials-{{ section.id }} * {
    font-family: "Bookmania", serif !important;
  }

  #testimonials-{{ section.id }} .testimonials--heading,
  #testimonials-{{ section.id }} .testimonials--heading h3,
  #testimonials-{{ section.id }} .testimonials--heading [data-item],
  #testimonials-{{ section.id }} [data-item="banner-heading"],
  #testimonials-{{ section.id }} [data-item="featured-heading"],
  #testimonials-{{ section.id }} [data-item="section-heading"],
  #testimonials-{{ section.id }} [data-item="block-heading"] {
    font-family: "Bookmania", serif !important;
    font-style: normal !important;
    font-synthesis: none !important;
  }

  /* Match the wedding sections' typography and spacing. */
  #testimonials-{{ section.id }} .testimonials--overline p {
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #testimonials-{{ section.id }} .testimonials--heading h3 {
    margin: 0;
    font-size: clamp(40px, 3.4vw, 52px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  {% unless overline == blank and heading == blank %}
    #testimonials-{{ section.id }} .testimonials--header-nav {
      margin-bottom: 88px;
    }
  {% endunless %}

  #testimonials-{{ section.id }} .testimonials--image + .testimonials--info,
  #testimonials-{{ section.id }} .testimonials--icon + .testimonials--info {
    margin-top: 24px;
  }

  #testimonials-{{ section.id }} .testimonials--role {
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #testimonials-{{ section.id }} .testimonials--name {
    margin: 0;
    font-size: clamp(28px, 2.3vw, 34px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: 0.09em;
  }

  #testimonials-{{ section.id }} .testimonials--description,
  #testimonials-{{ section.id }} .testimonials--description p {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.48;
  }

  #testimonials-{{ section.id }} .testimonials--name + .testimonials--description,
  #testimonials-{{ section.id }} .testimonials--role + .testimonials--description {
    margin-top: 22px;
  }

  #testimonials-{{ section.id }} .testimonials--description > * + *,
  #testimonials-{{ section.id }} .testimonials--description p + p,
  #testimonials-{{ section.id }} .testimonials--description + .testimonials--role,
  #testimonials-{{ section.id }} .testimonials--description + .testimonials--name {
    margin-top: 22px !important;
  }

  #testimonials-{{ section.id }} .testimonials--description + .testimonials--role + .testimonials--name {
    margin-top: 8px !important;
  }

  #testimonials-{{ section.id }} .testimonials--footer {
    margin-top: 60px;
  }

  #testimonials-{{ section.id }} .testimonials--button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    padding: 22px 50px;
    border: 1px solid {% if custom_colors_enabled %}{{ font_color }}{% else %}currentColor{% endif %};
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: {% if custom_colors_enabled %}{{ font_color }}{% else %}inherit{% endif %};
    font-size: 21px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  #testimonials-{{ section.id }} .testimonials--button span {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  {% if custom_colors_enabled %}
    #testimonials-{{ section.id }} .testimonials--button:hover,
    #testimonials-{{ section.id }} .testimonials--button:focus-visible {
      background: {{ font_color }};
      color: {{ custom_background_color }} !important;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #testimonials-{{ section.id }} .testimonials--overline p,
    #testimonials-{{ section.id }} .testimonials--role {
      font-size: 10px;
    }

    #testimonials-{{ section.id }} .testimonials--heading h3 {
      font-size: clamp(30px, 7.2vw, 38px);
    }

    {% unless overline == blank and heading == blank %}
      #testimonials-{{ section.id }} .testimonials--header-nav {
        margin-bottom: 64px;
      }
    {% endunless %}

    #testimonials-{{ section.id }} .testimonials--name {
      font-size: clamp(22px, 5.5vw, 27px);
    }

    #testimonials-{{ section.id }} .testimonials--description,
    #testimonials-{{ section.id }} .testimonials--description p {
      font-size: 18px;
      line-height: 1.5;
    }

    #testimonials-{{ section.id }} .testimonials--footer {
      margin-top: 48px;
    }

    #testimonials-{{ section.id }} .testimonials--button {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #testimonials-{{ section.id }} .testimonials--button {
      transition: none;
    }
  }
</style>

<div
  id="testimonials-{{ section.id }}"
  class="testimonials--root"
  data-section-id="{{ section.id }}"
  data-aspect-ratio="{{ aspect_ratio }}"
  data-background-color="{% if custom_colors_enabled %}none{% else %}{{ bg_color }}{% endif %}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-outer-background="{{ outer_background }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{% if custom_colors_enabled %}body{% else %}{{ text_color }}{% endif %}"
  {% if custom_colors_enabled %}
    style="background-color: {{ custom_background_color }}; color: {{ font_color }};"
  {% endif %}
>
  <div
    class="testimonials--wrapper"
    data-container="section"
    {% unless settings.transitions--other %}
      data-transition-container="{{ section.id }}"
      data-transition-type="fade-in"
      data-transition-cascade="horizontal"
      data-transition-cascade-interval="200"
    {% endunless %}
  >
    <div
      class="testimonials--header-nav"
      data-container="nav"
      data-x-alignment="{{ section_alignment }}"
      data-mobile-x-alignment="{{ mobile_heading_alignment }}"
    >
      <div
        class="testimonials--header"
        data-container="block"
        {% unless settings.transitions--text %}
          data-transition-container="{{ section.id }}-header"
          data-transition-type="slide-in"
          data-transition-cascade="vertical"
          data-transition-cascade-interval="500"
        {% endunless %}
      >
        {%- unless overline == blank and heading == blank -%}
          {%- unless overline == blank -%}
            <div
              class="testimonials--overline"
              {% unless settings.transitions--text %}
                data-transition-item="{{ section.id }}-header"
              {% endunless %}
            >
              <p
                data-item="overline"
                {% if custom_colors_enabled %}
                  style="color: {{ font_color }};"
                {% endif %}
              >
                {{- overline | escape -}}
              </p>
            </div>
          {%- endunless -%}

          {%- unless heading == blank -%}
            <div
              class="testimonials--heading"
              {% unless settings.transitions--text %}
                data-transition-item="{{ section.id }}-header"
              {% endunless %}
            >
              <h3
                data-item="{{ heading_type }}"
                {% if custom_colors_enabled %}
                  style="color: {{ font_color }};"
                {% endif %}
              >
                {{- heading | escape -}}
              </h3>
            </div>
          {%- endunless -%}
        {%- endunless -%}
      </div>

      {%- liquid
        if mobile_media_layout == 'slideshow'
          assign blocks_per_slide_mobile = mobile_columns | plus: 0.0
          assign total_slides_mobile = block_html_arr.size | divided_by: blocks_per_slide_mobile | ceil
          render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile
        endif
      -%}
    </div>

    {%- if mobile_media_layout == 'grid' -%}
      <div
        class="testimonials--body"
        data-container="panel"
        data-columns="{{ columns }}"
        data-fixed-columns="true"
        data-mobile-columns="{{ mobile_columns }}"
        data-x-alignment="{{ text_alignment }}"
      >
        {%- liquid
          for block_html in block_html_arr
            echo block_html
          endfor
        -%}
      </div>
    {%- else -%}
      {%-
        render 'carousel',
        section: section,
        blocks: block_html_arr,
        blocks_per_slide: columns,
        blocks_per_slide_mobile: mobile_columns,
        mobile_only: true,
        mobile_next_visible: false,
        spacing_around_blocks: true,
        total_blocks: block_html_arr.size,
        total_slides: total_slides
      -%}
    {%- endif -%}

    {%- unless button_text == blank -%}
      <div
        class="testimonials--footer"
        data-container="block"
        data-x-alignment="{{ section_alignment }}"
      >
        <a
          class="testimonials--button"
          href="{{ button_link }}"
          data-item="{{ button_style }}"
          data-text="{{ button_text }}"
          {% if custom_colors_enabled %}
            style="color: {{ font_color }};"
          {% endif %}
        >
          <span>{{ button_text }}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</div>

{% stylesheet %}
  .testimonials--header-nav[data-x-alignment='left'],
  .testimonials--header-nav[data-x-alignment='left'] .testimonials--header,
  .testimonials--block[data-x-alignment='left'],
  .testimonials--block[data-x-alignment='left'] .testimonials--info {
    text-align: left;
  }

  .testimonials--header-nav[data-x-alignment='center'],
  .testimonials--header-nav[data-x-alignment='center'] .testimonials--header,
  .testimonials--block[data-x-alignment='center'],
  .testimonials--block[data-x-alignment='center'] .testimonials--info {
    text-align: center;
  }

  .testimonials--header-nav[data-x-alignment='right'],
  .testimonials--header-nav[data-x-alignment='right'] .testimonials--header,
  .testimonials--block[data-x-alignment='right'],
  .testimonials--block[data-x-alignment='right'] .testimonials--info {
    text-align: right;
  }

  @media (max-width: 767px) {
    .testimonials--header-nav[data-mobile-x-alignment='left'],
    .testimonials--header-nav[data-mobile-x-alignment='left'] .testimonials--header,
    .testimonials--block[data-mobile-x-alignment='left'],
    .testimonials--block[data-mobile-x-alignment='left'] .testimonials--info {
      text-align: left;
    }

    .testimonials--header-nav[data-mobile-x-alignment='center'],
    .testimonials--header-nav[data-mobile-x-alignment='center'] .testimonials--header,
    .testimonials--block[data-mobile-x-alignment='center'],
    .testimonials--block[data-mobile-x-alignment='center'] .testimonials--info {
      text-align: center;
    }

    .testimonials--header-nav[data-mobile-x-alignment='right'],
    .testimonials--header-nav[data-mobile-x-alignment='right'] .testimonials--header,
    .testimonials--block[data-mobile-x-alignment='right'],
    .testimonials--block[data-mobile-x-alignment='right'] .testimonials--info {
      text-align: right;
    }
  }

  .testimonials--body {
    width: 100%;

    @media (min-width: 768px) {
      margin: 0 auto;
    }

    @media (max-width: 767px) {
      &[data-mobile-columns='2'] > *:nth-child(2n + 1):last-child {
        grid-column: 1 / span 2;
        justify-self: center;
        /* var(--spacing--3) is the grid gap */
        width: calc((100% - var(--spacing--3)) / 2);
      }
    }
  }

  .testimonials--image {
    width: 100%;
    max-width: 160px;
    margin: 0 auto;

    .testimonials--root[data-aspect-ratio='circle'] & img {
      aspect-ratio: 1;
      border-radius: 50%;
    }
  }

  .testimonials--icon {
    display: flex;
    justify-content: center;
    gap: var(--spacing--0);

    .icon--root[class*='star'] {
      max-width: 20px;
      max-height: 20px;
    }
  }

  .testimonials--name {
    text-transform: none !important;
  }

  .testimonials--description + .testimonials--role,
  .testimonials--description + .testimonials--name,
  .testimonials--description + .testimonials--role + .testimonials--name {
    margin-top: 1.5rem !important;
  }

  .testimonials--description + .testimonials--role + .testimonials--name {
    margin-top: 0.35rem !important;
  }

  .testimonials--description > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .testimonials--description > * + * {
    margin-top: 1.25em !important;
  }

  .testimonials--description p + p {
    margin-top: 1.25em !important;
  }

  .testimonials--info[data-background-color] {
    padding: var(--spacing--item);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "class": "section--testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "id": "overline",
      "label": "Overline",
      "type": "text",
      "default": "Overline text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimonials"
    },
    {
      "id": "button-text",
      "label": "Button text",
      "type": "text",
      "default": "Button"
    },
    {
      "id": "button-link",
      "label": "Button link",
      "type": "url"
    },
    {
      "id": "button-style",
      "label": "Button style",
      "type": "select",
      "options": [
        {
          "label": "Style 1",
          "value": "button-1"
        },
        {
          "label": "Style 2",
          "value": "button-2"
        },
        {
          "label": "Style 3",
          "value": "button-3"
        },
        {
          "label": "Style 4",
          "value": "button-4"
        },
        {
          "label": "Link",
          "value": "block-link"
        }
      ],
      "default": "button-1"
    },
    {
      "type": "header",
      "content": "General layout"
    },
    {
      "id": "border",
      "label": "Border",
      "type": "select",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "default": "none"
    },
    {
      "id": "spacing-above",
      "label": "Spacing above",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
