<!-- sections/featured-text.liquid -->

{%- liquid
  assign bg_color = section.settings.background-color
  assign custom_background_color = section.settings.custom-background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign outer_background = section.settings.outer-background
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_alignment = section.settings.text-alignment
  assign text_color = section.settings.text-color
  assign custom_text_color = section.settings.custom-text-color
  assign wedding_button_style = section.settings.wedding-button-style
  assign wedding_button_background_color = section.settings.wedding-button-background-color
  assign wedding_button_text_color = section.settings.wedding-button-text-color
  assign wedding_button_hover_background_color = section.settings.wedding-button-hover-background-color
  assign wedding_button_hover_text_color = section.settings.wedding-button-hover-text-color
-%}

<style>
    {%- if wedding_button_style -%}
    #shopify-section-{{ section.id }} .featured-text--wrapper,
    #shopify-section-{{ section.id }} .featured-text--wrapper * {
      font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif !important;
    }

    #shopify-section-{{ section.id }} .featured-text--wrapper h1,
    #shopify-section-{{ section.id }} .featured-text--wrapper h2,
    #shopify-section-{{ section.id }} .featured-text--wrapper h3,
    #shopify-section-{{ section.id }} .featured-text--wrapper h4,
    #shopify-section-{{ section.id }} .featured-text--wrapper h5,
    #shopify-section-{{ section.id }} .featured-text--wrapper h6,
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item*="heading"] {
      font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif !important;
      font-weight: 400 !important;
    }

    #shopify-section-{{ section.id }} .featured-text--wrapper h1 *,
    #shopify-section-{{ section.id }} .featured-text--wrapper h2 *,
    #shopify-section-{{ section.id }} .featured-text--wrapper h3 *,
    #shopify-section-{{ section.id }} .featured-text--wrapper h4 *,
    #shopify-section-{{ section.id }} .featured-text--wrapper h5 *,
    #shopify-section-{{ section.id }} .featured-text--wrapper h6 *,
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item*="heading"] * {
      font-family: inherit !important;
      font-weight: inherit !important;
    }

    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="overline"],
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="overline"] *,
    #shopify-section-{{ section.id }} .featured-text--wrapper .overline,
    #shopify-section-{{ section.id }} .featured-text--wrapper .overline * {
      font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif !important;
      font-weight: 400 !important;
    }

    #shopify-section-{{ section.id }} .featured-text--wrapper p,
    #shopify-section-{{ section.id }} .featured-text--wrapper li,
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="paragraph"],
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="rte"] {
      font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
      font-weight: 400 !important;
    }

    #shopify-section-{{ section.id }} .featured-text--wrapper p *,
    #shopify-section-{{ section.id }} .featured-text--wrapper li *,
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="paragraph"] *,
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="rte"] * {
      font-family: inherit !important;
    }

    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="paragraph"],
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="paragraph"] *,
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="rte"],
    #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="rte"] *,
    #shopify-section-{{ section.id }} .featured-text--wrapper .rte,
    #shopify-section-{{ section.id }} .featured-text--wrapper .rte * {
      font-size: 22px !important;
      line-height: 1.48 !important;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="paragraph"],
      #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="paragraph"] *,
      #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="rte"],
      #shopify-section-{{ section.id }} .featured-text--wrapper [data-item="rte"] *,
      #shopify-section-{{ section.id }} .featured-text--wrapper .rte,
      #shopify-section-{{ section.id }} .featured-text--wrapper .rte * {
        font-size: 18px !important;
        line-height: 1.5 !important;
      }
    }
    {%- endif -%}

    {%- if custom_background_color != blank -%}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .featured-text--root {
        background-color: {{ custom_background_color }} !important;
      }
    {%- endif -%}

    {%- if custom_text_color != blank -%}
      #shopify-section-{{ section.id }} .featured-text--wrapper,
      #shopify-section-{{ section.id }} .featured-text--wrapper * {
        color: {{ custom_text_color }} !important;
      }
    {%- endif -%}

    {%- if wedding_button_style -%}
      #shopify-section-{{ section.id }} .featured-text--wrapper h1,
      #shopify-section-{{ section.id }} .featured-text--wrapper h2,
      #shopify-section-{{ section.id }} .featured-text--wrapper h3,
      #shopify-section-{{ section.id }} .featured-text--wrapper h4,
      #shopify-section-{{ section.id }} .featured-text--wrapper h5,
      #shopify-section-{{ section.id }} .featured-text--wrapper h6,
      #shopify-section-{{ section.id }} .featured-text--wrapper [data-item*="heading"] {
        font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
        font-weight: 400 !important;
        text-transform: uppercase !important;
      }

      #shopify-section-{{ section.id }} .featured-text--wrapper h1 *,
      #shopify-section-{{ section.id }} .featured-text--wrapper h2 *,
      #shopify-section-{{ section.id }} .featured-text--wrapper h3 *,
      #shopify-section-{{ section.id }} .featured-text--wrapper h4 *,
      #shopify-section-{{ section.id }} .featured-text--wrapper h5 *,
      #shopify-section-{{ section.id }} .featured-text--wrapper h6 *,
      #shopify-section-{{ section.id }} .featured-text--wrapper [data-item*="heading"] * {
        font-family: inherit !important;
        font-weight: inherit !important;
        text-transform: inherit !important;
      }

      #shopify-section-{{ section.id }} .featured-text--wrapper a,
      #shopify-section-{{ section.id }} .featured-text--wrapper button,
      #shopify-section-{{ section.id }} .featured-text--wrapper a[data-item="button"],
      #shopify-section-{{ section.id }} .featured-text--wrapper button[data-item="button"],
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root {
        all: unset !important;
        font-family: 'Bookmania', Georgia, 'Times New Roman', serif !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: auto !important;
        max-width: none !important;
        box-sizing: border-box !important;
        margin-top: 60px !important;
        height: auto !important;
        min-height: 72px !important;
        padding: 22px 50px !important;
        border: 1px solid {{ wedding_button_text_color }} !important;
        border-radius: 0 !important;
        color: {{ wedding_button_text_color }} !important;
        background: {{ wedding_button_background_color }} !important;
        background-image: none !important;
        box-shadow: none !important;
        text-decoration: none !important;
        text-align: center !important;
        cursor: pointer !important;
        opacity: 1 !important;
        transform: none !important;
        font-size: 21px !important;
        line-height: 1.3 !important;
        letter-spacing: 0.08em !important;
        text-transform: uppercase !important;
        transition: background-color 160ms ease, color 160ms ease !important;
      }

      #shopify-section-{{ section.id }} .featured-text--wrapper a::before,
      #shopify-section-{{ section.id }} .featured-text--wrapper a::after,
      #shopify-section-{{ section.id }} .featured-text--wrapper button::before,
      #shopify-section-{{ section.id }} .featured-text--wrapper button::after,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root::before,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root::after {
        content: none !important;
        display: none !important;
      }

      #shopify-section-{{ section.id }} .featured-text--wrapper a *,
      #shopify-section-{{ section.id }} .featured-text--wrapper button *,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root * {
        font: inherit !important;
        line-height: inherit !important;
        letter-spacing: inherit !important;
        text-transform: inherit !important;
        color: {{ wedding_button_text_color }} !important;
        background: transparent !important;
        border: 0 !important;
        box-shadow: none !important;
      }

      #shopify-section-{{ section.id }} .featured-text--wrapper a:hover,
      #shopify-section-{{ section.id }} .featured-text--wrapper a:focus-visible,
      #shopify-section-{{ section.id }} .featured-text--wrapper button:hover,
      #shopify-section-{{ section.id }} .featured-text--wrapper button:focus-visible,
      #shopify-section-{{ section.id }} .featured-text--wrapper button[data-item="button"]:hover,
      #shopify-section-{{ section.id }} .featured-text--wrapper button[data-item="button"]:focus-visible,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root:hover,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root:focus-visible {
        border-color: {{ wedding_button_hover_background_color }} !important;
        background: {{ wedding_button_hover_background_color }} !important;
        color: {{ wedding_button_hover_text_color }} !important;
      }

      #shopify-section-{{ section.id }} .featured-text--wrapper a:hover *,
      #shopify-section-{{ section.id }} .featured-text--wrapper a:focus-visible *,
      #shopify-section-{{ section.id }} .featured-text--wrapper button:hover *,
      #shopify-section-{{ section.id }} .featured-text--wrapper button:focus-visible *,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root:hover *,
      #shopify-section-{{ section.id }} .featured-text--wrapper .button--root:focus-visible * {
        color: {{ wedding_button_hover_text_color }} !important;
      }

      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .featured-text--wrapper a,
        #shopify-section-{{ section.id }} .featured-text--wrapper button,
        #shopify-section-{{ section.id }} .featured-text--wrapper a[data-item="button"],
        #shopify-section-{{ section.id }} .featured-text--wrapper button[data-item="button"],
        #shopify-section-{{ section.id }} .featured-text--wrapper .button--root {
          max-width: 100% !important;
          margin-top: 48px !important;
          font-size: 17px !important;
        }
      }
    {%- endif -%}
</style>

<div
  class="featured-text--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-outer-background="{{ outer_background }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  <div class="featured-text--wrapper">
    {%-
      render 'section-blocks',
      section_index: section.index,
      section_id: section.id,
      blocks: section.blocks,
      mobile_x_alignment: mobile_text_alignment,
      text_color: text_color,
      x_alignment: text_alignment
    -%}
  </div>
</div>

