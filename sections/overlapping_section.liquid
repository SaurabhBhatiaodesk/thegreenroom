<style>
  {% for block in section.blocks %}
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h1,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h1 *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h2,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h2 *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h3,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h3 *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h4,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h4 * {
    color: {{ block.settings.title_color }} !important;
  }

  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h5,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h5 *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h6,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} h6 *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} p,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} p *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} ul,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} ul *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} ol,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} ol *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} li,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} li *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} span,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} span *,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} strong,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} em,
  .mh_text_with_background_h3 .section_wrapper_h3 .text_color_{{ block.id }} a {
    color: {{ block.settings.text_color }} !important;
  }
  {% endfor %}

  .sticky_block-overlapping {
    position: relative;
    isolation: isolate;
  }

  .sticky_block-overlapping .stack_item_h3 {
    position: relative;
    width: 100%;
    --stack-space: 0px;
  }

  .sticky_block-overlapping .stack_card_h3 {
    position: sticky;
    top: 0;
    min-height: 100vh;
  }

  .sticky_block-overlapping .stack_spacer_h3 {
    height: var(--stack-space);
  }

  .mh_text_with_background_h3 {
    position: relative;
    width: 100%;
  }

  .mh_text_with_background_h3 .panel_inner_h3 {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: inherit;
    overflow: hidden;
  }

  .mh_text_with_background_h3 .page-width {
    position: relative;
    z-index: 3;
    width: 100%;
    flex: 1 0 auto;
    display: flex;
    align-items: flex-start;
  }

  .mh_text_with_background_h3 .section_wrapper_h3 {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
    padding-left: 32px;
    padding-right: 32px;
    box-sizing: border-box;
  }

  .mh_text_with_background_h3 .content_measure_h3 {
    max-width: 900px;
    margin: 0 auto;
  }

  .mh_text_with_background_h3 .text_h3 {
    position: relative;
    z-index: 3;
    text-align: center;
  }

  .mh_text_with_background_h3 .text_h3 > *:first-child {
    margin-top: 0;
  }

  .mh_text_with_background_h3 .text_h3 > *:last-child {
    margin-bottom: 0;
  }

  .mh_text_with_background_h3 .text_h3 h1 {
    font-size: 54px;
  }

  .mh_text_with_background_h3 .text_h3 h2 {
    font-size: 42px;
  }

  .mh_text_with_background_h3 .text_h3 h3 {
    font-size: 32px;
  }

  .mh_text_with_background_h3 .text_h3 h1,
  .mh_text_with_background_h3 .text_h3 h2,
  .mh_text_with_background_h3 .text_h3 h3 {
    line-height: 1.14;
    margin-top: 0;
    margin-bottom: 28px;
  }

  .mh_text_with_background_h3 .text_h3 h4 {
    font-size: 34px;
    line-height: 1.2;
    margin-top: 0;
    margin-bottom: 22px;
  }

  .mh_text_with_background_h3 .text_h3 h5,
  .mh_text_with_background_h3 .text_h3 h6 {
    margin-top: 0;
    margin-bottom: 18px;
  }

  .mh_text_with_background_h3 .text_h3 p {
    font-size: 19px;
    line-height: 1.75;
    margin-top: 0;
    margin-bottom: 18px;
  }

  .mh_text_with_background_h3 .text_h3 ul,
  .mh_text_with_background_h3 .text_h3 ol {
    margin: 24px auto;
    padding-left: 28px;
    display: inline-block;
    text-align: left;
  }

  .mh_text_with_background_h3 .text_h3 ul {
    list-style: disc;
  }

  .mh_text_with_background_h3 .text_h3 ol {
    list-style: decimal;
  }

  .mh_text_with_background_h3 .text_h3 ul li,
  .mh_text_with_background_h3 .text_h3 ol li {
    display: list-item;
  }

  .mh_text_with_background_h3 .text_h3 li {
    font-size: 19px;
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .mh_text_with_background_h3 .image_dd {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .mh_text_with_background_h3 .background_image_h3 {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .bottom_left_{{ section.id }}_h3 {
    left: 0;
    bottom: 0;
    width: auto;
    height: auto;
    max-width: 26%;
    max-height: 42%;
    object-fit: contain;
    object-position: left bottom;
  }

  .bottom_right_{{ section.id }}_h3 {
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
    max-width: 26%;
    max-height: 42%;
    object-fit: contain;
    object-position: right bottom;
  }

  .bottom_{{ section.id }}_h3 {
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: center bottom;
  }

  .mh_text_with_background_h3 .button_h3 {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    min-width: 220px;
    min-height: 70px;
    padding: 16px 34px;
    margin: 34px auto 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .mh_text_with_background_h3 .button_h3::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--button-image);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    transition: transform 0.3s ease, filter 0.3s ease;
    transform-origin: center center;
  }

  .mh_text_with_background_h3 .button_h3:hover::before {
    transform: scale(1.08);
    filter: brightness(1.05);
  }

  .mh_text_with_background_h3 .button_h3:active::before {
    transform: scale(0.98);
  }

  .mh_text_with_background_h3 .button_h3 h4 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: inherit;
    font-size: 20px;
    line-height: 1.1;
    transition: transform 0.3s ease, filter 0.3s ease, opacity 0.3s ease;
    transform-origin: center center;
  }

  .mh_text_with_background_h3 .button_h3:hover h4 {
    transform: scale(1.08);
    filter: brightness(1.05);
    opacity: 0.98;
  }

  .mh_text_with_background_h3 .button_h3:active h4 {
    transform: scale(0.98);
  }

  .mh_text_with_background_h3 .bottom_media_h3 {
    position: relative;
    z-index: 2;
    width: 100%;
    margin-top: auto;
    flex: 0 0 auto;
  }

  .mh_text_with_background_h3 .bottom_image_d9 {
    display: block;
    width: 100%;
    height: auto;
  }

  .mh_text_with_background_h3 .mobile_dd {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .sticky_block-overlapping .stack_card_h3 {
      position: relative;
      top: auto;
      min-height: auto;
    }

    .sticky_block-overlapping .stack_spacer_h3 {
      display: none;
    }

    .sticky_block-overlapping .stack_item_h3 {
      --stack-space: 0px !important;
    }

    .mh_text_with_background_h3 .panel_inner_h3 {
      min-height: auto;
      overflow: visible;
    }

    .mh_text_with_background_h3 .page-width {
      min-height: auto;
      display: block;
    }

    .mh_text_with_background_h3 .section_wrapper_h3 {
      padding-left: 20px;
      padding-right: 20px;
    }

    .mh_text_with_background_h3 .text_h3 h1 {
      font-size: 54px;
    }

    .mh_text_with_background_h3 .text_h3 h2 {
      font-size: 32px;
    }

    .mh_text_with_background_h3 .text_h3 h3 {
      font-size: 22px;
    }

    .mh_text_with_background_h3 .text_h3 h4 {
      font-size: 26px;
      margin-bottom: 18px;
    }

    .mh_text_with_background_h3 .text_h3 p,
    .mh_text_with_background_h3 .text_h3 li {
      font-size: 16px;
      line-height: 1.65;
    }

    .mh_text_with_background_h3 .desktop_dd {
      display: none;
    }

    .mh_text_with_background_h3 .mobile_dd {
      display: block;
    }

    .bottom_left_{{ section.id }}_h3,
    .bottom_right_{{ section.id }}_h3 {
      max-width: 34%;
      max-height: 26%;
    }

    .mh_text_with_background_h3 .button_h3 {
      min-width: 180px;
      min-height: 58px;
      padding: 12px 24px;
      margin-top: 28px;
    }

    .mh_text_with_background_h3 .button_h3 h4 {
      font-size: 18px;
    }
  }
</style>

<div class="sticky_block-overlapping" id="sticky-overlapping-{{ section.id }}">
  {% for block in section.blocks %}
    <div class="stack_item_h3 mh_text_with_background_h3" style="background-color: {{ block.settings.background_color }};">
      <div class="stack_card_h3" style="z-index: {{ forloop.index }};">
        <div class="panel_inner_h3">
          {% if block.settings.background_image != blank %}
            <img
              class="image_dd background_image_h3 {% if block.settings.background_image_position == 'left' %}bottom_left_{{ section.id }}_h3{% elsif block.settings.background_image_position == 'bottom' %}bottom_{{ section.id }}_h3{% elsif block.settings.background_image_position == 'right' %}bottom_right_{{ section.id }}_h3{% endif %}"
              src="{{ block.settings.background_image | image_url: width: 2400 }}"
              alt="{{ block.settings.background_image.alt | escape }}"
              loading="eager"
            >
          {% endif %}

          <div class="page-width">
            <div
              class="section_wrapper_h3"
              style="
                padding-top: {{ block.settings.padding_top | plus: 30 }}px;
                padding-bottom: {{ block.settings.padding_bottom | plus: 80 }}px;
              "
            >
              <div class="content_measure_h3">
                {% if block.settings.text != blank %}
                  <div class="text_h3 text_color_{{ block.id }}">
                    {{ block.settings.text }}
                  </div>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <a
                    class="button_h3"
                    href="{{ block.settings.button_url }}"
                    {% if block.settings.button_url != blank %}target="_blank"{% endif %}
                    style="
                      color: {{ block.settings.button_text_color }};
                      {% if block.settings.button_image != blank %}
                        --button-image: url('{{ block.settings.button_image | image_url: width: 800 }}');
                      {% else %}
                        --button-image: none;
                        background-color: transparent;
                      {% endif %}
                    "
                  >
                    <h4>{{ block.settings.button_text }}</h4>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="bottom_media_h3">
            {% if block.settings.desktop_image != blank %}
              <img
                class="image_dd desktop_dd bottom_image_d9"
                src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
                alt="{{ block.settings.desktop_image.alt | escape }}"
                width="" height="" loading="lazy"
              >
            {% endif %}

            {% if block.settings.mobile_image != blank %}
              <img
                class="image_dd mobile_dd bottom_image_d9"
                src="{{ block.settings.mobile_image | image_url: width: 1600 }}"
                alt="{{ block.settings.mobile_image.alt | escape }}"
                width="" height="" loading="lazy"
              >
            {% endif %}
          </div>
        </div>
      </div>
      <div class="stack_spacer_h3"></div>
    </div>
  {% endfor %}
</div>

<script>
  (function() {
    var root = document.getElementById('sticky-overlapping-{{ section.id }}');
    if (!root) return;

    function setStackSpacing() {
      var items = root.querySelectorAll('.stack_item_h3');
      var isDesktop = window.innerWidth > 749;
      var viewportHeight = window.innerHeight;

      items.forEach(function(item) {
        if (!isDesktop) {
          item.style.setProperty('--stack-space', '0px');
          return;
        }

        var card = item.querySelector('.stack_card_h3');
        var cardHeight = card ? card.offsetHeight : 0;
        var spacer = cardHeight - viewportHeight;

        if (spacer < 0) spacer = 0;

        item.style.setProperty('--stack-space', spacer + 'px');
      });
    }

    window.addEventListener('load', setStackSpacing);
    window.addEventListener('resize', setStackSpacing);

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(setStackSpacing);
    }

    root.querySelectorAll('img').forEach(function(img) {
      if (img.complete) return;
      img.addEventListener('load', setStackSpacing);
    });
  })();
</script>

{% schema %}
{
  "name": "Overlapping Block",
  "settings": [],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#fcb9b9"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "select",
          "id": "background_image_position",
          "label": "Background Image Position",
          "options": [
            {
              "value": "left",
              "label": "Bottom Left"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            },
            {
              "value": "right",
              "label": "Bottom Right"
            }
          ],
          "default": "bottom"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#e27396"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button Text Color",
          "default": "#ffffff"
        },
        {
          "type": "image_picker",
          "id": "button_image",
          "label": "Button Image"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Padding Top",
          "default": 40
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Padding Bottom",
          "default": 40
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Bottom Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Bottom Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Overlapping Block"
    }
  ]
}
{% endschema %}