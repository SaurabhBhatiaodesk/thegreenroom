<!-- sections/main-article.liquid -->

{%- liquid
  assign written_by_t = 'blog.article.written_by' | t
  assign tagged_in_t = 'blog.article.tagged_in' | t
  assign share_t = 'general.social.share' | t

  assign container_width = section.settings.container-width
  assign email_enabled = section.settings.email-enabled
  assign facebook_enabled = section.settings.facebook-enabled
  assign heading_alignment = section.settings.heading-alignment
  assign heading_type = section.settings.heading-type
  assign hidden_tags = settings.hide-tags | split: ','
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign number_of_tags = 0
  assign pinterest_enabled = section.settings.pinterest-enabled
  assign show_date = section.settings.show-date
  assign show_author = section.settings.show-author
  assign show_tags = section.settings.show-tags
  assign show_title = section.settings.show-title
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign url_enabled = section.settings.url-enabled
  assign x_enabled = section.settings.x-enabled

  assign show_share = false
  if facebook_enabled or x_enabled or pinterest_enabled or email_enabled or url_enabled
    assign show_share = true
  endif
-%}

{%- capture render_tags -%}
  {%- for tag in article.tags -%}
    {%- liquid
      assign temp_tag = tag | downcase | escape
      assign skip = false

      for hidden_tag in hidden_tags
        assign formatted_hidden_tag = hidden_tag | downcase | escape | strip
        if temp_tag == formatted_hidden_tag
          assign skip = true
          break
        endif
      endfor

      if skip
        continue
      endif

      assign number_of_tags = number_of_tags | plus: 1
    -%}

    <li class="article--tag">
      <a href="{{ blog.url }}/tagged/{{ tag | handle }}">
        {{- tag | capitalize -}}
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- liquid
  if number_of_tags == 0
    assign show_tags = false
  endif
-%}

<article
  class="article--root"
  data-section-id="{{ section.id }}"
  data-background-color="none"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-show-author="{{ show_author }}"
  data-show-date="{{ show_date }}"
>
  <div class="article--wrapper" data-container="section">

    {%- if show_title or show_date or show_author -%}
      <div class="article--heading" data-container="block" data-x-alignment="{{ heading_alignment }}">
        {%- if show_title -%}
          <div class="article--header--info" data-container="block">
            <h1 class="article--title" data-item="{{ heading_type }}">
              {{- article.title -}}
            </h1>
          </div>
        {%- endif -%}

        {%- if show_date or show_author -%}
          <div class="article--info">
            {%- if show_date -%}
              <div class="article--timesince" data-item="nav-text" data-text-color="gray">
                {%- render 'utils', name: 'timesince', created_at: article.published_at -%}
              </div>
            {%- endif -%}

            {%- if show_date and show_author -%}
              <span class="article--dot">&CenterDot;</span>
            {%- endif -%}

            {%- if show_author -%}
              <div class="article--author" data-item="caption">
                {{- written_by_t }} {{ article.author -}}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if article.content.size > 0 -%}
      <div class="article--content" data-container="block" data-item="rte-content">
        {{- article.content -}}
      </div>
    {%- endif -%}

    {%- if show_share or show_tags -%}
      <div class="article--navigation">
        {%- if show_tags -%}
          <div class="article--tag-info" data-container="block">
            <p class="article--tagged-in" data-item="nav-text">
              {{- tagged_in_t -}}
            </p>

            <ul class="article--tags" data-item="paragraph">
              {{- render_tags -}}
            </ul>
          </div>
        {%- endif -%}

        {%- if show_share -%}
          <div class="article--share">
            {%- render 'social-media', type: 'share', alignment: 'right', mobile_alignment: 'right', heading: share_t, social_settings: section.settings -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</article>

{% stylesheet %}
.article--heading { width: 100%; }
.article--header--info { width: 100%; }

.article--info {
  display: flex;
  justify-content: center;
  gap: var(--spacing--1);
  align-items: center;
}

.article--navigation {
  display: flex;
  width: 100%;
  justify-content: space-between;
}

.article--tagged-in { margin: 0; }

.article--tags {
  display: inline-flex;
  flex-wrap: wrap;
  column-gap: var(--spacing--1);
  row-gap: var(--spacing--0);
  line-height: 1;
}

.article--tag a { text-decoration: underline; }

.article--content .bggle-font,
.article--content .bggle-font *,
.article--content .bggle_text p,
.article--content .bggle_text-with-image p,
.article--content .bggle_double-column p {
  color: inherit !important;
}

.article--content .bggle_double-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: flex-start;
}

.article--content .bggle_double-images img,
.article--content .bggle_image img,
.article--content .bggle_text-with-image img {
  display: block;
  width: 100%;
  height: auto;
}

.article--content .bggle_text-with-image {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
}

.article--content .bggle_text-with-image .bggle_text--container,
.article--content .bggle_text-with-image .bggle_image--container {
  flex: 1;
}

@media (max-width: 767px) {
  .article--info {
    flex-direction: column;
  }

  .article--content .bggle_double-images,
  .article--content .bggle_text-with-image {
    display: block;
  }

  .article--content .bggle_double-images .first--image,
  .article--content .bggle_double-images .second--image,
  .article--content .bggle_text-with-image .bggle_text--container,
  .article--content .bggle_text-with-image .bggle_image--container {
    width: 100% !important;
  }
  .article--content .bggle_button {
  background-color: transparent !important;
}
}
{% endstylesheet %}

