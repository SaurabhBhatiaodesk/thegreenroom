<style>
  .text_color_{{ section.id }} * {
    color: {{ section.settings.text_color }} !important;
  }

  #shopify-section-{{ section.id }} .mh_text_button_h6 {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .page-width {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  #shopify-section-{{ section.id }} .section_wrapper_h6 {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 80px;
    min-height: 420px;
    width: 100%;
    padding: 0 36px;
    box-sizing: border-box;
    position: relative;
  }

  #shopify-section-{{ section.id }} .text_wrapper_h6 {
    position: relative;
    display: inline-block;
    max-width: 900px;
    width: 100%;
    flex: 1 1 auto;
  }

  #shopify-section-{{ section.id }} .text_h6 {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .text_h6 h1,
  #shopify-section-{{ section.id }} .text_h6 h2,
  #shopify-section-{{ section.id }} .text_h6 h3,
  #shopify-section-{{ section.id }} .text_h6 h4,
  #shopify-section-{{ section.id }} .text_h6 p {
    margin: 0;
    font-family: "Holiday Journey", serif;
    font-size: clamp(90px, 11vw, 170px);
    line-height: 0.82;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .text_h6 * + * {
    margin-top: 6px;
  }

  #shopify-section-{{ section.id }} .image_h6 {
    position: absolute;
    top: 20px;
    left: 470px;
    width: 110px;
    height: auto;
    z-index: 3;
    display: block;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .button_h6 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    min-width: 210px;
    min-height: 88px;
    padding: 18px 28px;
    flex: 0 0 auto;
    margin-right: 120px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  #shopify-section-{{ section.id }} .button_h6:hover {
    transform: translateY(-3px) scale(1.03);
    opacity: 0.96;
  }

  #shopify-section-{{ section.id }} .button_h6 h4 {
    margin: 0;
    font-family: "DM Sans", sans-serif;
    font-size: 22px;
    line-height: 1.1;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .section_wrapper_h6 {
      min-height: 360px;
      padding: 0 28px;
      gap: 50px;
    }

    #shopify-section-{{ section.id }} .text_wrapper_h6 {
      max-width: 650px;
    }

    #shopify-section-{{ section.id }} .text_h6 h1,
    #shopify-section-{{ section.id }} .text_h6 h2,
    #shopify-section-{{ section.id }} .text_h6 h3,
    #shopify-section-{{ section.id }} .text_h6 h4,
    #shopify-section-{{ section.id }} .text_h6 p {
      font-size: clamp(70px, 10vw, 130px);
    }

    #shopify-section-{{ section.id }} .image_h6 {
      top: 15px;
      left: 340px;
      width: 90px;
    }

    #shopify-section-{{ section.id }} .button_h6 {
      margin-right: 60px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .section_wrapper_h6 {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      padding: 0 20px;
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .text_wrapper_h6 {
      max-width: 100%;
      flex: unset;
    }

    #shopify-section-{{ section.id }} .text_h6 h1,
    #shopify-section-{{ section.id }} .text_h6 h2,
    #shopify-section-{{ section.id }} .text_h6 h3,
    #shopify-section-{{ section.id }} .text_h6 h4,
    #shopify-section-{{ section.id }} .text_h6 p {
      font-size: clamp(60px, 18vw, 100px);
      line-height: 0.88;
    }

    #shopify-section-{{ section.id }} .image_h6 {
      top: 10px;
      left: 55%;
      width: 65px;
    }

    #shopify-section-{{ section.id }} .button_h6 {
      margin-right: 0;
      align-self: flex-end;
      min-width: 170px;
      min-height: 72px;
      padding: 14px 18px;
    }

    #shopify-section-{{ section.id }} .button_h6 h4 {
      font-size: 16px;
    }
  }
</style>

<section
  class="mh_text_button_h6"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};"
  data-aos="fade-up"
>
  <div class="page-width">
    <div class="max_width_dd section_wrapper_h6">
      {% if section.settings.text != blank %}
        <div class="text_wrapper_h6">
          <div class="text_dd text_h6 text_color_{{ section.id }}">
            {{ section.settings.text }}
          </div>

          {% if section.settings.text_image != blank %}
            <img
              class="image_dd image_h6"
              src="{{ section.settings.text_image | image_url }}"
              alt="{{ section.settings.text_image.alt | escape }}"
              width="100"
              height="100"
              loading="lazy"
            >
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          class="button_dd button_h6 background_image_dd"
          href="{{ section.settings.button_url }}"
          style="color: {{ section.settings.button_text_color }}; background-image: url('{{ section.settings.button_image | image_url }}');"
          target="_blank"
        >
          <h4>{{ section.settings.button_text }}</h4>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TIC Text Button",
  "presets": [
    {
      "name": "TIC Text Button"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#c98295"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f9f4e8"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "text_image",
      "label": "Text Image"
    },
    {
      "type": "header",
      "content": "__ Button __"
    },
    {
      "type": "image_picker",
      "id": "button_image",
      "label": "Button Image"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#c98295"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ]
}
{% endschema %}