{{ 'party-petals.css' | asset_url | stylesheet_tag }}

<section 
  class="pp-wrap"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="pp-container">
    <div class="pp-inner">

      <div 
        class="pp-gallery-block" 
        id="pp-gallery-{{ section.id }}"
        style="
          --pp-eyebrow-color: {{ section.settings.eyebrow_color }};
          --pp-heading-color: {{ section.settings.heading_color }};
          --pp-label-color: {{ section.settings.label_color }};
          --pp-label-font-size: {{ section.settings.label_font_size }}px;
          --pp-label-font-size-mobile: {{ section.settings.label_font_size_mobile }}px;
          --pp-image-bg-color: {{ section.settings.image_bg_color }};
          --pp-arrow-color: {{ section.settings.arrow_color }};
          --pp-padding-bottom: {{ section.settings.padding_bottom }}px;
          --pp-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
          --pp-padding-h: {{ section.settings.padding_horizontal }}px;
          --pp-padding-h-mobile: {{ section.settings.padding_horizontal_mobile }}px;
          --pp-card-width: {{ section.settings.card_width }}px;
          --pp-card-gap: {{ section.settings.card_gap }}px;
          --pp-card-gap-mobile: {{ section.settings.card_gap_mobile }}px;
          --pp-image-height: {{ section.settings.image_height }}px;
          --pp-card-width-mobile: {{ section.settings.card_width_mobile }}px;
          --pp-image-height-mobile: {{ section.settings.image_height_mobile }}px;
          --pp-scroll-padding-mobile: {{ section.settings.scroll_padding_mobile }}px;
        "
      >

        <div class="pp-row-head">

          <div class="pp-row-head-wr">
            <p class="pp-eyebrow">
                {{ section.settings.eyebrow | default: 'Gallery' }}
            </p>

            <h2 class="pp-section-title">
              {{ section.settings.heading | default: 'What you can expect' }}
            </h2>
          </div>


          <div class="pp-arrows">

            <div class="pp-arrow" data-pp-prev="gallery">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <polyline points="14.5,4.5 7,12 14.5,19.5"></polyline>
              </svg>
            </div>


            <div class="pp-arrow" data-pp-next="gallery">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <polyline points="9.5,4.5 17,12 9.5,19.5"></polyline>
              </svg>
            </div>

          </div>

        </div>


        <div class="pp-track pp-track--gallery" data-pp-track="gallery">

          {% for block in section.blocks %}

            {% if block.type == 'gallery_image' %}

              <div 
                class="pp-gallery-card" 
                data-pp-card="gallery" 
                {{ block.shopify_attributes }}
              >

                <div class="pp-gallery-image{% if block.settings.hover_image != blank %} has-hover-image{% endif %}">

                  {% if block.settings.image %}

                    <img 
                      class="pp-gallery-image__primary"
                      src="{{ block.settings.image | image_url: width: 900 }}" 
                      alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                      loading="lazy" 
                      width="900" 
                      height="1116"
                    >

                  {% endif %}

                  {% if block.settings.hover_image != blank %}

                    <img
                      class="pp-gallery-image__hover"
                      src="{{ block.settings.hover_image | image_url: width: 900 }}"
                      alt="{{ block.settings.hover_image.alt | default: block.settings.label | escape }}"
                      loading="lazy"
                      width="900"
                      height="1116"
                    >

                  {% endif %}

                </div>


                <span class="pp-gallery-label">
                  {{ block.settings.label }}
                </span>

              </div>

            {% endif %}

          {% endfor %}

        </div>


        <div class="pp-dots" data-pp-dots="gallery"></div>


      </div>

    </div>
  </div>
</section>


<script>
(function () {

  var root = document.getElementById('pp-gallery-{{ section.id }}');

  if (!root) return;


  var track = root.querySelector('[data-pp-track="gallery"]');
  var dotsWrap = root.querySelector('[data-pp-dots="gallery"]');
  var prev = root.querySelector('[data-pp-prev="gallery"]');
  var next = root.querySelector('[data-pp-next="gallery"]');


  if (!track || !dotsWrap) return;


  var cards = Array.from(
    track.querySelectorAll('[data-pp-card="gallery"]')
  );


  if (!cards.length) return;


  var positions = [];
  var dots = [];
  var current = 0;
  var ticking = false;
  var resizeTimer = null;


  /* =========================================
     HELPERS
  ========================================= */

  function getMaxScroll() {
    return Math.max(
      0,
      track.scrollWidth - track.clientWidth
    );
  }


  function getCardPosition(card) {

    var trackRect = track.getBoundingClientRect();
    var cardRect = card.getBoundingClientRect();

    var position =
      cardRect.left -
      trackRect.left +
      track.scrollLeft;

    var maxScroll = getMaxScroll();

    return Math.max(
      0,
      Math.min(position, maxScroll)
    );

  }


  /* =========================================
     DOT ACTIVE STATE
  ========================================= */

  function setActive(index) {

    if (!positions.length) return;


    index = Math.max(
      0,
      Math.min(index, positions.length - 1)
    );

    current = index;


    dots.forEach(function(dot, i) {

      dot.style.background =
        i === index
          ? '{{ section.settings.dot_active_color }}'
          : '{{ section.settings.dot_inactive_color }}';

      dot.classList.toggle(
        'is-active',
        i === index
      );

    });


    if (prev) {
      prev.classList.toggle(
        'is-disabled',
        current === 0
      );

      prev.setAttribute(
        'aria-disabled',
        current === 0 ? 'true' : 'false'
      );
    }


    if (next) {
      next.classList.toggle(
        'is-disabled',
        current === positions.length - 1
      );

      next.setAttribute(
        'aria-disabled',
        current === positions.length - 1
          ? 'true'
          : 'false'
      );
    }

  }


  /* =========================================
     SCROLL TO PAGINATION POSITION
  ========================================= */

  function scrollToPage(index) {

    if (!positions.length) return;


    index = Math.max(
      0,
      Math.min(index, positions.length - 1)
    );


    setActive(index);


    track.scrollTo({
      left: positions[index],
      behavior: 'smooth'
    });

  }


  /* =========================================
     CREATE REAL PAGINATION POSITIONS

     Important:
     Last cards often cannot align fully to the
     left because the slider reaches max scroll.

     So we clamp every card position to maxScroll
     and remove duplicate positions.
  ========================================= */

  function buildPagination() {

    var maxScroll = getMaxScroll();

    positions = [];


    cards.forEach(function(card) {

      var position = getCardPosition(card);


      var alreadyExists = positions.some(
        function(existingPosition) {
          return Math.abs(
            existingPosition - position
          ) < 2;
        }
      );


      if (!alreadyExists) {
        positions.push(position);
      }

    });


    if (!positions.length) {
      positions = [0];
    }


    /*
      Ensure exact start and exact end positions.
    */

    positions[0] = 0;


    if (
      maxScroll > 1 &&
      Math.abs(
        positions[positions.length - 1] -
        maxScroll
      ) > 2
    ) {
      positions.push(maxScroll);
    }


    dotsWrap.innerHTML = '';


    positions.forEach(function(position, index) {

      var dot = document.createElement('div');

      dot.className = 'pp-dot';

      dot.setAttribute(
        'role',
        'button'
      );

      dot.setAttribute(
        'tabindex',
        '0'
      );

      dot.setAttribute(
        'aria-label',
        'Go to gallery position ' + (index + 1)
      );


      dot.addEventListener(
        'click',
        function() {
          scrollToPage(index);
        }
      );


      dot.addEventListener(
        'keydown',
        function(event) {

          if (
            event.key === 'Enter' ||
            event.key === ' '
          ) {
            event.preventDefault();
            scrollToPage(index);
          }

        }
      );


      dotsWrap.appendChild(dot);

    });


    dots = Array.from(
      dotsWrap.children
    );


    /*
      Hide pagination when there is nothing
      to horizontally scroll.
    */

    dotsWrap.style.display =
      maxScroll <= 1
        ? 'none'
        : 'flex';


    updateCurrent();

  }


  /* =========================================
     UPDATE CURRENT DOT WHILE SWIPING / SCROLLING
  ========================================= */

  function updateCurrent() {

    if (!positions.length) return;


    var scrollLeft = track.scrollLeft;
    var closestIndex = 0;
    var closestDistance = Infinity;


    positions.forEach(
      function(position, index) {

        var distance = Math.abs(
          scrollLeft - position
        );


        if (distance < closestDistance) {

          closestDistance = distance;
          closestIndex = index;

        }

      }
    );


    /*
      Force the final pagination state when
      the user reaches the far right edge.
    */

    var maxScroll = getMaxScroll();

    if (
      maxScroll > 0 &&
      Math.abs(
        scrollLeft - maxScroll
      ) <= 3
    ) {
      closestIndex =
        positions.length - 1;
    }


    setActive(closestIndex);

  }


  function handleScroll() {

    if (ticking) return;


    ticking = true;


    window.requestAnimationFrame(
      function() {

        updateCurrent();

        ticking = false;

      }
    );

  }


  track.addEventListener(
    'scroll',
    handleScroll,
    { passive: true }
  );


  /* =========================================
     PREVIOUS / NEXT
  ========================================= */

  if (prev) {

    prev.addEventListener(
      'click',
      function() {

        if (current <= 0) return;

        scrollToPage(current - 1);

      }
    );

  }


  if (next) {

    next.addEventListener(
      'click',
      function() {

        if (
          current >=
          positions.length - 1
        ) {
          return;
        }

        scrollToPage(current + 1);

      }
    );

  }


  /* =========================================
     REBUILD ON RESIZE
  ========================================= */

  function handleResize() {

    window.clearTimeout(
      resizeTimer
    );


    resizeTimer =
      window.setTimeout(
        function() {

          buildPagination();

        },
        120
      );

  }


  window.addEventListener(
    'resize',
    handleResize
  );


  /* =========================================
     INITIALIZE
  ========================================= */

  window.requestAnimationFrame(
    function() {

      buildPagination();

    }
  );


  window.addEventListener(
    'load',
    function() {

      buildPagination();

    },
    { once: true }
  );


})();
</script>

<style>
    
/* =========================================================
   SECTION: party-petals-gallery.liquid
   ========================================================= */
.pp-row-head {
  padding: 0 var(--pp-padding-h, 48px);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 44px;
}
.pp-eyebrow {
  margin: 0;
  font-family: Poppins, sans-serif;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: #AACC97;
}
.pp-section-title {
  margin: 0;
  font-family: Poppins, sans-serif;
  font-weight: 700;
  font-size: 30px;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: #264A3D;
}

.pp-arrows { display: flex; gap: 10px; }
.pp-arrow {
  width: 42px;
  height: 42px;
  border-radius: 999px;
  border: 1px solid #264A3D;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #264A3D;
  transition: background 200ms ease, color 200ms ease;
}
.pp-arrow:hover { background: #264A3D; color: #FFFFF3; }

.pp-arrow.is-disabled {
  opacity: 0.35;
  pointer-events: none;
}
.pp-track {
  display: flex;
  gap: 28px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-left: var(--pp-padding-h, 48px);
  scroll-padding-right: var(--pp-padding-h, 48px);
  scrollbar-width: none;
  padding: 0 0 8px;
}
.pp-track::-webkit-scrollbar { height: 0; }
.pp-dots { padding: 34px var(--pp-padding-h, 110px) 0; display: flex; gap: 10px; }
.pp-dot {
  width: 30px;
  height: 3px;
  background: rgba(38, 74, 61, 0.22);
  cursor: pointer;
}

.pp-gallery-block { padding: 0 0 var(--pp-padding-bottom, 96px); }
.pp-track--gallery { gap: var(--pp-card-gap, 20px); scroll-padding-left: 0; scroll-padding-right: 0; }
.pp-gallery-card { flex: 0 0 var(--pp-card-width, 420px); scroll-snap-align: start; display: flex; flex-direction: column; gap: 12px; }
.pp-gallery-image {
  position: relative;
  height: var(--pp-image-height, 520px);
  background-color: var(--pp-image-bg-color, #F2F0E2);
  overflow: hidden;
}
.pp-row-head-wr {
    display: flex;
    flex-direction: column;
    gap: 20px;
}
.pp-eyebrow { color: var(--pp-eyebrow-color, inherit); }
.pp-section-title { color: var(--pp-heading-color, inherit); }
.pp-arrow { color: var(--pp-arrow-color, inherit); }
.pp-gallery-image img {
  border-radius: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pp-gallery-image__primary {
  position: relative;
  z-index: 1;
  opacity: 1;
  transition: opacity 0.35s ease, transform 0.45s ease;
}

.pp-gallery-image__hover {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  transition: opacity 0.35s ease, transform 0.45s ease;
}

/* Desktop/laptop hover only. Mobile keeps the main image. */
@media (hover: hover) and (pointer: fine) {
  .pp-gallery-image.has-hover-image:hover .pp-gallery-image__hover {
    opacity: 1;
  }

  .pp-gallery-image.has-hover-image:hover .pp-gallery-image__primary {
    opacity: 0;
  }
}
.pp-gallery-label {
  font-family: Poppins, sans-serif;
  font-weight: 500;
  font-size: var(--pp-label-font-size, 12px);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--pp-label-color, #264A3D);
}
@media (max-width: 749px) {
  .pp-track { scroll-padding-left: var(--pp-scroll-padding-mobile, 24px); scroll-padding-right: var(--pp-scroll-padding-mobile, 24px); }
  .pp-track--gallery { gap: var(--pp-card-gap-mobile, 16px); }
  .pp-gallery-card { flex-basis: var(--pp-card-width-mobile, 280px); }
  .pp-gallery-image { height: var(--pp-image-height-mobile, 360px); }
  .pp-gallery-label { font-size: var(--pp-label-font-size-mobile, 11px); }
  .pp-row-head{
        padding-left: var(--pp-padding-h-mobile, 16px);
        padding-right: var(--pp-padding-h-mobile, 16px);
        flex-wrap:wrap;
    }
    .pp-gallery-block{
        padding-bottom: var(--pp-padding-bottom-mobile, 48px);
    }
    .pp-section-title{
        line-height: 36px;
        font-size:23px;
    }
    .pp-dots {
        padding-left: var(--pp-padding-h-mobile, 24px);
        padding-right: var(--pp-padding-h-mobile, 24px);
    }
    .pp-row-head-wr{
        gap:10px;
    }
}
</style>


{% schema %}
{
  "name": "Party Petals — Gallery",

  "settings": [

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#264A3D"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#264A3D"
    },

    {
      "type": "color",
      "id": "label_color",
      "label": "Image label color",
      "default": "#264A3D"
    },

    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image placeholder background",
      "default": "#F2F0E2"
    },

    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#264A3D"
    },

    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#D37F91"
    },

    {
      "type": "color",
      "id": "dot_inactive_color",
      "label": "Inactive dot color",
      "default": "rgba(38,74,61,0.22)"
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What you can expect"
    },
    {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow text",
        "default": "Gallery"
    },

    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "label_font_size",
      "label": "Image label font size (desktop)",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "label_font_size_mobile",
      "label": "Image label font size (mobile)",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
    "type": "range",
    "id": "padding_bottom",
    "label": "Bottom padding (desktop)",
    "min": 0,
    "max": 160,
    "step": 8,
    "unit": "px",
    "default": 96
    },

    {
    "type": "range",
    "id": "padding_bottom_mobile",
    "label": "Bottom padding (mobile)",
    "min": 0,
    "max": 120,
    "step": 4,
    "unit": "px",
    "default": 48
    },

    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 110
    },

    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (desktop)",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 420
    },

    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width (mobile)",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280
    },

    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Gap between cards (mobile)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (desktop)",
      "min": 240,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 520
    },

    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height (mobile)",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },

    {
      "type": "range",
      "id": "scroll_padding_mobile",
      "label": "Scroll edge padding (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    }

  ],


  "blocks": [

    {
      "type": "gallery_image",

      "name": "Gallery image",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image"
        },

        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Wedding bouquet"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Party Petals — Gallery",

      "blocks": [

        {
          "type": "gallery_image",
          "settings": {
            "label": "Wedding bouquet"
          }
        },

        {
          "type": "gallery_image",
          "settings": {
            "label": "Bridesmaid bouquets"
          }
        },

        {
          "type": "gallery_image",
          "settings": {
            "label": "Buttonholes"
          }
        },

        {
          "type": "gallery_image",
          "settings": {
            "label": "Ceremony florals"
          }
        },

        {
          "type": "gallery_image",
          "settings": {
            "label": "Table arrangements"
          }
        }

      ]

    }

  ]

}
{% endschema %}
