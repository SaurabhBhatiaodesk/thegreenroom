<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var stage = section.querySelector('#cards-scroll-stage-{{ section.id }}');
    var cards = section.querySelectorAll('.scroll-column');
    if (!stage || !cards.length) return;

    function clamp(v, min, max) {
      return Math.max(min, Math.min(max, v));
    }

    function lerp(a, b, t) {
      return a + (b - a) * t;
    }

    function easeOut(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function getMap() {
      if (window.innerWidth <= 749) {
        return {
          1: { x: 0, y: 0, r: 0, fromY: 0 },
          2: { x: 0, y: 54, r: 0, fromY: 470 },
          3: { x: 0, y: 108, r: 0, fromY: 470 },
          4: { x: 0, y: 162, r: 0, fromY: 470 },
          5: { x: 0, y: 216, r: 0, fromY: 470 }
        };
      }

      if (window.innerWidth <= 1200) {
        return {
          1: { x: 0, y: 12, r: 0, fromY: 430 },
          2: { x: -190, y: -82, r: -9, fromY: 450 },
          3: { x: 190, y: -82, r: 9, fromY: 450 },
          4: { x: -135, y: 48, r: -7, fromY: 490 },
          5: { x: 135, y: 48, r: 7, fromY: 490 }
        };
      }

      return {
        1: { x: 0, y: 18, r: 0, fromY: 0 },
        2: { x: -275, y: -110, r: -9, fromY: 500 },
        3: { x: 275, y: -110, r: 9, fromY: 500 },
        4: { x: -185, y: 58, r: -7, fromY: 540 },
        5: { x: 185, y: 58, r: 7, fromY: 540 }
      };
    }

    function getProgress() {
      var rect = stage.getBoundingClientRect();
      var total = stage.offsetHeight - window.innerHeight;
      if (total <= 0) return 0;
      return clamp((-rect.top) / total, 0, 1);
    }

    function updateCards() {
      var map = getMap();
      var progress = getProgress();
      var isMobile = window.innerWidth <= 749;

      var segments = isMobile
        ? {
            1: { start: 0.00, end: 0.00 },
            2: { start: 0.10, end: 0.24 },
            3: { start: 0.26, end: 0.40 },
            4: { start: 0.42, end: 0.56 },
            5: { start: 0.58, end: 0.72 }
          }
        : {
            1: { start: 0.00, end: 0.00 },
            2: { start: 0.08, end: 0.26 },
            3: { start: 0.28, end: 0.46 },
            4: { start: 0.50, end: 0.68 },
            5: { start: 0.72, end: 0.90 }
          };

      cards.forEach(function(card) {
        var i = parseInt(card.getAttribute('data-card'), 10);
        var cfg = map[i];

        if (i === 1) {
          if (isMobile) {
            card.style.transform = 'translate(-50%, -50%) translate(0px, 0px) rotate(0deg)';
          } else {
            card.style.transform = 'translate(-50%, -50%) translate(' + cfg.x + 'px, ' + cfg.y + 'px) rotate(' + cfg.r + 'deg)';
          }
          return;
        }

        var seg = segments[i];
        var t = clamp((progress - seg.start) / (seg.end - seg.start), 0, 1);
        var eased = easeOut(t);
        var y = lerp(cfg.fromY, cfg.y, eased);

        if (progress < seg.start) y = cfg.fromY;
        if (progress > seg.end) y = cfg.y;

        if (isMobile) {
          card.style.transform = 'translate(-50%, -50%) translate(0px, ' + y + 'px) rotate(0deg)';
        } else {
          card.style.transform = 'translate(-50%, -50%) translate(' + cfg.x + 'px, ' + y + 'px) rotate(' + cfg.r + 'deg)';
        }
      });
    }

    updateCards();
    window.addEventListener('load', updateCards);
    window.addEventListener('resize', updateCards);
    window.addEventListener('scroll', updateCards, { passive: true });
  })();
</script>

