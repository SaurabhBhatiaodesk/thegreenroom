<style>
  #shopify-section-{{ section.id }} .mh_text_blocks_h2 {
    position: relative;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .cards_scroll_stage_h2 {
    position: relative;
    height: 560vh;
  }

  #shopify-section-{{ section.id }} .cards_sticky_h2 {
    position: sticky;
    top: 110px;
    height: calc(100vh - 110px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    padding-top: 30px;
    padding-bottom: 70px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cards_scene_h2 {
    position: relative;
    width: 100%;
    max-width: 1500px;
    height: 760px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .scroll-column {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    max-width: 255px;
    min-height: 380px;
    padding: 26px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-position: center;
    transform-origin: center center;
    will-change: transform;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .scroll-column-inner {
    width: 100%;
    max-width: 185px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .column_heading {
    width: 100%;
    margin: 0 0 14px;
  }

  #shopify-section-{{ section.id }} .column_heading * {
    margin: 0;
    color: inherit;
    text-align: center;
    font-size: 24px;
    line-height: 1.02;
  }

  #shopify-section-{{ section.id }} .column_heading h1,
  #shopify-section-{{ section.id }} .column_heading h2 {
    font-size: 24px;
    line-height: 1.02;
  }

  #shopify-section-{{ section.id }} .column_heading h3,
  #shopify-section-{{ section.id }} .column_heading h4,
  #shopify-section-{{ section.id }} .column_heading h5,
  #shopify-section-{{ section.id }} .column_heading h6 {
    font-size: 21px;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .column_para {
    width: 100%;
    margin: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .column_para * {
    margin: 0;
    color: inherit;
    text-align: center;
    font-size: 13px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .col_btn {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .column_btns {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 145px;
    max-width: 100%;
    padding: 11px 15px;
    border-radius: 999px;
    text-decoration: none;
    text-align: center;
    font-size: 10px;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0;
    word-break: break-word;
  }

  #shopify-section-{{ section.id }} .bottom_image_d9 {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .mobile_dd {
    display: none;
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .cards_sticky_h2 {
      top: 85px;
      height: calc(100vh - 85px);
      padding-top: 24px;
      padding-bottom: 56px;
    }

    #shopify-section-{{ section.id }} .cards_scene_h2 {
      max-width: 1180px;
      height: 660px;
    }

    #shopify-section-{{ section.id }} .scroll-column {
      max-width: 235px;
      min-height: 350px;
      padding: 24px 18px;
    }

    #shopify-section-{{ section.id }} .scroll-column-inner {
      max-width: 172px;
    }

    #shopify-section-{{ section.id }} .column_heading * {
      font-size: 21px;
    }

    #shopify-section-{{ section.id }} .column_heading h1,
    #shopify-section-{{ section.id }} .column_heading h2 {
      font-size: 21px;
    }

    #shopify-section-{{ section.id }} .column_heading h3,
    #shopify-section-{{ section.id }} .column_heading h4,
    #shopify-section-{{ section.id }} .column_heading h5,
    #shopify-section-{{ section.id }} .column_heading h6 {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .column_para * {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .column_btns {
      min-width: 135px;
      font-size: 9px;
      padding: 10px 14px;
    }
  }

  @media screen and (max-width: 749px) {
