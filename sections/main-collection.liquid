<!-- sections/main-collection.liquid -->

{%- liquid
  assign continue_shopping_t = 'collections.continue_shopping' | t
  assign no_products_t = 'collections.no_products_feedback' | t
  assign filter_feedback_t = 'collections.filter_feedback' | t
  assign skip_link_t = 'general.a11y.skip_pagination' | t

  assign border = section.settings.border
  assign container_width = '5'
  assign columns = section.settings.columns | plus: 0
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_columns = section.settings.mobile-columns | plus: 0
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below

  assign variant_layout = false
  if section.settings.grid-layout == 'variants'
    assign variant_layout = true
    assign columns = section.settings.variant-columns | plus: 0
    assign mobile_columns = section.settings.variant-mobile-columns | plus: 0
    assign mobile_full_width = section.settings.variant-mobile-full-width
    assign border = section.settings.variant-border
    assign spacing_above = section.settings.variant-spacing-above
    assign spacing_below = section.settings.variant-spacing-below
    assign mobile_spacing_above = section.settings.variant-mobile-spacing-above
    assign mobile_spacing_below = section.settings.variant-mobile-spacing-below
  endif

  assign promo_grid_blocks = 0
  assign total_grid_positions = columns | times: section.settings.rows

  for block in section.blocks
    if variant_layout
      continue
    endif
    assign block_position = block.settings.position
    if block_position > total_grid_positions
      continue
    endif

    if block.settings.promo-width == 'full'
      assign promo_width = columns
    else
      assign promo_width = block.settings.promo-width | plus: 0
    endif

    assign promo_grid_blocks = promo_grid_blocks | plus: promo_width
    assign promo_columns = columns | divided_by: promo_width
    assign mobile_promo_columns = 1
    if promo_width == 1 and mobile_columns == 2
      assign mobile_promo_columns = 2
    endif

    capture promo_sizes
      render 'sizes-grid', container_width: container_width, columns: promo_columns, mobile_columns: mobile_promo_columns, mobile_full_width: mobile_full_width
    endcapture

    assign loading = 'lazy'
    if block_position <= columns
      assign loading = 'eager'
    endif

    capture promo_html
      unless promo_html == blank
        echo promo_html | append: '<span class="divider"></span>'
      endunless
      render 'collection-promo', section_id: section.id, block: block, promo_width: promo_width, sizes: promo_sizes, loading: loading
    endcapture
  endfor

  capture sizes
    render 'sizes-grid', container_width: container_width, columns: columns, mobile_columns: mobile_columns, mobile_full_width: mobile_full_width
  endcapture

  assign products_per_page = total_grid_positions | minus: promo_grid_blocks
  assign promo_html_arr = promo_html | split: '<span class="divider"></span>'

  assign sold_out_to_end = false
  if collection.id == 319000576174 or collection.id == '319000576174' or collection.handle == 'plantsmegamenu'
    assign sold_out_to_end = true
  endif

  assign collection_products_per_page = products_per_page
  if variant_layout
    assign sold_out_to_end = false
    assign collection_products_per_page = section.settings.variant-products-per-page
  endif
  assign sold_out_custom_pages = 1
  if sold_out_to_end
    assign collection_products_per_page = 250
    assign sold_out_custom_pages = collection.products_count | divided_by: products_per_page
    assign sold_out_custom_pages_remainder = collection.products_count | modulo: products_per_page
    if sold_out_custom_pages_remainder > 0
      assign sold_out_custom_pages = sold_out_custom_pages | plus: 1
    endif
  endif
-%}

<div
  class="main-collection--root"
  id="collection_root"
  data-background-color="none"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  {% if sold_out_to_end %}
    data-sold-out-to-end="true"
    data-products-per-page="{{ products_per_page }}"
    data-product-count="{{ collection.products_count }}"
  {% endif %}
>
  <div
    class="main-collection--wrapper"
    data-container="section"
    data-body-wrapper
    data-max-columns="{{ columns }}"
  >
    <div
      class="main-collection--spinner"
      aria-hidden="true"
      data-container="block"
      data-body-spinner
    >
      <div class="main-collection--spinner-wrapper" data-item="spinner">
        {%- render 'icons', icon: 'spinner' -%}
      </div>
    </div>

    {%- paginate collection.products by collection_products_per_page -%}
      {%- if paginate.pages > 1 or sold_out_custom_pages > 1 -%}
        <a data-item="a11y-button" href='#collection_pagination' data-body-pagination-link>
          {{ skip_link_t }}
        </a>
      {%- endif -%}

      <div
        class="main-collection--grid"
        data-body-grid
        data-container="panel"
        data-columns="{{ columns }}"
        data-mobile-columns="{{ mobile_columns }}"
        {% unless settings.transitions--other %}
          data-transition-container="{{ section.id }}"
          data-transition-type="fade-in"
          data-transition-trigger="{% if paginate.pages == 1 %}2{% endif %}0"
          data-transition-cascade="horizontal"
          data-transition-cascade-interval="200"
        {% endunless %}
      >
        {%- if collection.products_count > 0 -%}
          {%- if variant_layout -%}
            {%- assign blank_count = 0 -%}
            {%- for product in collection.products -%}
              {%- liquid
                assign expand_product = section.settings.variant-expand-all
                for selected_product in section.settings.variant-products
                  if selected_product.id == product.id
                    assign expand_product = true
                    break
                  endif
                endfor
                assign loading = 'lazy'
                if forloop.index <= columns
                  assign loading = 'eager'
                endif
              -%}
              {%- if expand_product and product.has_only_default_variant == false -%}
                {%- for variant in product.variants -%}
                  {%- if section.settings.variant-hide-sold-out and variant.available == false -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- liquid
                    assign card_image = variant.featured_image | default: product.featured_image
                    assign card_title = variant.title
                    if section.settings.variant-title-style == 'product-variant'
                      assign card_title = product.title | append: ' - ' | append: variant.title
                    endif
                    assign card_alt = card_image.alt | default: card_title
                  -%}
                  <article class="main-collection--variant-card" data-alignment="{{ section.settings.variant-text-alignment }}">
                    <a class="main-collection--variant-image" data-ratio="{{ section.settings.variant-image-ratio }}" href="{{ variant.url }}" aria-label="{{ card_title | escape }}">
                      {%- unless variant.available -%}
                        <div
                          class="product--labels"
                          data-item="overline"
                          data-text-color="{{ settings.product--label-text-color | default: 'body' }}"
                        >
                          <div
                            class="product--label"
                            data-background-color="{{ settings.product--label-color }}"
                            data-label-shape="{{ settings.product--label-shape }}"
                            data-label-type="out-of-stock"
                          >
                            {{- 'products.out_of_stock' | t -}}
                          </div>
                        </div>
                      {%- endunless -%}
                      {%- if card_image != blank -%}
                        {{- card_image | image_url: width: 1600 | image_tag: widths: '240,360,480,640,800,1200,1600', sizes: sizes, loading: loading, alt: card_alt -}}
                      {%- else -%}
                        {{- 'product-1' | placeholder_svg_tag -}}
                      {%- endif -%}
                    </a>
                    <div class="main-collection--variant-details">
                      <a href="{{ variant.url }}" data-item="block-heading">{{ card_title | escape }}</a>
                      {%- if section.settings.variant-show-price -%}
                        <div data-item="paragraph">
                          {%- if variant.compare_at_price > variant.price -%}
                            <s>{{ variant.compare_at_price | money }}</s>
                          {%- endif -%}
                          <span>{{ variant.price | money }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endfor -%}
              {%- else -%}
                {%- render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading -%}
              {%- endif -%}
            {%- endfor -%}
          {%- elsif sold_out_to_end -%}
            {%- liquid
              assign columns_used = 0
              assign rendered_product_count = 0
            -%}

            {%- for product in collection.products -%}
              {%- if product.available -%}
                {%- liquid
                  assign rendered_product_count = rendered_product_count | plus: 1
                  assign loading = 'lazy'
                  if rendered_product_count <= columns
                    assign loading = 'eager'
                  endif
                -%}
                <div class="main-collection--sorted-product" data-sorted-product-card data-product-available="true" hidden>
                  {%- liquid
                    render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading
                    assign columns_used = columns_used | plus: 1
                  -%}
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- for product in collection.products -%}
              {%- unless product.available -%}
                {%- liquid
                  assign rendered_product_count = rendered_product_count | plus: 1
                  assign loading = 'lazy'
                  if rendered_product_count <= columns
                    assign loading = 'eager'
                  endif
                -%}
                <div class="main-collection--sorted-product" data-sorted-product-card data-product-available="false" hidden>
                  {%- liquid
                    render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading
                    assign columns_used = columns_used | plus: 1
                  -%}
                </div>
              {%- endunless -%}
            {%- endfor -%}

            {%- liquid
              assign blank_count = 0
            -%}
          {%- else -%}
            {%- liquid
              assign product_index = 0
              assign columns_used = 0
              assign num_grid_items = products_per_page | plus: promo_html_arr.size

              for i in (1..num_grid_items)
                assign grid_index = forloop.index
                assign promo_index = false

                for block in section.blocks
                  if block.settings.position == grid_index
                    assign promo_index = forloop.index0
                    assign promo_width = block.settings.promo-width
                    break
                  endif
                endfor

                if promo_index
                  assign column = grid_index | modulo: columns
                  if promo_width == 'full'
                    assign current_promo_width = columns
                  else
                    assign current_promo_width = promo_width | plus: 0
                  endif

                  if column == 0 and product_index == collection.products.size and current_promo_width == 2
                    break
                  else
                    echo promo_html_arr[promo_index]
                    assign columns_used = columns_used | plus: current_promo_width
                  endif

                elsif product_index < collection.products.size
                  assign product = collection.products[product_index]
                  assign product_index = product_index | plus: 1
                  assign loading = 'lazy'
                  if grid_index <= columns
                    assign loading = 'eager'
                  endif

                  render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading
                  assign columns_used = columns_used | plus: 1
                else
                  break
                endif
              endfor

              assign remainder = columns_used | modulo: columns
              assign blank_count = 0
              if remainder > 0
                assign blank_count = columns | minus: remainder
              endif
            -%}
          {%- endif -%}

          {%- if blank_count > 0 -%}
            {%- for i in (1..blank_count) -%}
              <div
                data-item="blank"
                aria-hidden="true"
                {% unless settings.transitions--other %}
                  data-transition-item="{{ section.id }}"
                {% endunless %}
              ></div>
            {%- endfor -%}
          {%- endif -%}

        {%- elsif current_tags == blank -%}
          <div class="main-collection--empty" data-container="block">
            <p data-item="paragraph">
              {{- no_products_t -}}
            </p>
            <a href="{{ routes.root_url }}" data-item="block-link">
              <div>{{ continue_shopping_t }}</div>
            </a>
          </div>

        {%- else -%}
          <div class="main-collection--empty" data-container="block">
            <p data-item="paragraph">
              {{- filter_feedback_t -}}
            </p>
          </div>

        {%- endif -%}
      </div>

      <div
        class="main-collection--pagination"
        id="collection_pagination"
        data-container="block"
        data-body-pagination
      >
        {%- liquid
          if sold_out_to_end and sold_out_custom_pages > 1
            echo '<div class="main-collection--custom-pagination" data-sold-out-custom-pagination></div>'
          elsif paginate.pages > 1
            render 'pagination', paginate: paginate, hash: 'collection_root'
          endif
        -%}
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .main-collection--variant-card { min-width: 0; }
  .main-collection--variant-card[data-alignment='center'] { text-align: center; }
  .main-collection--variant-image { display: block; overflow: hidden; position: relative; }
  .main-collection--variant-image img,
  .main-collection--variant-image svg { display: block; width: 100%; height: auto; }
  .main-collection--variant-image[data-ratio='square'] { aspect-ratio: 1; }
  .main-collection--variant-image[data-ratio='portrait'] { aspect-ratio: 4 / 5; }
  .main-collection--variant-image:not([data-ratio='adapt']) img,
  .main-collection--variant-image:not([data-ratio='adapt']) svg { height: 100%; object-fit: cover; }
  .main-collection--variant-details { display: grid; gap: var(--spacing--2); padding-top: var(--spacing--3); }
  .main-collection--variant-details a { color: inherit; text-decoration: none; }
  .main-collection--variant-details s { opacity: .65; margin-right: .5em; }
  .main-collection--spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--spacing--8) 0;

    &[aria-hidden='true'] {
      display: none;
    }
  }

  .main-collection--spinner-wrapper > * {
    margin: 0 auto;
  }

  .main-collection--empty {
    text-align: center;
    padding: var(--spacing--8) 0;
    background-color: var(--bg-color);
    grid-column: 1 / span var(--columns);

    @media (min-width: 768px) {
      [data-columns='2'] & {
        --columns: 2;
      }

      [data-columns='3'] & {
        --columns: 3;
      }

      [data-columns='4'] & {
        --columns: 4;
      }
    }

    @media (max-width: 767px) {
      [data-mobile-columns='1'] & {
        --columns: 1;
      }

      [data-mobile-columns='2'] & {
        --columns: 2;
      }
    }
  }

  .main-collection--pagination {
    &:empty {
      display: none;
    }

    &:not(:empty) {
      padding-bottom: 2px;
    }
  }

  .main-collection--sorted-product {
    display: block;
  }

  .main-collection--sorted-product[hidden] {
    display: none;
  }

  .main-collection--custom-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing--2);
  }

  .main-collection--custom-pagination a,
  .main-collection--custom-pagination span {
    align-items: center;
    display: inline-flex;
    min-height: 44px;
    padding: 0 var(--spacing--3);
  }

  .main-collection--custom-pagination [aria-current='page'] {
    font-weight: 700;
  }
{% endstylesheet %}

<script>
  (() => {
    const setupSoldOutPagination = async (root) => {
      if (!root || root.dataset.soldOutToEnd !== 'true') {
        return;
      }

      const grid = root.querySelector('[data-body-grid]');
      const pagination = root.querySelector('[data-sold-out-custom-pagination]');
      const perPage = parseInt(root.dataset.productsPerPage, 10);
      const productCount = parseInt(root.dataset.productCount, 10);
      const params = new URLSearchParams(window.location.search);

      if (params.has('page') && !params.has('sorted_page')) {
        const url = new URL(window.location.href);
        url.searchParams.set('sorted_page', params.get('page'));
        url.searchParams.delete('page');
        url.hash = 'collection_root';
        window.history.replaceState({}, '', url.toString());
      }

      if (!grid || !perPage) {
        return;
      }

      const initialCards = Array.from(root.querySelectorAll('[data-sorted-product-card]'));
      const nativePageCount = Math.ceil((productCount || initialCards.length) / 250);
      let cards = initialCards;

      const urlForPage = (page) => {
        const url = new URL(window.location.href);

        if (page <= 1) {
          url.searchParams.delete('sorted_page');
        } else {
          url.searchParams.set('sorted_page', page);
        }

        url.searchParams.delete('page');
        url.hash = 'collection_root';

        return url.toString();
      };

      const sortCards = (cardsToSort) => {
        const availableCards = cardsToSort.filter((card) => card.dataset.productAvailable === 'true');
        const soldOutCards = cardsToSort.filter((card) => card.dataset.productAvailable !== 'true');

        return availableCards.concat(soldOutCards);
      };

      const getNativePageUrl = (page) => {
        const url = new URL(window.location.href);
        url.searchParams.delete('sorted_page');
        url.searchParams.set('page', page);
        url.hash = '';

        return url.toString();
      };

      const fetchNativePageCards = async (page) => {
        const response = await fetch(getNativePageUrl(page), {
          credentials: 'same-origin',
        });
        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const fetchedRoot = doc.querySelector('#collection_root');

        return fetchedRoot
          ? Array.from(fetchedRoot.querySelectorAll('[data-sorted-product-card]'))
          : [];
      };

      const setCards = (nextCards) => {
        cards = sortCards(nextCards);

        cards.forEach((card) => {
          grid.appendChild(card);
        });
      };

      const showPage = (page, updateUrl = true) => {
        const pageCount = Math.ceil(cards.length / perPage);
        const currentPage = Math.min(Math.max(page || 1, 1), pageCount);
        const firstVisibleIndex = (currentPage - 1) * perPage;
        const lastVisibleIndex = firstVisibleIndex + perPage;

        cards.forEach((card, index) => {
          card.hidden = index < firstVisibleIndex || index >= lastVisibleIndex;
        });

        if (pagination && pageCount > 1) {
          const items = [];

          if (currentPage > 1) {
            items.push(`<a href="${urlForPage(currentPage - 1)}" data-sorted-page="${currentPage - 1}" aria-label="Previous page">&larr;</a>`);
          }

          for (let pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
            if (pageNumber === currentPage) {
              items.push(`<span aria-current="page">${pageNumber}</span>`);
            } else {
              items.push(`<a href="${urlForPage(pageNumber)}" data-sorted-page="${pageNumber}">${pageNumber}</a>`);
            }
          }

          if (currentPage < pageCount) {
            items.push(`<a href="${urlForPage(currentPage + 1)}" data-sorted-page="${currentPage + 1}" aria-label="Next page">&rarr;</a>`);
          }

          pagination.innerHTML = items.join('');
        }

        if (updateUrl) {
          window.history.pushState({}, '', urlForPage(currentPage));
        }
      };

      const requestedPage = parseInt(new URLSearchParams(window.location.search).get('sorted_page') || '1', 10);
      setCards(initialCards);
      showPage(requestedPage, false);

      if (pagination && !pagination.dataset.sortedPaginationBound) {
        pagination.dataset.sortedPaginationBound = 'true';
        pagination.addEventListener('click', (event) => {
          const link = event.target.closest('[data-sorted-page]');

          if (!link) {
            return;
          }

          event.preventDefault();
          showPage(parseInt(link.dataset.sortedPage, 10));
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      if (nativePageCount > 1 && !root.dataset.sortedCardsLoaded) {
        root.dataset.sortedCardsLoaded = 'true';

        try {
          const fetchedCardGroups = await Promise.all(
            Array.from({ length: nativePageCount - 1 }, (_, index) => fetchNativePageCards(index + 2))
          );
          const fetchedCards = fetchedCardGroups.flat();

          if (fetchedCards.length) {
            setCards(initialCards.concat(fetchedCards));
            showPage(requestedPage, false);
          }
        } catch (error) {
          console.warn('Could not load every collection page for sold-out sorting.', error);
        }
      }
    };

    setupSoldOutPagination(document.getElementById('collection_root'));

    document.addEventListener('shopify:section:load', (event) => {
      setupSoldOutPagination(event.target.querySelector('#collection_root'));
    });
  })();
</script>

