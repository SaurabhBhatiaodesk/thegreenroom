{{ 'party-petals.css' | asset_url | stylesheet_tag }}

<section
  class="pp-wrap"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="pp-container">
    <div class="pp-inner">
      <div
        class="pp-intro"
        style="
          --pp-title-color: {{ section.settings.title_color }};
          --pp-text-color: {{ section.settings.text_color }};
          --pp-title-font-size: {{ section.settings.title_font_size }}px;
          --pp-title-font-size-mobile: {{ section.settings.title_font_size_mobile }}px;
          --pp-text-font-size: {{ section.settings.text_font_size }}px;
          --pp-text-font-size-mobile: {{ section.settings.text_font_size_mobile }}px;
          --pp-padding-top: {{ section.settings.padding_top }}px;
          --pp-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
          --pp-padding-h: {{ section.settings.padding_horizontal }}px;
          --pp-padding-h-mobile: {{ section.settings.padding_horizontal_mobile }}px;
        "
      >
        <h2 class="pp-intro-title">
          {{ section.settings.intro_heading | default: 'Beautiful blooms, without the fuss' }}
        </h2>

        <p class="pp-intro-text">
          {{ section.settings.intro_text | default: "Designed for the bride that wants beautiful blooms for her day without the fuss, our Party Petals Collection is a selection of floral designs that are the most popular for couples seeking a refined and relaxed day." }}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
/* =========================================================
   SECTION: party-petals-intro.liquid
   ========================================================= */
.pp-intro {
  padding: var(--pp-padding-top, 80px) var(--pp-padding-h, 110px) 0;
  display: flex;
  flex-direction: column;
  gap: 22px;
  max-width:900px;
}

.pp-intro-title {
  margin: 0;
  font-family: Poppins, sans-serif;
  font-weight: 700;
  font-size: var(--pp-title-font-size, 30px);
  letter-spacing: 0.03em;
  line-height: normal;
  text-transform: uppercase;
  color: var(--pp-title-color, #264A3D);
}

.pp-intro-text {
  margin: 0;
  font-size: var(--pp-text-font-size, 16px);
  line-height: 1.85;
  color: var(--pp-text-color, #264A3D);
}

@media (max-width: 749px) {
  .pp-intro {
    padding-top: var(--pp-padding-top-mobile, 50px);
    padding-left: var(--pp-padding-h-mobile, 24px);
    padding-right: var(--pp-padding-h-mobile, 24px);
  }

  .pp-intro-title {
    font-size: var(--pp-title-font-size-mobile, 24px);
  }

  .pp-intro-text {
    font-size: var(--pp-text-font-size-mobile, 15px);
  }
}
</style>

{% schema %}
{
  "name": "Party Petals — Intro",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#264A3D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#264A3D"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Heading",
      "default": "Beautiful blooms, without the fuss"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Text",
      "default": "Designed for the bride that wants beautiful blooms for her day without the fuss, our Party Petals Collection is a selection of floral designs that are the most popular for couples seeking a refined and relaxed day."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Heading font size (desktop)",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Heading font size (mobile)",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text font size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Text font size (mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Side padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Party Petals — Intro"
    }
  ]
}
{% endschema %}
