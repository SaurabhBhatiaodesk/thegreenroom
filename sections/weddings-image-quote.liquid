{%- liquid
  assign section_id = 'wedding-image-quote-' | append: section.id
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
-%}

<style>
  #{{ section_id }} {
    --wedding-quote-bg: {{ bg_color }};
    --wedding-quote-text: {{ text_color }};
    --wedding-quote-accent: {{ accent_color }};
    --wedding-quote-max-width: {{ section.settings.max_width }}px;
    --wedding-quote-gap: {{ section.settings.desktop_gap }}px;
    --wedding-quote-padding-top: {{ section.settings.padding_top }}px;
    --wedding-quote-padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--wedding-quote-bg);
    color: var(--wedding-quote-text);
    font-family: "Bookmania", serif;
    padding-top: var(--wedding-quote-padding-top);
    padding-bottom: var(--wedding-quote-padding-bottom);
  }

  #{{ section_id }},
  #{{ section_id }} * {
    font-family: "Bookmania", serif !important;
  }

  #{{ section_id }} .wedding-image-quote__inner {
    width: min(100% - 40px, var(--wedding-quote-max-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 0.92fr);
    gap: var(--wedding-quote-gap);
    align-items: center;
  }

  #{{ section_id }} .wedding-image-quote__media {
    width: 90%;
    max-width: 540px;
  }

  #{{ section_id }} .wedding-image-quote__image-frame {
    width: 100%;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background: rgba(0, 0, 0, 0.04);
  }

  #{{ section_id }} .wedding-image-quote__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #{{ section_id }} .wedding-image-quote__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    color: var(--wedding-quote-accent);
    text-align: center;
    font-size: 0.9rem;
  }

  #{{ section_id }} .wedding-image-quote__content {
    max-width: 420px;
    transform: translateY(-80px);
  }

  #{{ section_id }} .wedding-image-quote__eyebrow {
    margin: 0 0 22px;
    color: var(--wedding-quote-accent);
    font-size: 0.78rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ section_id }} .wedding-image-quote__quote {
    margin: 0;
    color: var(--wedding-quote-text);
    font-size: clamp(1.25rem, 2vw, 2.3rem);
    line-height: 1.2;
    font-weight: 300;
    letter-spacing: 0;
  }

  #{{ section_id }} .wedding-image-quote__quote p {
    margin: 0 0 1.25em;
    font: inherit;
    color: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  #{{ section_id }} .wedding-image-quote__quote p:last-child {
    margin-bottom: 0;
  }


  #{{ section_id }} .wedding-image-quote__author {
    margin: 30px 0 0;
    color: var(--wedding-quote-accent);
    font-size: 1.5rem;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  #{{ section_id }} .wedding-image-quote__body {
    margin-top: 24px;
    color: var(--wedding-quote-text);
    font-size: 1rem;
    line-height: 1.8;
  }

  #{{ section_id }} .wedding-image-quote__body p {
    margin: 0 0 1.25em;
  }

  #{{ section_id }} .wedding-image-quote__body p:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .wedding-image-quote__body > *:first-child {
    margin-top: 0;
  }

  #{{ section_id }} .wedding-image-quote__body > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .wedding-image-quote__eyebrow {
      font-size: 10px;
    }
    #{{ section_id }} {
      --wedding-quote-padding-top: {{ section.settings.mobile_padding_top }}px;
      --wedding-quote-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .wedding-image-quote__inner {
      width: min(100% - 32px, var(--wedding-quote-max-width));
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #{{ section_id }} .wedding-image-quote__media {
      order: 1;
      width: 92%;
      max-width: none;
      margin-left: auto;
      margin-right: auto;
    }

    #{{ section_id }} .wedding-image-quote__content {
      order: 2;
      width: min(100%, 420px);
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
      text-align: {{ section.settings.mobile_text_alignment }};
      transform: translateY(-32px);
    }

    #{{ section_id }} .wedding-image-quote__quote {
      font-size: clamp(1.3rem, 5.8vw, 1.9rem);
      line-height: 1.22;
    }

    #{{ section_id }} .wedding-image-quote__author {
      margin-top: 24px;
      font-size: 1.1rem;
    }

    #{{ section_id }} .wedding-image-quote__body {
      font-size: 0.94rem;
      line-height: 1.65;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="wedding-image-quote"
  data-section-id="{{ section.id }}"
  data-section-type="wedding-image-quote"
>
  <div class="wedding-image-quote__inner">
    <div class="wedding-image-quote__media">
      <div class="wedding-image-quote__image-frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'wedding-image-quote__image',
              loading: 'lazy',
              sizes: '(min-width: 750px) 45vw, 92vw',
              widths: '375, 550, 750, 950, 1100, 1400'
          }}
        {%- else -%}
          <div class="wedding-image-quote__placeholder">
            Add an image in this section's Theme Editor settings.
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="wedding-image-quote__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wedding-image-quote__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.quote != blank -%}
        <div class="wedding-image-quote__quote">
          {{ section.settings.quote }}
        </div>
      {%- endif -%}

      {%- if section.settings.author != blank -%}
        <p class="wedding-image-quote__author">{{ section.settings.author | escape }}</p>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="wedding-image-quote__body">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wedding image with quote",
  "class": "section--wedding-image-quote",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "16 / 9",
          "label": "Landscape"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Kind words"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>The flowers were more beautiful than we could have imagined and brought the whole day together so effortlessly.</p>"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "A Green Room couple"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Additional text",
      "default": "<p>Use this space for a short testimonial note, venue detail, or a little extra context around the wedding story.</p>"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf5ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3d332f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c98695"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Space between image and quote",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 176,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 176,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Space between image and quote",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Wedding image with quote"
    }
  ]
}
{% endschema %}
