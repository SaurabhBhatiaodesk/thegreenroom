<style>
  .title_color_{{ section.id }} * {
    color: {{ section.settings.title_color }} !important;
  }

  #shopify-section-{{ section.id }} .mh_logos_d3 {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .max_width_dd {
    max-width: 1300px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .title_d3 {
    margin: 0 0 48px;
  }

  #shopify-section-{{ section.id }} .title_d3 p,
  #shopify-section-{{ section.id }} .title_d3 h1,
  #shopify-section-{{ section.id }} .title_d3 h2,
  #shopify-section-{{ section.id }} .title_d3 h3,
  #shopify-section-{{ section.id }} .title_d3 h4,
  #shopify-section-{{ section.id }} .title_d3 h5,
  #shopify-section-{{ section.id }} .title_d3 h6 {
    margin: 0;
    font-size: 56px;
    line-height: 1.05;
    font-weight: 400;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .logos_wrapper_d3 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    column-gap: 64px;
    row-gap: 32px;
  }

  #shopify-section-{{ section.id }} .image_d3 {
    display: block;
    width: auto;
    max-width: 220px;
    max-height: 100px;
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .bottom_image_d9 {
    display: none;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .title_d3 p,
    #shopify-section-{{ section.id }} .title_d3 h1,
    #shopify-section-{{ section.id }} .title_d3 h2,
    #shopify-section-{{ section.id }} .title_d3 h3,
    #shopify-section-{{ section.id }} .title_d3 h4,
    #shopify-section-{{ section.id }} .title_d3 h5,
    #shopify-section-{{ section.id }} .title_d3 h6 {
      font-size: 42px;
    }

    #shopify-section-{{ section.id }} .logos_wrapper_d3 {
      column-gap: 48px;
      row-gap: 28px;
    }

    #shopify-section-{{ section.id }} .image_d3 {
      max-width: 180px;
      max-height: 80px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mh_logos_d3 {
      padding-top: 36px !important;
      padding-bottom: 36px !important;
    }

    #shopify-section-{{ section.id }} .page-width {
      padding-left: 20px;
      padding-right: 20px;
    }

    #shopify-section-{{ section.id }} .title_d3 {
      margin-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .title_d3 p,
    #shopify-section-{{ section.id }} .title_d3 h1,
    #shopify-section-{{ section.id }} .title_d3 h2,
    #shopify-section-{{ section.id }} .title_d3 h3,
    #shopify-section-{{ section.id }} .title_d3 h4,
    #shopify-section-{{ section.id }} .title_d3 h5,
    #shopify-section-{{ section.id }} .title_d3 h6 {
      font-size: 28px;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .logos_wrapper_d3 {
      column-gap: 18px;
      row-gap: 12px;
    }

    #shopify-section-{{ section.id }} .image_d3 {
      max-width: 130px;
      max-height: 60px;
    }
  }
</style>

<section
  class="mh_logos_d3"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};"
>
  <div class="page-width">
    <div class="max_width_dd">
      {% if section.settings.title != blank %}
        <div class="text_dd title_d3 title_color_{{ section.id }}">
          {{ section.settings.title }}
        </div>
      {% endif %}

      <div class="logos_wrapper_d3">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <img
              class="image_dd image_d3"
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | escape }}"
              width="" height="" loading="lazy"
            >
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TIC Logos",
  "presets": [
    {
      "name": "TIC Logos"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#dca0ae"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#fdf7ee"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ]
}
{% endschema %}