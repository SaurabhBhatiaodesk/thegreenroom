{%- liquid
  assign section_id = 'masonry-gallery-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.side_padding }}px {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .masonry-gallery__inner {
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #{{ section_id }} .masonry-gallery__grid {
    column-count: {{ section.settings.columns_desktop }};
    column-gap: {{ section.settings.gap }}px;
  }

  #{{ section_id }} .masonry-gallery__item {
    position: relative;
    width: 100%;
    margin: 0 0 {{ section.settings.gap }}px;
    overflow: hidden;
    break-inside: avoid;
    border-radius: {{ section.settings.image_radius }}px;
    background: {{ section.settings.placeholder_bg }};
  }

  #{{ section_id }} .masonry-gallery__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #{{ section_id }} .masonry-gallery__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
    transition: transform 300ms ease;
  }

  #{{ section_id }} .masonry-gallery__item:hover .masonry-gallery__image {
    transform: scale({{ section.settings.hover_zoom }});
  }

  #{{ section_id }} .masonry-gallery__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 240px;
    border-radius: {{ section.settings.image_radius }}px;
    background: {{ section.settings.placeholder_bg }};
  }

  #{{ section_id }} .masonry-gallery__placeholder svg {
    width: 60%;
    height: auto;
    opacity: 0.3;
  }

  @media screen and (max-width: 1024px) {
    #{{ section_id }} .masonry-gallery__grid {
      column-count: {{ section.settings.columns_tablet }};
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_side_padding }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .masonry-gallery__inner {
      width: 100%;
    }

    #{{ section_id }} .masonry-gallery__grid {
      column-count: {{ section.settings.columns_mobile }};
      column-gap: {{ section.settings.mobile_gap }}px;
    }

    #{{ section_id }} .masonry-gallery__item {
      margin-bottom: {{ section.settings.mobile_gap }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .masonry-gallery__image {
      transition: none;
    }

    #{{ section_id }} .masonry-gallery__item:hover .masonry-gallery__image {
      transform: none;
    }
  }
</style>

<section id="{{ section_id }}" class="masonry-gallery">
  <div class="masonry-gallery__inner">
    <div class="masonry-gallery__grid">
      {%- for block in section.blocks -%}
        <div class="masonry-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- capture image_markup -%}
              <img
                class="masonry-gallery__image"
                src="{{ block.settings.image | image_url: width: 1200 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 320 }} 320w,
                  {{ block.settings.image | image_url: width: 480 }} 480w,
                  {{ block.settings.image | image_url: width: 640 }} 640w,
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1000 }} 1000w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 749px) 50vw, (max-width: 1024px) 33vw, 25vw"
                alt="{{ block.settings.image.alt | default: block.settings.alt_text | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- endcapture -%}

            {%- if block.settings.link != blank -%}
              <a class="masonry-gallery__link" href="{{ block.settings.link }}">
                {{ image_markup }}
              </a>
            {%- else -%}
              {{ image_markup }}
            {%- endif -%}
          {%- elsif section.settings.show_placeholders -%}
            <div class="masonry-gallery__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Masonry gallery",
  "tag": "section",
  "class": "section--masonry-gallery",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop spacing above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop spacing below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Desktop side spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile spacing above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile spacing below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Mobile side spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FDFCF2"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "hover_zoom",
      "label": "Hover zoom",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "Placeholder background",
      "default": "#F4F4F4"
    },
    {
      "type": "checkbox",
      "id": "show_placeholders",
      "label": "Show placeholders for empty blocks",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alternative text",
          "info": "Used when the selected image does not already have alternative text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Masonry gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
