{% comment %}
  Custom hero banner section
  Save this file as: sections/custom-hero-banner.liquid
{% endcomment %}

{% liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign desktop_image = section.settings.image | default: section.settings.mobile_image
  assign mobile_display_image = section.settings.mobile_image | default: section.settings.image

  case section.settings.text_alignment
    when 'left'
      assign flex_alignment = 'flex-start'
    when 'right'
      assign flex_alignment = 'flex-end'
    else
      assign flex_alignment = 'center'
  endcase
%}

{% style %}
  .custom-hero-banner-{{ section_id }} {
    width: 100%;
  }

  .custom-hero-banner__container-{{ section_id }} {
    position: relative;
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ section.settings.min_height }}px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    background: #f4f4f4;
  }

  {% if section.settings.adapt_to_image and desktop_image != blank %}
    .custom-hero-banner__container-{{ section_id }} {
      min-height: 0;
      aspect-ratio: {{ desktop_image.aspect_ratio }};
    }
  {% endif %}

  .custom-hero-banner__image-{{ section_id }},
  .custom-hero-banner__placeholder-{{ section_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .custom-hero-banner__image-{{ section_id }} {
    z-index: 1;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .custom-hero-banner__placeholder-{{ section_id }} {
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-hero-banner__placeholder-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-hero-banner__overlay-{{ section_id }} {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .custom-hero-banner__content-{{ section_id }} {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: {{ flex_alignment }};
    justify-content: flex-end;
    gap: 16px;
    box-sizing: border-box;
    width: 100%;
    padding: 40px 24px {{ section.settings.bottom_spacing }}px;
    color: {{ section.settings.text_color }};
    text-align: {{ section.settings.text_alignment }};
  }

  .custom-hero-banner__text-{{ section_id }} {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
  }

  .custom-hero-banner__heading-{{ section_id }} {
    margin: 0;
    color: inherit;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 500;
    line-height: 1.15;
    {% if section.settings.text_shadow %}
      text-shadow: 0 2px 5px rgba(0, 0, 0, 0.35);
    {% endif %}
  }

  .custom-hero-banner__subheading-{{ section_id }} {
    margin: 10px 0 0;
    color: inherit;
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.5;
    {% if section.settings.text_shadow %}
      text-shadow: 0 2px 5px rgba(0, 0, 0, 0.35);
    {% endif %}
  }

  .custom-hero-banner__button-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border: 2px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .custom-hero-banner__button-{{ section_id }}:hover,
  .custom-hero-banner__button-{{ section_id }}:focus-visible {
    border-color: {{ section.settings.button_hover_border_color }};
    background: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
  }

  .custom-hero-banner__button-{{ section_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .custom-hero-banner__container-{{ section_id }} {
      width: 100%;
      min-height: {{ section.settings.min_height_mobile }}px;
    }

    {% if section.settings.adapt_mobile_to_image and mobile_display_image != blank %}
      .custom-hero-banner__container-{{ section_id }} {
        min-height: 0;
        aspect-ratio: {{ mobile_display_image.aspect_ratio }};
      }
    {% else %}
      .custom-hero-banner__container-{{ section_id }} {
        aspect-ratio: auto;
      }
    {% endif %}

    .custom-hero-banner__content-{{ section_id }} {
      padding: 30px 16px {{ section.settings.bottom_spacing_mobile }}px;
    }

    .custom-hero-banner__heading-{{ section_id }} {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .custom-hero-banner__subheading-{{ section_id }} {
      font-size: {{ section.settings.subheading_size_mobile }}px;
    }
  }
{% endstyle %}

<section
  class="custom-hero-banner-{{ section_id }}"
  aria-label="{{ section.settings.heading | strip_html | escape | default: 'Hero banner' }}"
>
  <div class="custom-hero-banner__container-{{ section_id }}">
    {% if desktop_image != blank %}
      {% liquid
        assign image_loading = 'lazy'
        assign image_fetchpriority = 'auto'
        assign image_class = 'custom-hero-banner__image-' | append: section_id
        if section.index == 1
          assign image_loading = 'eager'
          assign image_fetchpriority = 'high'
        endif
      %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 375 }} 375w,
              {{ section.settings.mobile_image | image_url: width: 550 }} 550w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {% endif %}
        {{ desktop_image
          | image_url: width: 2400
          | image_tag:
            widths: '375, 550, 750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: image_loading,
            fetchpriority: image_fetchpriority,
            class: image_class
        }}
      </picture>
    {% else %}
      <div class="custom-hero-banner__placeholder-{{ section_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if section.settings.show_overlay %}
      <div class="custom-hero-banner__overlay-{{ section_id }}"></div>
    {% endif %}

    <div class="custom-hero-banner__content-{{ section_id }}">
      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="custom-hero-banner__text-{{ section_id }}">
          {% if section.settings.heading != blank %}
            <h2 class="custom-hero-banner__heading-{{ section_id }}">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <div class="custom-hero-banner__subheading-{{ section_id }}">
              {{ section.settings.subheading }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          class="custom-hero-banner__button-{{ section_id }}"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_text | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom hero banner",
  "tag": "section",
  "class": "section-custom-hero-banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "checkbox",
      "id": "adapt_to_image",
      "label": "Adapt desktop height to image",
      "info": "Uses the image's natural proportions on desktop. Mobile continues to use the mobile height setting.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. The desktop image is used on mobile when this is left blank."
    },
    {
      "type": "checkbox",
      "id": "adapt_mobile_to_image",
      "label": "Adapt mobile height to image",
      "info": "Uses the mobile image's natural proportions. If no mobile image is selected, it uses the desktop image's proportions.",
      "default": false
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Desktop height",
      "min": 200,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Mobile height",
      "min": 200,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh flowers for every moment"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text",
      "default": "<p>Thoughtfully arranged and ready to brighten someone's day.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "text_shadow",
      "label": "Add text shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Text maximum width",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 20,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "label": "Mobile bottom spacing",
      "min": 16,
      "max": 400,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Mobile text size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "#aacc97"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#264a3d"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#264a3d"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background",
      "default": "#264a3d"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#aacc97"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#aacc97"
    }
  ],
  "presets": [
    {
      "name": "Custom hero banner"
    }
  ]
}
{% endschema %}
