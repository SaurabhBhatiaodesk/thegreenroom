{"type":"footer","name":"Footer Group","sections":{"footer":{"type":"footer","blocks":{"5c04475e-1234-4943-8302-9422b267bd44":{"type":"about","settings":{"about-title":"About the store","text":"<p>The Green Room Flower Company is boutique florist based in Wanaka. We work creatively with fresh seasonal blooms every day to bring you wonderfully unique flower arrangements that are sure to impress.<\/p><p>We also specialise in weddings and events and can cater for all occasions in the Central Lakes district. Head to our <a href=\"https:\/\/thegreenroomflowerco.co.nz\/pages\/2021-weddings\" title=\"2021 Weddings\"><strong>wedding<\/strong><\/a> page for more info.<\/p><p>Visit us at our Botanical Studio: 99 Sir Tim Wallis Drive, Wanaka 9305<\/p>"}},"b3eedbc2-1997-4ba9-9342-12bfddb1d2a7":{"type":"menu","settings":{"menu-title":"Helpful Links","menu":"2021-footer","show-policy-links":false,"collapsible-row-enabled":true}},"menu_YJzRWm":{"type":"menu","settings":{"menu-title":"Quick links","menu":"footer","show-policy-links":false,"collapsible-row-enabled":true}},"menu_FHrjH6":{"type":"menu","settings":{"menu-title":"Our Policies","menu":"","show-policy-links":true,"collapsible-row-enabled":true}}},"block_order":["5c04475e-1234-4943-8302-9422b267bd44","b3eedbc2-1997-4ba9-9342-12bfddb1d2a7","menu_YJzRWm","menu_FHrjH6"],"settings":{"border":"none","spacing-above":"large","spacing-below":"large","background-color":"dark","logo-enabled":false,"logo":"shopify:\/\/shop_images\/DSC_4529_4afd7527-c99d-40e4-a98d-d19abee474d1.jpg","logo-width":300,"enable-follow-on-shop":false,"heading-type":"block-heading","nav-font-size":13,"text-color":"body","mobile-spacing-above":"medium","mobile-spacing-below":"medium","mobile-text-alignment":"left"}},"footer-bar":{"type":"footer-bar","blocks":{"localization":{"type":"localization","settings":{"show-region-selector":true,"show-locale-selector":true}},"powered-by":{"type":"powered-by","settings":{}},"payment-icons":{"type":"payment-icons","setti