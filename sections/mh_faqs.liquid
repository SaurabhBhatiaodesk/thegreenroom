<style>
  #shopify-section-{{ section.id }} .answear_d7,
  #shopify-section-{{ section.id }} .answear_d7 *,
  #shopify-section-{{ section.id }} .answear_d7 p,
  #shopify-section-{{ section.id }} .answear_d7 a,
  #shopify-section-{{ section.id }} .answear_d7 li {
    color: {{ section.settings.answear_color }} !important;
  }

  #shopify-section-{{ section.id }} .mh_faqs_d7 {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .max_width_dd {
    width: 75%;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .header_d7 {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 60px;
  }

  #shopify-section-{{ section.id }} .title_d7 {
    margin: 0;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    line-height: 1.16;
    font-size: clamp(40px, 3.4vw, 52px);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: {{ section.settings.title_color }};
  }

  #shopify-section-{{ section.id }} .title_d7 * {
    font-family: inherit !important;
    font-weight: inherit !important;
  }

  #shopify-section-{{ section.id }} .top_image_d5 {
    width: 130px;
    height: auto;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .faqs_wrapper_d7 {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .question_answear_d7 {
    border-radius: 0;
    border-top: 1px solid {{ section.settings.question_color }};
  }

  #shopify-section-{{ section.id }} .question_answear_d7:last-child {
    border-bottom: 1px solid {{ section.settings.question_color }};
  }

  #shopify-section-{{ section.id }} .question_d7 {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 0;
    border-radius: 0;
    border: none;
    cursor: pointer;
    appearance: none;
  }

  #shopify-section-{{ section.id }} .question_answear_color_{{ section.id }}:nth-child(odd) .question_d7 {
    background-color: transparent;
  }

  #shopify-section-{{ section.id }} .question_answear_color_{{ section.id }}:nth-child(even) .question_d7 {
    background-color: transparent;
  }

  #shopify-section-{{ section.id }} .question_d7 h3 {
    margin: 0;
    font-family: rig-shaded-bold-face, 'Rig Shaded Bold Face', 'Rig Shaded', 'Arial Black', sans-serif;
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-align: left;
    text-transform: uppercase;
    color: {{ section.settings.question_color }};
  }

  #shopify-section-{{ section.id }} .question_d7 h3 * {
    font-family: inherit !important;
    font-weight: inherit !important;
  }

  #shopify-section-{{ section.id }} .svg_d7 {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    margin-left: 12px;
  }

  #shopify-section-{{ section.id }} .svg_d7 svg {
    width: 24px;
    height: 24px;
    color: {{ section.settings.question_color }};
  }

  #shopify-section-{{ section.id }} .open_d7 {
    display: block !important;
  }

  #shopify-section-{{ section.id }} .cross_d7 {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.active .open_d7 {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.active .cross_d7 {
    display: block !important;
  }

  #shopify-section-{{ section.id }} .answear_outer_d7 {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: transparent !important;
  }

  #shopify-section-{{ section.id }} .answear_d7 {
    padding: 0 0 22px;
    font-family: 'Bookmania', Georgia, 'Times New Roman', serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.48;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .answear_d7 * {
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
  }

  #shopify-section-{{ section.id }} .answear_d7 p,
  #shopify-section-{{ section.id }} .answear_d7 ul,
  #shopify-section-{{ section.id }} .answear_d7 ol {
    margin: 0 0 22px;
  }

  #shopify-section-{{ section.id }} .answear_d7 p:last-child,
  #shopify-section-{{ section.id }} .answear_d7 ul:last-child,
  #shopify-section-{{ section.id }} .answear_d7 ol:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .bottom_image_d5 {
    display: block;
    width: min(100%, 760px);
    margin: 40px auto 0;
  }

  #shopify-section-{{ section.id }} .reveal_d7 {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    will-change: opacity, transform;
  }

  #shopify-section-{{ section.id }} .reveal_d7.revealed_d7 {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .header_d7.reveal_d7 {
    transition-delay: 0.05s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(1) {
    transition-delay: 0.08s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(2) {
    transition-delay: 0.16s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(3) {
    transition-delay: 0.24s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(4) {
    transition-delay: 0.32s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(5) {
    transition-delay: 0.4s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(6) {
    transition-delay: 0.48s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(7) {
    transition-delay: 0.56s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(8) {
    transition-delay: 0.64s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(9) {
    transition-delay: 0.72s;
  }

  #shopify-section-{{ section.id }} .question_answear_d7.reveal_d7:nth-child(10) {
    transition-delay: 0.8s;
  }

  #shopify-section-{{ section.id }} .bottom_image_d5.reveal_d7 {
    transition-delay: 0.2s;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .max_width_dd {
      width: calc(100% - 40px);
    }

    #shopify-section-{{ section.id }} .header_d7 {
      gap: 12px;
      margin-bottom: 40px;
    }

    #shopify-section-{{ section.id }} .top_image_d5 {
      width: 80px;
    }

    #shopify-section-{{ section.id }} .title_d7 {
      font-size: clamp(30px, 7.2vw, 38px);
      line-height: 1.16;
    }

    #shopify-section-{{ section.id }} .question_d7 {
      padding: 18px 0;
    }

    #shopify-section-{{ section.id }} .question_d7 h3 {
      font-size: 17px;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .answear_d7 {
      padding-bottom: 22px;
      font-size: 18px;
      line-height: 1.5;
    }
  }
</style>

{% capture open %}
<svg class="open_d7" viewBox="0 0 24 24" fill="none">
  <path d="M5 12H19M12 5V19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{% endcapture %}

{% capture cross %}
<svg class="cross_d7" viewBox="0 0 24 24" fill="none">
  <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{% endcapture %}

<section class="mh_faqs_d7">
  <div class="max_width_dd">

    <div class="header_d7 reveal_d7">
      {% if section.settings.title != blank %}
        <h2 class="title_d7">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.top_image != blank %}
        <img
          class="top_image_d5"
          src="{{ section.settings.top_image | image_url }}"
          alt=""
          loading="lazy">
      {% endif %}
    </div>

    <div class="faqs_wrapper_d7">
      {% for block in section.blocks %}
        <div class="question_answear_d7 question_answear_color_{{ section.id }} reveal_d7">
          <button class="question_d7" type="button">
            <h3>{{ block.settings.question }}</h3>
            <div class="svg_d7">
              {{ open }}
              {{ cross }}
            </div>
          </button>

          <div class="answear_outer_d7">
            <div class="answear_d7">
              {{ block.settings.answear }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.bottom_image != blank %}
      <img
        class="bottom_image_d5 reveal_d7"
        src="{{ section.settings.bottom_image | image_url }}"
        alt=""
        loading="lazy">
    {% endif %}

  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    var items = section.querySelectorAll('.question_answear_d7');

    items.forEach(function(item) {
      var button = item.querySelector('.question_d7');
      var answer = item.querySelector('.answear_outer_d7');

      button.addEventListener('click', function() {
        var isActive = item.classList.contains('active');

        items.forEach(function(i) {
          i.classList.remove('active');
          i.querySelector('.answear_outer_d7').style.maxHeight = '0px';
        });

        if (!isActive) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });

    var revealItems = section.querySelectorAll('.reveal_d7');

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries, obs) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed_d7');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: '0px 0px -40px 0px'
      });

      revealItems.forEach(function(item) {
        observer.observe(item);
      });
    } else {
      revealItems.forEach(function(item) {
        item.classList.add('revealed_d7');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "TIC Faqs",
  "presets": [{"name": "TIC Faqs"}],
  "settings": [
    {"type": "color","id": "background_color","label": "Background Color","default": "#d65709"},
    {"type": "color","id": "title_color","label": "Title Color","default": "#f7f5e2"},
    {"type": "inline_richtext","id": "title","label": "Title"},
    {"type": "image_picker","id": "top_image","label": "Image"},
    {"type": "header","content": "__Faq Color__"},
    {"type": "color","id": "odd_color","label": "Odd Color","default": "#ffd18c"},
    {"type": "color","id": "even_color","label": "Even Color","default": "#f7f5e2"},
    {"type": "color","id": "question_color","label": "Question Color","default": "#000000"},
    {"type": "color","id": "answear_color","label": "Answear Color","default": "#ffffff"},
    {"type": "header","content": "__Bottom Image__"},
    {"type": "image_picker","id": "bottom_image","label": "Image"},
    {"type": "range","id": "padding_top","min": 0,"max": 100,"step": 2,"unit": "px","label": "Padding Top","default": 40},
    {"type": "range","id": "padding_bottom","min": 0,"max": 100,"step": 2,"unit": "px","label": "Padding Bottom","default": 40}
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "faq",
      "settings": [
        {"type": "inline_richtext","id": "question","label": "Question"},
        {"type": "richtext","id": "answear","label": "Answear"}
      ]
    }
  ]
}
{% endschema %}
