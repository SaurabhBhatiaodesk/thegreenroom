{% doc %}
  @prompt
    I want to upload an image to pop up in the center of the page when the home page loads
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if template.name == 'index' %}
  {% style %}
    .ai-homepage-popup-{{ ai_gen_id }} { display: block; position: fixed; inset: 0; z-index: 9999; visibility: hidden; opacity: 0; pointer-events: none; }
    .ai-homepage-popup-{{ ai_gen_id }}[data-open="true"] { visibility: visible; opacity: 1; pointer-events: auto; }
    .ai-homepage-popup-{{ ai_gen_id }}__backdrop { position: absolute; inset: 0; background: {{ block.settings.overlay_color }}; }
    .ai-homepage-popup-{{ ai_gen_id }}__dialog { position: absolute; top: 50%; left: 50%; width: {{ block.settings.desktop_width_percent }}%; max-width: {{ block.settings.max_width }}px; max-height: calc(100vh - 40px); transform: translate(-50%, -50%); overflow: auto; background: {{ block.settings.background_color }}; border-radius: {{ block.settings.border_radius }}px; box-shadow: 0 16px 50px rgba(0, 0, 0, 0.24); }
    .ai-homepage-popup-{{ ai_gen_id }}__media { display: block; width: 100%; line-height: 0; }
    .ai-homepage-popup-{{ ai_gen_id }}__media img { display: block; width: 100%; height: auto; max-height: calc(100vh - 40px); object-fit: contain; border-radius: {{ block.settings.border_radius }}px; }
    .ai-homepage-popup-{{ ai_gen_id }}__placeholder { display: flex; min-height: 280px; align-items: center; justify-content: center; padding: 32px; color: {{ block.settings.text_color }}; text-align: center; line-height: 1.5; }
    .ai-homepage-popup-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 240px; color: {{ block.settings.text_color }}; }
    .ai-homepage-popup-{{ ai_gen_id }}__close { position: absolute; top: 12px; right: 12px; z-index: 1; display: flex; width: 38px; height: 38px; align-items: center; justify-content: center; padding: 0; border: 1px solid {{ block.settings.close_color }}; border-radius: 50%; background: {{ block.settings.close_background }}; color: {{ block.settings.close_color }}; cursor: pointer; }
    .ai-homepage-popup-{{ ai_gen_id }}__close:hover, .ai-homepage-popup-{{ ai_gen_id }}__close:focus-visible { background: {{ block.settings.close_color }}; color: {{ block.settings.close_background }}; }
    .ai-homepage-popup-{{ ai_gen_id }}__close svg { width: 18px; height: 18px; }
    @media screen and (max-width: 749px) { .ai-homepage-popup-{{ ai_gen_id }}__dialog { width: calc(100% - 32px); max-height: calc(100vh - 32px); } .ai-homepage-popup-{{ ai_gen_id }}__media img { max-height: calc(100vh - 32px); } }
  {% endstyle %}

  <homepage-image-popup-{{ ai_gen_id }} class="ai-homepage-popup-{{ ai_gen_id }}" data-open="false" data-show-once="{{ block.settings.show_once }}" {{ block.shopify_attributes }}>
    <div class="ai-homepage-popup-{{ ai_gen_id }}__backdrop" data-close-popup></div>
    <div class="ai-homepage-popup-{{ ai_gen_id }}__dialog" role="dialog" aria-modal="true" aria-label="{{ block.settings.accessibility_label | escape }}">
      <button type="button" class="ai-homepage-popup-{{ ai_gen_id }}__close" aria-label="{{ block.settings.close_label | escape }}" data-close-popup>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
      {% if block.settings.image != blank %}
        {% if block.settings.image_link != blank %}<a class="ai-homepage-popup-{{ ai_gen_id }}__media" href="{{ block.settings.image_link }}">{% endif %}
          {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', alt: block.settings.image.alt }}
        {% if block.settings.image_link != blank %}</a>{% endif %}
      {% else %}
        <div class="ai-homepage-popup-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span>Add a promotional image in the block settings.</span></div>
      {% endif %}
    </div>
  </homepage-image-popup-{{ ai_gen_id }}>

  <script>
    (function() {
      class HomepageImagePopup{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() {
          this.querySelectorAll('[data-close-popup]').forEach((button) => button.addEventListener('click', () => this.close()));
          this.addEventListener('keydown', (event) => { if (event.key === 'Escape') this.close(); });
          if (this.dataset.showOnce === 'true' && sessionStorage.getItem('homepage-popup-{{ ai_gen_id }}')) return;
          requestAnimationFrame(() => { this.dataset.open = 'true'; document.documentElement.style.overflow = 'hidden'; if (this.dataset.showOnce === 'true') sessionStorage.setItem('homepage-popup-{{ ai_gen_id }}', 'shown'); });
        }
        close() { this.dataset.open = 'false'; document.documentElement.style.overflow = ''; }
      }
      if (!customElements.get('homepage-image-popup-{{ ai_gen_id }}')) customElements.define('homepage-image-popup-{{ ai_gen_id }}', HomepageImagePopup{{ ai_gen_id }});
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Homepage image popup",
  "settings": [
    { "type": "header", "content": "Popup image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "image_link", "label": "Image link" },
    { "type": "checkbox", "id": "show_once", "label": "Show once per session", "default": false },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 80 },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 300, "max": 1200, "step": 50, "unit": "px", "default": 700 },
    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "accessibility_label", "label": "Popup label", "default": "Featured announcement" },
    { "type": "text", "id": "close_label", "label": "Close label", "default": "Close popup" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#264a3d" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fffff3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#264a3d" },
    { "type": "color", "id": "close_background", "label": "Close background", "default": "#fffff3" },
    { "type": "color", "id": "close_color", "label": "Close icon", "default": "#264a3d" },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 }
  ],
  "presets": [{ "name": "Homepage image popup" }],
  "tag": null,
  "class": "homepage-image-popup-block"
}
{% endschema %}