{% doc %}
  @prompt
    Create a masonry grid gallery section displaying 50 images. The grid should have a Pinterest-style masonry layout where images fill in columns of varying heights. Include settings to allow the merchant to upload and manage all 50 images. The grid should be responsive, looking great on both desktop and mobile devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-masonry-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.spacing }}px;
  }

  .ai-masonry-grid-{{ ai_gen_id }} {
    column-count: {{ block.settings.columns_desktop }};
    column-gap: {{ block.settings.gap }}px;
  }

  .ai-masonry-item-{{ ai_gen_id }} {
    break-inside: avoid;
    margin-bottom: {{ block.settings.gap }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background-color: {{ block.settings.placeholder_bg }};
  }

  .ai-masonry-item-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-masonry-item-{{ ai_gen_id }}:hover img {
    transform: scale({{ block.settings.hover_zoom }});
  }

  .ai-masonry-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.placeholder_bg }};
    border-radius: {{ block.settings.image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .ai-masonry-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: auto;
    opacity: 0.3;
  }

  @media screen and (max-width: 1024px) {
    .ai-masonry-grid-{{ ai_gen_id }} {
      column-count: {{ block.settings.columns_tablet }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-masonry-grid-{{ ai_gen_id }} {
      column-count: {{ block.settings.columns_mobile }};
    }

    .ai-masonry-gallery-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<masonry-gallery-{{ ai_gen_id }} class="ai-masonry-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-masonry-grid-{{ ai_gen_id }}">
    {% for i in (1..50) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign image = block.settings[image_key] %}
      
      {% if image != blank %}
        <div class="ai-masonry-item-{{ ai_gen_id }}">
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        </div>
      {% elsif block.settings.show_placeholders %}
        <div class="ai-masonry-item-{{ ai_gen_id }}">
          <div class="ai-masonry-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</masonry-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class MasonryGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initMasonry();
        window.addEventListener('resize', this.handleResize.bind(this));
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize.bind(this));
      }

      initMasonry() {
        const grid = this.querySelector('.ai-masonry-grid-{{ ai_gen_id }}');
        if (!grid) return;

        const images = grid.querySelectorAll('img');
        let loadedCount = 0;

        images.forEach((img) => {
          if (img.complete) {
            loadedCount++;
          } else {
            img.addEventListener('load', () => {
              loadedCount++;
              if (loadedCount === images.length) {
                this.adjustLayout();
              }
            });
          }
        });

        if (loadedCount === images.length) {
          this.adjustLayout();
        }
      }

      adjustLayout() {
        const grid = this.querySelector('.ai-masonry-grid-{{ ai_gen_id }}');
        if (grid) {
          grid.style.opacity = '1';
        }
      }

      handleResize() {
        this.adjustLayout();
      }
    }

    customElements.define('masonry-gallery-{{ ai_gen_id }}', MasonryGallery{{ ai_gen_id }});
  })();
</script>

