{% doc %}
  @prompt
    create an image with text section but make it so that there is a slideshow of imagery as opposed to stagnent image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-text-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-slideshow-text-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {% if block.settings.layout == 'image-left' %}1fr 1fr{% else %}1fr 1fr{% endif %};
    gap: {{ block.settings.gap }}px;
    align-items: center;
    min-height: {{ block.settings.min_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-text-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-slideshow-text-image-wrapper-{{ ai_gen_id }} {
      order: {% if block.settings.mobile_image_position == 'top' %}-1{% else %}1{% endif %};
    }
  }

  .ai-slideshow-text-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    order: {% if block.settings.layout == 'image-left' %}0{% else %}1{% endif %};
  }

  .ai-slideshow-text-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
  }

  .ai-slideshow-text-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-text-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slideshow-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-slideshow-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-slideshow-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-slideshow-text-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_bg_color }};
    border-radius: {{ block.settings.content_border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-slideshow-text-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-slideshow-text-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
  }

  .ai-slideshow-text-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-slideshow-text-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-slideshow-text-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 2;
  }

  .ai-slideshow-text-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-text-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-text-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-text-arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-slideshow-text-arrow-{{ ai_gen_id }}--prev {
    left: 15px;
  }

  .ai-slideshow-text-arrow-{{ ai_gen_id }}--next {
    right: 15px;
  }

  .ai-slideshow-text-arrow-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }
{% endstyle %}

<slideshow-with-text-{{ ai_gen_id }}
  class="ai-slideshow-text-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-slideshow-text-container-{{ ai_gen_id }}">
    <div class="ai-slideshow-text-image-wrapper-{{ ai_gen_id }}">
      {% assign has_images = false %}
      {% for i in (1..5) %}
        {% assign image_key = 'image_' | append: i %}
        {% if block.settings[image_key] != blank %}
          {% assign has_images = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if has_images %}
        {% for i in (1..5) %}
          {% assign image_key = 'image_' | append: i %}
          {% if block.settings[image_key] != blank %}
            <div class="ai-slideshow-text-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
              <img
                src="{{ block.settings[image_key] | image_url: width: 1500 }}"
                alt="{{ block.settings[image_key].alt | escape }}"
                loading="lazy"
                width="{{ block.settings[image_key].width }}"
                height="{{ block.settings[image_key].height }}"
              >
            </div>
          {% endif %}
        {% endfor %}

        {% if block.settings.show_arrows %}
          <button class="ai-slideshow-text-arrow-{{ ai_gen_id }} ai-slideshow-text-arrow-{{ ai_gen_id }}--prev" aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="ai-slideshow-text-arrow-{{ ai_gen_id }} ai-slideshow-text-arrow-{{ ai_gen_id }}--next" aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {% endif %}

        {% if block.settings.show_dots %}
          <div class="ai-slideshow-text-controls-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              {% assign image_key = 'image_' | append: i %}
              {% if block.settings[image_key] != blank %}
                <button class="ai-slideshow-text-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}" aria-label="Go to slide {{ forloop.index }}"></button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="ai-slideshow-text-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-slideshow-text-empty-state-{{ ai_gen_id }}">
            Next, add images to the slideshow
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-slideshow-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-slideshow-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-slideshow-text-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-slideshow-text-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</slideshow-with-text-{{ ai_gen_id }}>

<script>
  (function() {
    class SlideshowWithText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-text-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-text-dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-text-arrow-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-slideshow-text-arrow-{{ ai_gen_id }}--next');
        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.setupEventListeners();
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
          });
        });
      }

      goToSlide(slideNumber) {
        this.slides.forEach((slide) => {
          slide.classList.remove('active');
        });

        this.dots.forEach((dot) => {
          dot.classList.remove('active');
        });

        const targetSlide = this.querySelector(`[data-slide="${slideNumber}"].ai-slideshow-text-slide-{{ ai_gen_id }}`);
        const targetDot = this.querySelector(`[data-slide="${slideNumber}"].ai-slideshow-text-dot-{{ ai_gen_id }}`);

        if (targetSlide) {
          targetSlide.classList.add('active');
        }

        if (targetDot) {
          targetDot.classList.add('active');
        }

        this.currentSlide = slideNumber;
        this.resetAutoplay();
      }

      nextSlide() {
        const nextSlideNumber = this.currentSlide >= this.totalSlides ? 1 : this.currentSlide + 1;
        this.goToSlide(nextSlideNumber);
      }

      previousSlide() {
        const prevSlideNumber = this.currentSlide <= 1 ? this.totalSlides : this.currentSlide - 1;
        this.goToSlide(prevSlideNumber);
      }

      startAutoplay() {
        const autoplay = this.dataset.autoplay === 'true';
        const autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        if (autoplay && this.totalSlides > 1) {
          this.autoplayInterval = setInterval(() => {
            this.nextSlide();
          }, autoplaySpeed);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.stopAutoplay();
        this.startAutoplay();
      }
    }

    customElements.define('slideshow-with-text-{{ ai_gen_id }}', SlideshowWithText{{ ai_gen_id }});
  })();
</script>

