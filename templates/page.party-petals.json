ngs":{"question":"How far in advance should I order?","answer":"We ask for a minimum of two weeks lead time, though the sooner the better. Placing your order early means we can secure your date in the calendar and make sure we have the right blooms lined up for your day."}},"faq_DyA9Ub":{"type":"faq","settings":{"question":"When do I collect my florals?","answer":"You collect from our studio. We will have them ready for collection at 10am of your wedding day. Everything will be ready and waiting, beautifully wrapped with setup guidance included."}},"faq_XxTGHG":{"type":"faq","settings":{"question":"Can I choose my colour palette?","answer":"Yes, each design in the Party Petals Collection is available in a range of colour palettes. You choose the direction and we take it from there."}},"faq_rhbcgw":{"type":"faq","settings":{"question":"Can I request specific flowers?","answer":"We design around what is most beautiful and available in season, which is what makes each arrangement feel fresh and alive rather than forced. If there is something you feel strongly about, let us know and we will always do our best to work it in, no guarantees."}},"faq_azT3TH":{"type":"faq","settings":{"question":"What if I want something more customised?","answer":"Party Petals is designed to keep things simple. If you'd like more input, specific requests or a fully tailored design, our wedding proposal service gives you direct access to our florist team to work through every detail together. This service starts from $3,000."}},"faq_4F4G9J":{"type":"faq","settings":{"question":"Do I need to spend a minimum amount?","answer":"Party Petals is our online collection for florals under $3,000, making it the most accessible way to work with us. For a floral investment over this reach out and we can discuss how we can serve you best."}},"faq_FV4yWG":{"type":"faq","settings":{"question":"Can we have a chat before I order?","answer":"Of course. If you'd like to talk through your florals before placing an order, you're welcome to get in touch and we can organise a time. There is no obligation and it is always a lovely way to make sure everything feels right before you commit."}}},"block_order":["faq_d8znWz","faq_DyA9Ub","faq_XxTGHG","faq_rhbcgw","faq_azT3TH","faq_4F4G9J","faq_FV4yWG"],"name":"Curated Collection — FAQ","settings":{"background_color":"#edeae0","heading_color":"#264a3d","subheading_color":"#264a3d","question_color":"#264a3d","answer_color":"#264a3d","divider_color":"#bac9c4","accent_color":"#D37F91","heading":"FAQ","subheading":"The things brides ask us most","question_font_size":16,"question_font_size_mobile":14,"answer_font_size":15,"answer_font_size_mobile":14,"padding_horizontal":50,"padding_horizontal_mobile":15,"padding_bottom":110,"padding_bottom_mobile":70,"answer_padding_right":90,"answer_padding_right_mobile":20,"single_open_faq":true}}},"order":["main","party_petals_hero_7ArK64","party_petals_intro_bYnep8","party_petals_how_it_works_tYr4cH","party_petals_collection_yKitdx","party_petals_gallery_hQJVRW","party_petals_faq_G8AVGA"]}